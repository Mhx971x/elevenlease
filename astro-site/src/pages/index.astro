    display:flex;flex-direction:column;justify-content:center;
  }
  .process-cta-card::after{
    content:'';position:absolute;z-index:0;right:-5%;bottom:-56%;width:64%;aspect-ratio:1;border-radius:50%;
    background:radial-gradient(circle,rgba(255,0,127,.24) 0%,rgba(255,0,127,.07) 42%,transparent 70%);
    filter:blur(8px);pointer-events:none;
  }
  .process-cta-grid{
    position:absolute;inset:0;z-index:0;
    background-image:linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size:40px 40px;
    mask-image:radial-gradient(ellipse 80% 60% at 30% 20%, black, transparent);
    -webkit-mask-image:radial-gradient(ellipse 80% 60% at 30% 20%, black, transparent);
  }
  .process-cta-glow{position:absolute;border-radius:50%;filter:blur(64px);pointer-events:none;z-index:0;}
  .process-cta-glow-1{width:300px;height:300px;background:radial-gradient(circle, rgba(255,0,127,.4), transparent 70%);top:-90px;right:-70px;}
  .process-cta-glow-2{width:260px;height:260px;background:radial-gradient(circle, rgba(255,0,127,.22), transparent 70%);bottom:-40px;left:-60px;}
  .process-cta-content{position:relative;z-index:2;max-width:470px;}
  .process-cta-eyebrow{font-size:12px;color:var(--accent-1);text-transform:uppercase;letter-spacing:0.1em;font-weight:700;margin-bottom:14px;}
  .process-cta-card h3{font-size:clamp(28px,3.2vw,40px);line-height:1.12;color:#fff;font-weight:600;}
  .process-cta-accent{color:var(--accent-1);}
  .process-cta-card > .process-cta-content > p{color:rgba(255,255,255,.64);font-size:15px;line-height:1.65;margin-top:16px;max-width:430px;}
  .process-cta-btn{margin-top:24px;padding:15px 26px;font-size:14.5px;}
  .process-cta-proof{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:26px;}
  .process-cta-proof span{
    display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid rgba(255,255,255,.11);border-radius:999px;
    background:rgba(255,255,255,.055);color:rgba(255,255,255,.72);font-size:11.5px;line-height:1;
  }
  .process-cta-proof span::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent-1);box-shadow:0 0 0 3px rgba(255,0,127,.12);}
  .process-car-carousel{
    position:absolute;z-index:1;inset:0 0 0 auto;width:60%;overflow:hidden;pointer-events:none;
  }
  .process-car{
    --ground-y:-50%;position:absolute;top:55%;left:50%;width:min(646px,92%);height:auto;max-width:none;
    opacity:0;transform:translate3d(-145%,var(--ground-y),0);filter:none;
    transition:transform .9s cubic-bezier(.55,.05,.2,1),opacity .42s ease,filter .62s ease;
    will-change:transform,opacity;
  }
  .process-car:nth-child(1){--ground-y:-50%;}
  .process-car:nth-child(2){--ground-y:-54.79%;}
  .process-car:nth-child(3){--ground-y:-53.32%;}
  .process-car:nth-child(4){--ground-y:-51.07%;}
  .process-car.is-active{opacity:1;transform:translate3d(-50%,var(--ground-y),0);filter:drop-shadow(0 20px 30px rgba(0,0,0,.5));}
  .process-car.is-leaving{opacity:0;transform:translate3d(145%,var(--ground-y),0);filter:none;}
  @media(max-width:1080px){
    .process-car-carousel{width:62%;}
  }
  @media(max-width:760px){
    .process-cta-card{justify-content:flex-start;min-height:600px;}
    .process-cta-content{max-width:none;}
    .process-car-carousel{inset:auto 0 0;width:100%;height:285px;}
    .process-car{top:53%;width:min(595px,88%);}
  }
  @media(max-width:640px){
    .process-cta-card{padding:32px 24px;border-radius:22px;min-height:560px;}
    .process-cta-card h3{font-size:30px;}
    .process-cta-card > .process-cta-content > p{font-size:14px;line-height:1.55;}
    .process-cta-btn{width:100%;justify-content:center;}
    .process-cta-proof{gap:7px;}
    .process-cta-proof span{font-size:10.5px;padding:7px 9px;}
    .process-car-carousel{height:245px;}
    .process-car{top:52%;width:88%;}
  }

  /* categories */
  #acceptation{padding:64px 0;}
  .accept-head{text-align:center;max-width:640px;margin:0 auto;margin-bottom:28px;}
  .accept-head h2{font-size:clamp(32px,4.6vw,48px);}
  @media(min-width:761px){
    .accept-head h2{white-space:nowrap;}
  }
  .accept-intro{margin:10px auto 0;max-width:480px;color:var(--text-dim);font-size:14.5px;line-height:1.55;}

  /* accept diagram */
  @keyframes acceptFlowDash{to{stroke-dashoffset:-22;}}
  .accept-icon{
    display:flex;align-items:center;justify-content:center;flex:none;
    width:38px;height:38px;
    border-radius:50%;color:#17171b;
    background:linear-gradient(145deg,#fff0f7,#fbe2ed);
    box-shadow:inset 0 0 0 1px rgba(255,0,127,.08), 0 2px 8px rgba(255,0,127,.06);
  }
  .accept-icon :global(svg){width:18px;height:18px;}
  .accept-diagram{position:relative;display:flex;flex-direction:column;align-items:center;gap:32px;margin:24px 0 16px;}
  .accept-file-card{
    position:relative;z-index:2;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
    width:200px;
    background:#fff;border:1px solid var(--border);border-radius:16px;
    padding:14px 18px;box-shadow:0 22px 46px -26px rgba(17,24,39,.24);text-align:center;
    transition:transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s ease;
  }
  .accept-file-card:hover{transform:translateY(-4px);}
  .accept-file-card .accept-icon{border-radius:12px;color:var(--accent-1);}
  .accept-file-label{font-weight:700;font-size:14.5px;letter-spacing:-.01em;}
  .accept-partners{position:relative;z-index:2;width:100%;}
  .accept-partners-desktop{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  .accept-partners-mobile{display:none;}
  .accept-partner{
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
    background:#fff;border:1px solid var(--border);border-radius:16px;
    padding:14px 14px;box-shadow:0 18px 40px -28px rgba(17,24,39,.2);text-align:center;
    transition:transform .35s cubic-bezier(.2,.7,.2,1), border-color .3s ease, box-shadow .3s ease;
  }
  .accept-partner:hover{transform:translateY(-6px);}
  .accept-partner-name{font-weight:700;font-size:15px;letter-spacing:-.01em;color:#4b515c;}
  .accept-status{display:inline-flex;align-items:center;gap:6px;padding:5px 13px;border-radius:100px;font-size:12px;font-weight:600;}
  .accept-status :global(svg){width:10px;height:10px;}
  .accept-status-refused{background:#fdecef;color:#e5484d;}
  .accept-status-accepted{background:#16a34a;color:#fff;box-shadow:0 6px 16px -6px rgba(22,163,74,.6);}
  .accept-partner .accept-icon{background:linear-gradient(145deg,#fff0f7,#fbe2ed);color:#c11060;box-shadow:inset 0 0 0 1px rgba(255,0,127,.08);}
  .accept-partner-accepted{
    border-color:#bfe8ca;background:linear-gradient(160deg,#f4fdf6,#e9faef);
    box-shadow:0 24px 50px -26px rgba(22,163,74,.4);
  }
  .accept-partner-accepted .accept-partner-name{color:#166534;}
  .accept-partner-accepted .accept-icon{background:linear-gradient(145deg,#dcfce7,#c5f4d3);color:#16a34a;box-shadow:inset 0 0 0 1px rgba(22,163,74,.08);}
  .accept-lines{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;overflow:visible;}
  .accept-lines-narrow{display:none;}
  .accept-lines-mobile{display:none;}
  .accept-bus-line{fill:none;stroke:var(--accent-1);stroke-width:2;stroke-linecap:round;opacity:.4;}
  .accept-bus-line-accepted{stroke:#16a34a;opacity:.7;}
  .accept-line{fill:none;stroke:var(--accent-1);stroke-width:2;stroke-linecap:round;opacity:.4;}
  .accept-line-accepted{fill:none;stroke:#16a34a;stroke-width:2.25;stroke-linecap:round;opacity:.75;}
  .accept-line-flow{fill:none;stroke:#fff;stroke-width:2.25;stroke-linecap:round;stroke-dasharray:1.5 11;animation:acceptFlowDash .9s linear infinite;}
  .accept-dot{fill:var(--accent-1);stroke:#fff;stroke-width:2;}
  .accept-dot-start{fill:var(--accent-1);}
  .accept-dot-accepted{fill:#16a34a;}
  .accept-note{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:20px;color:var(--text-dim);font-size:14px;font-weight:500;}
  .accept-note-icon{display:flex;color:var(--accent-1);}
  .accept-note-icon :global(svg){width:16px;height:16px;}
  .accept-stats{
    display:grid;grid-template-columns:repeat(2,1fr);align-items:center;
    background:#fff;border:1px solid var(--border);border-radius:16px;
    padding:12px 8px;box-shadow:var(--shadow-sm);
  }
  .accept-stat{
    position:relative;
    display:flex;align-items:center;justify-content:center;gap:10px;
    padding:4px 16px;
    font-size:13px;font-weight:600;color:var(--text);line-height:1.3;
  }
  .accept-stat:not(:first-child)::before{
    content:'';position:absolute;left:0;top:22%;bottom:22%;width:1px;background:var(--border);
  }
  .accept-stat .accept-icon{width:32px;height:32px;color:var(--accent-1);flex:none;}
  .accept-stat .accept-icon :global(svg){width:15px;height:15px;}
  @media(max-width:900px){
    .accept-partners-desktop{grid-template-columns:1fr 1fr;}
    .accept-lines-wide{display:none;}
    .accept-lines-narrow{display:block;}
  }
  @media(max-width:760px){
    #acceptation{padding:48px 0;}
    .accept-diagram{gap:20px;}
    .accept-file-card{width:calc((100% - 16px) / 3);padding:10px 6px;gap:6px;border-radius:14px;}
    .accept-file-card .accept-icon{width:28px;height:28px;}
    .accept-file-card .accept-icon :global(svg){width:14px;height:14px;}
    .accept-file-label{font-size:11px;}
    .accept-partners-desktop{display:none;}
    .accept-partners-mobile{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
    .accept-lines-narrow{display:none;}
    .accept-lines-mobile{display:block;}
    .accept-partner-compact{padding:10px 6px;gap:6px;border-radius:14px;}
    .accept-partner-compact .accept-icon{width:28px;height:28px;}
    .accept-partner-compact .accept-icon :global(svg){width:14px;height:14px;}
    .accept-partner-compact .accept-partner-name{font-size:11px;}
    .accept-partner-compact .accept-status{padding:3px 8px;font-size:9.5px;gap:3px;}
    .accept-partner-compact .accept-status :global(svg){width:8px;height:8px;}
    .accept-stats{gap:4px;padding:12px 4px;}
    .accept-stat{
      flex-direction:column;justify-content:flex-start;text-align:center;
      gap:6px;padding:2px 6px;font-size:10.5px;
    }
    .accept-stat:not(:first-child)::before{top:4px;bottom:4px;}
    .accept-stat .accept-icon{width:28px;height:28px;}
    .accept-stat .accept-icon :global(svg){width:13px;height:13px;}
  }
  @media(prefers-reduced-motion:reduce){
    .accept-line-flow{animation:none;stroke-dasharray:none;display:none;}
  }
  /* comparison table */
  .compare-head{margin:0 auto 44px;text-align:center;max-width:640px;}
  .compare-head h2{font-size:clamp(32px,4.6vw,48px);}
  .compare-head p{font-size:16.5px;margin:14px auto 0;max-width:520px;}
  .highlight-mark{position:relative;display:inline-block;padding:0 4px;white-space:nowrap;}
  .highlight-mark::before{
    content:'';position:absolute;left:-3px;right:-3px;top:0.08em;bottom:0.05em;
    background:rgba(255,0,127,0.16);border-radius:8px;z-index:-1;
  }
  .compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch;}
  .compare-top{
    display:grid;grid-template-columns:1fr auto;
    grid-template-areas:"text photo" "apport apport";
    column-gap:14px;row-gap:0;align-items:center;margin-bottom:22px;
  }
  .compare-top-text{grid-area:text;min-width:0;}
  .compare-photo{grid-area:photo;display:flex;align-self:center;}
  .compare-them .compare-photo{filter:grayscale(.4) opacity(.85);}
  .compare-photo img{width:150px;height:auto;display:block;}
  .compare-vehicle-name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15.5px;}
  .compare-them .compare-vehicle-name{color:var(--text-dim);}
  .compare-card{border-radius:24px;padding:32px;}
  .compare-us{
    background:#fff;position:relative;overflow:visible;
    border:2px solid var(--accent-1);
    box-shadow:0 20px 44px rgba(255,0,127,0.14), var(--shadow-md);
    display:flex;flex-direction:column;
  }
  .compare-badge{
    position:absolute;top:-15px;left:50%;transform:translateX(-50%);z-index:2;
    background:var(--accent);color:#fff;font-size:11.5px;font-weight:700;
    text-transform:uppercase;letter-spacing:0.05em;padding:6px 16px;border-radius:100px;
    box-shadow:0 6px 16px rgba(255,0,127,0.28);
    white-space:nowrap;
  }
  .compare-them{background:var(--surface);border:1px solid var(--border);display:flex;flex-direction:column;}
  .compare-card-head{
    font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:17px;
    display:flex;align-items:center;gap:9px;margin-bottom:6px;
  }
  .compare-them .compare-card-head{color:var(--text-faint);font-weight:600;}
  .compare-logo-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);flex:none;}
  .compare-apport{
    grid-area:apport;
    display:flex;flex-direction:column;gap:2px;padding-bottom:22px;margin-top:22px;
    border-bottom:1px solid var(--border);
  }
  .compare-us .compare-apport{border-bottom-color:rgba(255,0,127,0.15);}
  .compare-apport-from{font-size:13px;font-weight:600;color:var(--accent-1);}
  .compare-them .compare-apport-from{visibility:hidden;}
  .compare-apport-amount{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:34px;}
  .compare-them .compare-apport-amount{color:var(--text-dim);}
  .compare-us .compare-apport-amount{color:var(--accent-1);}
  .compare-apport-label{font-size:13px;color:var(--text-faint);}
  .compare-list{list-style:none;display:flex;flex-direction:column;gap:13px;}
  .compare-list li{display:flex;align-items:center;gap:11px;font-size:14px;}
  .compare-list li svg{flex:none;}
  .compare-us .compare-list li{color:var(--text);}
  .compare-them .compare-list li{color:var(--text-faint);}
  .compare-list-strong{
    font-weight:700;color:var(--text);
    background:rgba(255,0,127,0.08);
    margin:0 -10px;padding:6px 10px;border-radius:10px;
  }
  .compare-them .compare-list-strong{background:rgba(90,90,98,0.09);}
  .compare-cta{margin-top:26px;width:100%;justify-content:center;}
  @media(max-width:640px){
    .compare-grid{gap:10px;}
    .compare-card{padding:16px 12px;border-radius:16px;}
    .compare-top{
      grid-template-columns:1fr;
      grid-template-areas:"text" "photo" "apport";
      row-gap:0;margin-bottom:12px;
    }
    .compare-badge{top:-11px;font-size:9px;padding:4px 10px;}
    .compare-card-head{font-size:12px;gap:5px;margin-bottom:2px;}
    .compare-vehicle-name{font-size:11px;}
    .compare-photo{justify-self:stretch;align-self:center;justify-content:center;margin:4px 0 0;}
    .compare-photo img{width:100%;max-width:245px;}
    .compare-us .compare-photo img{max-width:265px;}
    .compare-apport{padding-bottom:10px;margin-top:2px;gap:0;}
    .compare-apport-from{font-size:9.5px;line-height:1;margin-bottom:1px;}
    .compare-apport-amount{font-size:20px;line-height:1;}
    .compare-apport-label{font-size:9.5px;line-height:1;margin-top:3px;}
