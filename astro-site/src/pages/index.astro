<style>
  section{padding:104px 0;}
  @media(max-width:768px){ section{padding:64px 0;} }

  /* hero */
  .hero{
    min-height:100svh;
    display:flex;flex-direction:column;justify-content:center;
    position:relative;
    overflow:clip;
    padding:132px 0 72px;
    border-bottom:1px solid var(--border);
  }
  .hero::before{
    content:'';position:absolute;z-index:0;
    inset:-10% -10% auto -10%;height:120%;
    background:radial-gradient(ellipse 46% 42% at 28% 42%, rgba(255,0,127,0.05), transparent 68%);
    pointer-events:none;
  }
  .hero-grid{
    position:absolute;inset:0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size:64px 64px;
    mask-image:radial-gradient(ellipse 60% 50% at 50% 40%, black, transparent);
    opacity:0.5;
  }
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:13px;color:var(--text-dim);
    border:1px solid var(--border);
    padding:6px 14px;border-radius:100px;
    margin-bottom:28px;
    width:fit-content;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--accent-1);}
  .hero-content{
    position:relative;z-index:2;
    display:grid;grid-template-columns:minmax(0,1fr) minmax(520px,1.05fr);
    align-items:center;gap:34px;
  }
  .hero-copy{position:relative;z-index:2;max-width:590px;}
  .hero-title-desktop,.hero-copy-desktop,.hero-waves,.hero-project,.hero-social-row,.trustpilot-proof,.hero-car-carousel,.hero-car-card,.hero-shooting-stars,.hero-brands{display:none;}
  .hero h1{font-size:clamp(50px,5.2vw,70px);max-width:720px;}
  .hero h1 em{font-style:normal;color:var(--text-faint);}
  .hero p{font-size:18px;color:var(--text-dim);max-width:540px;margin-top:26px;line-height:1.65;}
  .hero-actions{display:flex;align-items:center;gap:26px;margin-top:36px;flex-wrap:wrap;}
  .btn-primary{
    background:var(--accent);color:#fff;
    padding:18px 32px;border-radius:100px;
    font-weight:600;font-size:15px;
    transition:transform .2s ease, filter .2s ease, box-shadow .3s ease;
    display:inline-block;
    box-shadow:0 16px 36px rgba(190,24,93,.2);
  }
  .btn-primary:hover{filter:brightness(1.12);transform:translateY(-2px);box-shadow:0 14px 32px rgba(255,0,127,0.22), 0 4px 10px rgba(255,0,127,0.16);}
  .btn-primary:active{transform:scale(.96);box-shadow:0 4px 12px rgba(255,0,127,0.2);}
  .btn-secondary-link{
    display:inline-flex;align-items:center;gap:8px;
    color:var(--text-dim);font-size:14.5px;font-weight:600;
    padding:10px 0;border-bottom:1px solid var(--border);
    transition:color .2s ease,border-color .2s ease,gap .2s ease;
  }
  .btn-secondary-link:hover{color:var(--accent-1);border-color:var(--accent-1);gap:12px;}
  .btn-ghost{
    display:inline-block;border:1px solid var(--border);
    padding:15px 26px;border-radius:100px;
    font-weight:600;font-size:14.5px;color:var(--text);
    transition:border-color .2s ease,color .2s ease,transform .2s ease;
  }
  .btn-ghost:hover{border-color:var(--accent-1);color:var(--accent-1);transform:translateY(-2px);}
  .btn-ghost:active{transform:scale(.96);}

  .hero-proof-row{
    display:flex;align-items:stretch;
    margin-top:46px;padding-top:24px;
    border-top:1px solid var(--border);
  }
  .hero-proof{min-width:0;flex:1;padding:0 18px;border-right:1px solid var(--border);}
  .hero-proof:first-child{padding-left:0;}
  .hero-proof:last-child{border-right:0;}
  .hero-proof strong{display:block;font-family:'Space Grotesk',sans-serif;font-size:20px;letter-spacing:-.02em;}
  .hero-proof span{display:block;color:var(--text-faint);font-size:11.5px;margin-top:4px;}

  .hero-visual{
    --car-rest-x:-1%;
    position:relative;min-height:530px;display:flex;align-items:center;justify-content:center;
    isolation:isolate;
  }
  .hero-speed-lines{
    position:absolute;z-index:1;inset:31% -3% auto 18%;height:170px;
    pointer-events:none;
  }
  .hero-speed-lines span{
    position:absolute;right:0;height:2px;border-radius:100px;
    background:linear-gradient(90deg,transparent,rgba(255,0,127,.12) 25%,rgba(255,0,127,.72) 78%,transparent);
    filter:blur(.2px);
    opacity:0;
    transform-origin:right center;
    animation:heroSpeedLine 1.25s cubic-bezier(.16,1,.3,1) both;
  }
  .hero-speed-lines span:nth-child(1){top:28%;width:72%;animation-delay:.1s;}
  .hero-speed-lines span:nth-child(2){top:55%;width:54%;height:1px;animation-delay:.18s;}
  .hero-speed-lines span:nth-child(3){top:77%;width:38%;height:3px;animation-delay:.26s;}
