      align-self:stretch;
      display:flex;
      align-items:center;
      gap:7px;
      flex:0 0 auto;
      padding:0 14px 0 16px;
      color:#777880;
      background:linear-gradient(90deg,rgba(255,255,255,.76),rgba(255,255,255,.3));
      font-size:8px;
      font-weight:600;
      letter-spacing:.065em;
      text-transform:uppercase;
      white-space:nowrap;
    }
    .brands-label::before{
      content:'';
      flex:0 0 4px;
      width:4px;
      height:4px;
      border-radius:50%;
      background:rgba(190,24,93,.62);
      box-shadow:0 0 0 3px rgba(190,24,93,.05);
    }
    .brands-label::after{
      content:'';
      position:absolute;
      top:9px;
      right:0;
      bottom:9px;
      width:1px;
      background:linear-gradient(180deg,transparent,rgba(17,17,19,.13),transparent);
    }
    .brands-viewport{
      min-width:0;
      flex:1;
      margin-top:0;
    }
    .brand-logo{height:44px;}
    .brand-logo img{height:23px;max-width:34px;}
    .brand-logo-cupra img{height:22px;max-width:38px;}
  }

  /* section headers */
  .section-head{margin-bottom:56px;max-width:640px;}
  .section-eyebrow{font-size:13px;color:var(--text-faint);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px;}
  .section-head h2{font-size:clamp(28px,4vw,42px);}
  .section-head p{color:var(--text-dim);font-size:16px;margin-top:14px;}

  /* contact CTA (bas de page) — panneau sombre signature */
  .contact-cta{text-align:center;}
  .cta-panel{
    position:relative;overflow:hidden;isolation:isolate;
    background:linear-gradient(155deg, #131316 0%, #1c1c22 55%, #17121a 100%);
    border-radius:32px;
    padding:96px 48px;
    box-shadow:0 40px 80px rgba(17,17,19,0.22), 0 8px 28px rgba(255,0,127,0.10);
  }
  @media(max-width:768px){ .cta-panel{padding:64px 24px;border-radius:24px;} }
  .cta-panel-grid{
    position:absolute;inset:0;z-index:0;
    background-image:
      linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size:48px 48px;
    mask-image:radial-gradient(ellipse 70% 60% at 50% 35%, black, transparent);
    -webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 35%, black, transparent);
  }
  .cta-panel-glow{position:absolute;border-radius:50%;filter:blur(70px);pointer-events:none;z-index:0;}
  .cta-panel-glow-1{width:420px;height:420px;background:radial-gradient(circle, rgba(255,0,127,.32), transparent 70%);top:-170px;left:-110px;animation:ctaDrift1 15s ease-in-out infinite;}
  .cta-panel-glow-2{width:360px;height:360px;background:radial-gradient(circle, rgba(255,255,255,.08), transparent 70%);bottom:-150px;right:-90px;animation:ctaDrift2 17s ease-in-out infinite;}
  @keyframes ctaDrift1{0%,100%{transform:translate(0,0);}50%{transform:translate(26px,18px);}}
  @keyframes ctaDrift2{0%,100%{transform:translate(0,0);}50%{transform:translate(-22px,-14px);}}
  @media (prefers-reduced-motion: reduce){ .cta-panel-glow{animation:none;} }
  .cta-panel-content{position:relative;z-index:2;}
  .cta-panel .section-head{margin:0 auto 32px;}
  .cta-panel .section-head p{margin-left:auto;margin-right:auto;}
  .cta-panel .section-eyebrow{color:rgba(255,255,255,.5);}
  .cta-panel h2{color:#fff;}
  .cta-panel .section-head p{color:rgba(255,255,255,.66);}
  .contact-cta-btn{margin-bottom:56px;}
  .contact-cta-info{
    display:flex;justify-content:center;gap:48px;flex-wrap:wrap;
    padding-top:40px;border-top:1px solid var(--border);margin-bottom:40px;
  }
  .cta-panel .contact-cta-info{border-top-color:rgba(255,255,255,.14);}
  .cta-info-item .cta-info-label{font-size:12px;color:var(--text-faint);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px;}
  .cta-info-item a{color:var(--text-dim);font-size:15px;transition:color .2s ease;}
  .cta-info-item a:hover{color:var(--accent-1);}
  .cta-panel .cta-info-item .cta-info-label{color:rgba(255,255,255,.4);}
  .cta-panel .cta-info-item a{color:rgba(255,255,255,.85);}
  .cta-panel .cta-info-item a:hover{color:var(--accent-1);}
  .cta-socials{display:flex;justify-content:center;gap:14px;}
  .cta-panel .social-btn{border-color:rgba(255,255,255,.16);color:rgba(255,255,255,.7);}
  .cta-panel .social-btn:hover{border-color:var(--accent-1);color:var(--accent-1);}
  .social-btn{
    width:44px;height:44px;border-radius:50%;border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;color:var(--text-dim);
    transition:border-color .2s ease, color .2s ease, transform .2s ease;
  }
  .social-btn:hover{border-color:var(--accent-1);color:var(--accent-1);transform:translateY(-2px);}

  /* process + cta */
  .process-wrap{display:grid;gap:24px;}
  .process-card{
    background:#fff;border:1px solid var(--border);border-radius:28px;
    padding:48px;box-shadow:var(--shadow-sm);
  }
  .process-head{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);align-items:end;gap:64px;margin-bottom:38px;}
  .process-head h2{font-size:clamp(30px,3.4vw,42px);line-height:1.1;margin-top:0;}
  .process-head h2 em{font-style:normal;color:var(--accent-1);}
  .process-intro{max-width:390px;color:var(--text-dim);font-size:15.5px;line-height:1.65;padding-bottom:3px;}
  .process-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;position:relative;list-style:none;margin:0;padding:0;}
  .process-step{
    position:relative;min-height:202px;padding:22px 20px 20px;
    border:1px solid #ececf0;border-radius:20px;background:linear-gradient(155deg,#fff 0%,#fafafd 100%);
    transition:transform .3s cubic-bezier(.16,1,.3,1),border-color .3s ease,box-shadow .3s ease;
  }
  .process-step:hover{transform:translateY(-4px);border-color:#ead0dc;box-shadow:0 18px 34px rgba(17,17,19,.07);}
  .process-icon-wrap{position:relative;width:54px;height:54px;margin-bottom:22px;}
  .process-icon{
    display:grid;place-items:center;width:54px;height:54px;border-radius:16px;
    background:linear-gradient(145deg,#fff2f8,#f9dce9);color:var(--accent-1);position:relative;z-index:1;
  }
  .process-icon svg{width:23px;height:23px;}
  .process-num{
    position:absolute;top:-7px;right:-7px;z-index:2;
    display:grid;place-items:center;width:22px;height:22px;border-radius:50%;
    background:var(--accent);color:#fff;font-family:'Space Grotesk',sans-serif;font-size:11px;font-weight:700;
    border:2px solid #fff;
  }
  .process-step h3{font-size:16px;margin-bottom:8px;line-height:1.28;}
  .process-step p{font-size:13.5px;color:var(--text-dim);line-height:1.55;}
  .process-banner{
    display:flex;align-items:center;justify-content:center;gap:10px;
    margin-top:20px;padding:15px 18px;border-radius:14px;
    background:linear-gradient(90deg,#fff6fa,#fceaf2);color:var(--text-dim);font-size:14px;
  }
  .process-banner-icon{width:16px;height:16px;color:var(--accent-1);flex:none;}
  .process-banner strong{color:var(--accent-1);font-weight:700;}

  .process-cta-card{
    position:relative;overflow:hidden;isolation:isolate;
    background:linear-gradient(155deg, #131316 0%, #1c1c22 55%, #17121a 100%);
    border-radius:28px;padding:48px;min-height:390px;
    box-shadow:0 30px 60px rgba(17,17,19,0.2), 0 8px 24px rgba(255,0,127,0.1);
    display:flex;flex-direction:column;justify-content:center;
  }
  .process-cta-card::after{
    content:'';position:absolute;z-index:0;right:-5%;bottom:-56%;width:64%;aspect-ratio:1;border-radius:50%;
    background:radial-gradient(circle,rgba(255,0,127,.24) 0%,rgba(255,0,127,.07) 42%,transparent 70%);
    filter:blur(8px);pointer-events:none;
  }
  .process-cta-grid{
    position:absolute;inset:0;z-index:0;
    background-image:linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size:40px 40px;
    mask-image:radial-gradient(ellipse 80% 60% at 30% 20%, black, transparent);
    -webkit-mask-image:radial-gradient(ellipse 80% 60% at 30% 20%, black, transparent);
  }
  .process-cta-glow{position:absolute;border-radius:50%;filter:blur(64px);pointer-events:none;z-index:0;}
  .process-cta-glow-1{width:300px;height:300px;background:radial-gradient(circle, rgba(255,0,127,.4), transparent 70%);top:-90px;right:-70px;}
  .process-cta-glow-2{width:260px;height:260px;background:radial-gradient(circle, rgba(255,0,127,.22), transparent 70%);bottom:-40px;left:-60px;}
  .process-cta-content{position:relative;z-index:2;max-width:470px;}
  .process-cta-eyebrow{font-size:12px;color:var(--accent-1);text-transform:uppercase;letter-spacing:0.1em;font-weight:700;margin-bottom:14px;}
  .process-cta-card h3{font-size:clamp(28px,3.2vw,40px);line-height:1.12;color:#fff;font-weight:600;}
  .process-cta-accent{color:var(--accent-1);}
  .process-cta-card > .process-cta-content > p{color:rgba(255,255,255,.64);font-size:15px;line-height:1.65;margin-top:16px;max-width:430px;}
  .process-cta-btn{margin-top:24px;padding:15px 26px;font-size:14.5px;}
  .process-cta-proof{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:26px;}
  .process-cta-proof span{
    display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid rgba(255,255,255,.11);border-radius:999px;
    background:rgba(255,255,255,.055);color:rgba(255,255,255,.72);font-size:11.5px;line-height:1;
  }
  .process-cta-proof span::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent-1);box-shadow:0 0 0 3px rgba(255,0,127,.12);}
  .process-car-carousel{
    position:absolute;z-index:1;inset:0 0 0 auto;width:60%;overflow:hidden;pointer-events:none;
  }
  .process-car{
    --ground-y:-50%;position:absolute;top:55%;left:50%;width:min(646px,92%);height:auto;max-width:none;
    opacity:0;transform:translate3d(-145%,var(--ground-y),0);filter:none;
    transition:transform .9s cubic-bezier(.55,.05,.2,1),opacity .42s ease,filter .62s ease;
    will-change:transform,opacity;
  }
  .process-car:nth-child(1){--ground-y:-50%;}
  .process-car:nth-child(2){--ground-y:-54.79%;}
  .process-car:nth-child(3){--ground-y:-53.32%;}
  .process-car:nth-child(4){--ground-y:-51.07%;}
  .process-car.is-active{opacity:1;transform:translate3d(-50%,var(--ground-y),0);filter:drop-shadow(0 20px 30px rgba(0,0,0,.5));}
  .process-car.is-leaving{opacity:0;transform:translate3d(145%,var(--ground-y),0);filter:none;}
  @media(max-width:1080px){
    .process-head{gap:36px;}
    .process-steps{grid-template-columns:1fr 1fr;}
    .process-step{min-height:176px;}
    .process-car-carousel{width:62%;}
  }
  @media(max-width:760px){
    .process-head{grid-template-columns:1fr;align-items:start;gap:16px;margin-bottom:30px;}
    .process-head h2 br{display:none;}
    .process-intro{max-width:none;}
    .process-cta-card{justify-content:flex-start;min-height:600px;}
    .process-cta-content{max-width:none;}
    .process-car-carousel{inset:auto 0 0;width:100%;height:285px;}
    .process-car{top:53%;width:min(595px,88%);}
  }
  @media(max-width:640px){
    .process-card{padding:30px 22px 22px;border-radius:22px;}
    .process-head h2{font-size:29px;}
    .process-intro{font-size:14.5px;line-height:1.58;}
    .process-steps{grid-template-columns:1fr;gap:10px;}
    .process-step{display:grid;grid-template-columns:50px 1fr;gap:16px;align-items:start;min-height:0;padding:17px 16px;border-radius:16px;}
    .process-step:hover{transform:none;}
    .process-icon-wrap{width:50px;height:50px;margin:0;}
    .process-icon{width:50px;height:50px;border-radius:14px;}
    .process-icon svg{width:21px;height:21px;}
    .process-step h3{font-size:15px;margin-top:1px;margin-bottom:5px;}
    .process-step p{font-size:13px;line-height:1.48;}
    .process-banner{justify-content:flex-start;margin-top:12px;padding:14px;font-size:13px;line-height:1.45;}
    .process-cta-card{padding:32px 24px;border-radius:22px;min-height:560px;}
    .process-cta-card h3{font-size:30px;}
    .process-cta-card > .process-cta-content > p{font-size:14px;line-height:1.55;}
    .process-cta-btn{width:100%;justify-content:center;}
    .process-cta-proof{gap:7px;}
    .process-cta-proof span{font-size:10.5px;padding:7px 9px;}
    .process-car-carousel{height:245px;}
    .process-car{top:52%;width:88%;}
  }

  /* categories */
  .accept-head h2 em{font-style:normal;color:var(--accent-1);}
  .accept-intro{margin-top:16px;max-width:600px;color:var(--text-dim);font-size:15.5px;line-height:1.6;}

  /* accept diagram */
  .accept-icon{
    display:flex;align-items:center;justify-content:center;flex:none;
    width:48px;height:48px;
    border-radius:50%;color:#17171b;
    background:linear-gradient(145deg,#fff0f7,#fbe2ed);
    box-shadow:inset 0 0 0 1px rgba(255,0,127,.035);
  }
  .accept-icon svg{width:22px;height:22px;}
  .accept-diagram{position:relative;display:flex;align-items:center;gap:72px;margin:56px 0 32px;}
  .accept-file-card{
    position:relative;z-index:2;flex:0 0 210px;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
    background:#fff;border:1px solid var(--border);border-radius:20px;
    padding:34px 20px;box-shadow:var(--shadow-sm);text-align:center;
  }
  .accept-file-label{font-weight:700;font-size:15.5px;letter-spacing:-.01em;}
  .accept-partners{position:relative;z-index:2;flex:1;display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .accept-partner{
    display:flex;flex-direction:column;align-items:center;gap:12px;
    background:#fff;border:1px solid var(--border);border-radius:18px;
    padding:26px 20px;box-shadow:var(--shadow-sm);text-align:center;
    transition:border-color .3s ease, box-shadow .3s ease;
  }
  .accept-partner-name{font-weight:700;font-size:15.5px;letter-spacing:-.01em;}
  .accept-status{display:inline-flex;padding:4px 13px;border-radius:100px;font-size:12px;font-weight:600;}
  .accept-status-refused{background:#fdeceb;color:#c0392b;}
  .accept-status-accepted{background:#e7f8ee;color:#1e8e4a;}
  .accept-partner-accepted{border-color:rgba(30,142,74,.3);background:linear-gradient(180deg,#f5fbf7,#fff);}
  .accept-partner-accepted .accept-icon{background:linear-gradient(145deg,#e7f8ee,#d3f1de);color:#1e8e4a;box-shadow:inset 0 0 0 1px rgba(30,142,74,.06);}
  .accept-lines{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;overflow:visible;}
  .accept-line{fill:none;stroke:var(--accent-1);stroke-width:1.75;opacity:.4;}
  .accept-line-accepted{opacity:.85;stroke-width:2.25;}
  .accept-note{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:36px;color:var(--text-dim);font-size:14.5px;font-weight:500;}
  .accept-note-icon{display:flex;color:var(--accent-1);}
  .accept-note-icon svg{width:18px;height:18px;}
  .accept-stats{
    display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;
    background:#fff;border:1px solid var(--border);border-radius:20px;
    padding:22px 30px;box-shadow:var(--shadow-sm);
  }
  .accept-stat{display:flex;align-items:center;gap:14px;font-size:14.5px;font-weight:600;color:var(--text);}
  .accept-stat .accept-icon{width:42px;height:42px;}
  .accept-stat .accept-icon svg{width:19px;height:19px;}
  @media(max-width:760px){
    .accept-diagram{flex-direction:column;align-items:stretch;gap:28px;}
    .accept-file-card{flex:none;width:100%;}
    .accept-lines{display:none;}
    .accept-stats{flex-direction:column;align-items:flex-start;gap:18px;padding:24px 26px;}
  }
  @media(max-width:480px){ .accept-partners{grid-template-columns:1fr;} }

  /* comparison table */
  .compare-head{margin:0 auto 44px;text-align:center;max-width:640px;}
  .compare-head h2{font-size:clamp(32px,4.6vw,48px);}
  .compare-head p{font-size:16.5px;margin:14px auto 0;max-width:520px;}
  .highlight-mark{position:relative;display:inline-block;padding:0 4px;white-space:nowrap;}
  .highlight-mark::before{
    content:'';position:absolute;left:-3px;right:-3px;top:0.08em;bottom:0.05em;
    background:rgba(255,0,127,0.16);border-radius:8px;z-index:-1;
  }
  .compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch;}
  .compare-top{
    display:grid;grid-template-columns:1fr auto;
    grid-template-areas:"text photo" "apport apport";
    column-gap:14px;row-gap:0;align-items:center;margin-bottom:22px;
  }
  .compare-top-text{grid-area:text;min-width:0;}
  .compare-photo{grid-area:photo;display:flex;align-self:center;}
  .compare-them .compare-photo{filter:grayscale(.4) opacity(.85);}
  .compare-photo img{width:150px;height:auto;display:block;}
  .compare-vehicle-name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15.5px;}
  .compare-them .compare-vehicle-name{color:var(--text-dim);}
  .compare-card{border-radius:24px;padding:32px;}
  .compare-us{
    background:#fff;position:relative;overflow:visible;
    border:2px solid var(--accent-1);
    box-shadow:0 20px 44px rgba(255,0,127,0.14), var(--shadow-md);
    display:flex;flex-direction:column;
  }
  .compare-badge{
    position:absolute;top:-15px;left:32px;z-index:2;
    background:var(--accent);color:#fff;font-size:11.5px;font-weight:700;
    text-transform:uppercase;letter-spacing:0.05em;padding:6px 16px;border-radius:100px;
    box-shadow:0 6px 16px rgba(255,0,127,0.28);
  }
  .compare-them{background:var(--surface);border:1px solid var(--border);display:flex;flex-direction:column;}
  .compare-card-head{
    font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:17px;
    display:flex;align-items:center;gap:9px;margin-bottom:6px;
  }
  .compare-them .compare-card-head{color:var(--text-faint);font-weight:600;}
  .compare-logo-dot{width:8px;height:8px;border-radius:50%;background:var(--accent);flex:none;}
  .compare-apport{
    grid-area:apport;
    display:flex;flex-direction:column;gap:2px;padding-bottom:22px;margin-top:22px;
    border-bottom:1px solid var(--border);
  }
  .compare-us .compare-apport{border-bottom-color:rgba(255,0,127,0.15);}
  .compare-apport-amount{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:34px;}
  .compare-them .compare-apport-amount{color:var(--text-dim);}
  .compare-us .compare-apport-amount{color:var(--accent-1);}
  .compare-apport-label{font-size:13px;color:var(--text-faint);}
  .compare-list{list-style:none;display:flex;flex-direction:column;gap:13px;}
  .compare-list li{display:flex;align-items:center;gap:11px;font-size:14px;}
  .compare-list li svg{flex:none;}
  .compare-us .compare-list li{color:var(--text);}
  .compare-them .compare-list li{color:var(--text-faint);}
  .compare-list-strong{
    font-weight:700;color:var(--text);
    background:rgba(255,0,127,0.08);
    margin:0 -10px;padding:6px 10px;border-radius:10px;
  }
  .compare-cta{margin-top:26px;width:100%;justify-content:center;}
  @media(max-width:860px){ .compare-grid{grid-template-columns:1fr;} }
  @media(max-width:640px){
    .compare-card{padding:26px 24px;}
  }
  @media(min-width:861px){
    .compare-head{max-width:none;}
    .compare-head p{max-width:none;white-space:nowrap;}
    .compare-card{padding:20px 30px 22px;}
    .compare-top{
      grid-template-areas:"text photo" "apport photo";
      grid-template-rows:auto 1fr;
      column-gap:10px;row-gap:2px;align-items:start;margin-bottom:8px;
    }
    .compare-card-head{margin-bottom:2px;}
    .compare-photo{align-self:stretch;justify-content:flex-end;align-items:flex-end;margin-left:auto;}
    .compare-photo img{width:270px;}
    .compare-apport{padding-bottom:0;margin-top:6px;border-bottom:none;align-self:end;}
    .compare-apport-amount{line-height:1;}
    .compare-top{padding-bottom:8px;border-bottom:1px solid var(--border);}
    .compare-us .compare-top{border-bottom-color:rgba(255,0,127,0.15);}
    .compare-list{gap:6px;}
    .compare-cta{margin-top:8px;padding:11px 26px;}
  }

  /* des solutions pour chaque profil */
