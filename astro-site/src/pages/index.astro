<script>
  // desktop hero vehicle carousel — a new car enters from the left every 3 seconds
  (function(){
    const carousel = document.querySelector('[data-hero-car-carousel]') as HTMLElement | null;
    if(!carousel || !window.matchMedia('(min-width: 981px)').matches) return;

    const cars = Array.from(carousel.querySelectorAll('.hero-car')) as HTMLElement[];
    const carCard = document.querySelector('[data-hero-car-card]') as HTMLElement | null;
    const cardModel = carCard?.querySelector('.hero-car-card-model') as HTMLElement | null;
    const cardPrice = carCard?.querySelector('.hero-car-card-price b') as HTMLElement | null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(cars.length < 2 || reduceMotion) return;

    let currentIndex = 0;
    let cycleTimer = 0;
    let cardSwapTimer = 0;

    const updateCarCard = (car: HTMLElement) => {
      if(!carCard || !cardModel || !cardPrice) return;
      window.clearTimeout(cardSwapTimer);
      carCard.classList.add('is-changing');
      cardSwapTimer = window.setTimeout(() => {
        cardModel.textContent = car.dataset.model || '';
        cardPrice.textContent = car.dataset.price || '';
        carCard.classList.remove('is-changing');
      }, 700);
    };

    const advanceCar = () => {
      const current = cars[currentIndex];
      const nextIndex = (currentIndex + 1) % cars.length;
      const next = cars[nextIndex];

      current.classList.remove('is-active','is-initial');
      current.classList.add('is-leaving');
      next.classList.remove('is-leaving','is-initial');
      next.classList.add('is-active');
      updateCarCard(next);

      window.setTimeout(() => current.classList.remove('is-leaving'), 980);
      currentIndex = nextIndex;
    };

    const startCarousel = () => {
      window.clearInterval(cycleTimer);
      cycleTimer = window.setInterval(advanceCar, 3000);
    };

    window.setTimeout(() => carCard?.classList.remove('is-changing'), 1250);
    window.setTimeout(() => cars[0].classList.remove('is-initial'), 1450);
    startCarousel();

    document.addEventListener('visibilitychange', () => {
      if(document.hidden) window.clearInterval(cycleTimer);
      else startCarousel();
    });
  })();

  // hero floating stars — canvas particle field with depth, twinkle & parallax
  (function(){
    const canvas = document.getElementById('heroStars') as HTMLCanvasElement | null;
    const hero = canvas && canvas.closest('.hero') as HTMLElement | null;
    if(!canvas || !hero) return;
    const ctx = canvas.getContext('2d');
    if(!ctx) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const rand = (min: number, max: number) => Math.random()*(max-min)+min;

    let W: number, H: number, DPR: number;
    let particles: any[] = [], shootingStars: any[] = [];
    let mouseX = 0.5, mouseY = 0.5, targetX = 0.5, targetY = 0.5;
    let rafId: number, lastT = 0, running = false;

    function makeParticle(fromTop: boolean){
      const depth = Math.random();
      return {
        x: rand(0, W),
        y: fromTop ? -10 : rand(0, H),
        r: rand(0.5,1.1) + depth*1.7,
        depth,
        vy: rand(4,9) + depth*11,
        driftAmp: rand(6,16) + depth*10,
        driftFreq: rand(0.15,0.35),
        phase: rand(0, Math.PI*2),
        twinkleFreq: rand(0.4,1.3),
        twinklePhase: rand(0, Math.PI*2),
        baseAlpha: rand(0.08,0.16) + depth*0.12,
        pink: Math.random() < 0.12,
      };
    }

    function seed(){
      const area = W*H;
      const target = Math.max(28, Math.min(W < 640 ? 55 : 120, Math.round(area/9500)));
      particles = Array.from({length: target}, () => makeParticle(false));
    }

    function resize(){
      const rect = hero!.getBoundingClientRect();
      W = rect.width; H = rect.height;
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = W*DPR; canvas!.height = H*DPR;
      canvas!.style.width = W+'px'; canvas!.style.height = H+'px';
      ctx!.setTransform(DPR,0,0,DPR,0,0);
      seed();
      drawStatic();
    }

    function drawStatic(){
      ctx!.clearRect(0,0,W,H);
      for(const p of particles){
        ctx!.beginPath();
        ctx!.fillStyle = p.pink ? `rgba(255,0,127,${p.baseAlpha})` : `rgba(17,17,19,${p.baseAlpha})`;
        ctx!.arc(p.x,p.y,p.r,0,Math.PI*2);
        ctx!.fill();
      }
    }

    function frame(t: number){
      if(!running) return;
      const dt = Math.min((t-lastT)/1000, 0.05);
      lastT = t;
      mouseX += (targetX-mouseX)*0.04;
      mouseY += (targetY-mouseY)*0.04;
      const time = t/1000;
      const parX = (mouseX-0.5)*24;
      const parY = (mouseY-0.5)*14;

      ctx!.clearRect(0,0,W,H);

      for(const p of particles){
        p.y += p.vy*dt;
        if(p.y - p.r > H+20) Object.assign(p, makeParticle(true));
        const driftX = Math.sin(time*p.driftFreq + p.phase)*p.driftAmp;
        const twinkle = 0.55 + 0.45*Math.sin(time*p.twinkleFreq + p.twinklePhase);
        const alpha = p.baseAlpha*twinkle;
        const px = p.x + driftX + parX*p.depth;
        const py = p.y + parY*p.depth;

        ctx!.beginPath();
        ctx!.fillStyle = p.pink ? `rgba(255,0,127,${alpha})` : `rgba(17,17,19,${alpha})`;
        ctx!.arc(px,py,p.r,0,Math.PI*2);
        ctx!.fill();
      }

      if(Math.random() < 0.0035 && shootingStars.length < 2){
        const angle = rand(0.35,0.55);
        const pink = Math.random() < 0.25;
        shootingStars.push({x:rand(W*0.1,W*0.7), y:rand(0,H*0.3), len:rand(60,110), speed:rand(600,900), angle, life:0, maxLife:rand(0.5,0.8), pink});
      }
      shootingStars = shootingStars.filter(s => s.life < s.maxLife);
      for(const s of shootingStars){
        s.life += dt;
        const progress = s.life/s.maxLife;
        const x2 = s.x + Math.cos(s.angle)*s.speed*s.life;
        const y2 = s.y + Math.sin(s.angle)*s.speed*s.life;
        const x1 = x2 - Math.cos(s.angle)*s.len;
        const y1 = y2 - Math.sin(s.angle)*s.len;
        const fade = progress < 0.15 ? progress/0.15 : (1-progress)/0.85;
        const grad = ctx!.createLinearGradient(x1,y1,x2,y2);
        const rgb = s.pink ? '255,0,127' : '17,17,19';
        grad.addColorStop(0,`rgba(${rgb},0)`);
        grad.addColorStop(1,`rgba(${rgb},${0.4*fade})`);
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 1.4;
        ctx!.beginPath();
        ctx!.moveTo(x1,y1);
        ctx!.lineTo(x2,y2);
        ctx!.stroke();
      }

      rafId = requestAnimationFrame(frame);
    }

    if(!isTouch){
      hero.addEventListener('mousemove', (e: MouseEvent)=>{
        const rect = hero!.getBoundingClientRect();
        targetX = (e.clientX-rect.left)/rect.width;
        targetY = (e.clientY-rect.top)/rect.height;
      });
    }

    document.addEventListener('visibilitychange', ()=>{
      if(reduceMotion) return;
      if(document.hidden){ running = false; cancelAnimationFrame(rafId); }
      else if(!running){ running = true; lastT = performance.now(); rafId = requestAnimationFrame(frame); }
    });

    window.addEventListener('resize', resize);
    resize();

    if(!reduceMotion){
      running = true;
      lastT = performance.now();
      rafId = requestAnimationFrame(frame);
    }
  })();

  // scroll reveal
  const items = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); } });
  },{threshold:0.15});
  items.forEach(i=>io.observe(i));

  // cursor glow (desktop only)
  const glow = document.getElementById('cursorGlow');
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  if(!isTouch && glow){
    window.addEventListener('mousemove', (e)=>{
      glow.classList.add('active');
      (glow as HTMLElement).style.left = e.clientX + 'px';
      (glow as HTMLElement).style.top = e.clientY + 'px';
    });
    window.addEventListener('mouseleave', ()=> glow.classList.remove('active'));
  }

  // magnetic buttons (desktop only)
  if(!isTouch){
    document.querySelectorAll<HTMLElement>('.btn-primary, .btn-ghost').forEach(btn=>{
      btn.addEventListener('mousemove', (e: MouseEvent)=>{
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left - r.width/2;
        const y = e.clientY - r.top - r.height/2;
        btn.style.transform = `translate(${x*0.18}px, ${y*0.35}px)`;
      });
      btn.addEventListener('mouseleave', ()=>{ btn.style.transform = 'translate(0,0)'; });
    });
  }

  // animated counters
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const counterIO = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.count!, 10);
        const suffix = el.dataset.suffix || '';
        const duration = 1200;
        const start = performance.now();
        function tick(now: number){
          const p = Math.min((now-start)/duration, 1);
          const eased = 1 - Math.pow(1-p, 3);
          const val = Math.round(target * eased);
          el.textContent = val + suffix;
          if(p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        counterIO.unobserve(el);
      }
    });
  },{threshold:0.5});
  counters.forEach(c=>counterIO.observe(c));

  // fleet teaser (catalogue preview carousel) — véhicules déjà rendus au
  // build ; ce script ne gère plus que le défilement horizontal.
  (function(){
    const track = document.getElementById('fleetTrack');
    const prevBtn = document.getElementById('fleetPrev') as HTMLButtonElement;
    const nextBtn = document.getElementById('fleetNext') as HTMLButtonElement;
    const indexEl = document.getElementById('fleetIndex')!;
    if(!track || !track.querySelector('.fleet-card')) return;

    function cardStep(){
      const card = track!.querySelector('.fleet-card');
      if(!card) return 300;
      return card.getBoundingClientRect().width + 20;
    }

    function updateNav(){
      const step = cardStep();
      const i = Math.round(track!.scrollLeft / step);
      indexEl.textContent = String(i + 1).padStart(2,'0');
      prevBtn.disabled = track!.scrollLeft <= 4;
      nextBtn.disabled = track!.scrollLeft >= track!.scrollWidth - track!.clientWidth - 4;
    }

    prevBtn.addEventListener('click', ()=> track!.scrollBy({left: -cardStep(), behavior:'smooth'}));
    nextBtn.addEventListener('click', ()=> track!.scrollBy({left: cardStep(), behavior:'smooth'}));
    let scrollTimer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', ()=>{
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(updateNav, 80);
    }, {passive:true});

    updateNav();
  })();

  // faq accordion
  const faqEasing = 'cubic-bezier(.16,1,.3,1)';
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(item=>{
    const summary = item.querySelector('summary')!;
    const content = item.querySelector<HTMLElement>('.faq-content')!;
    summary.addEventListener('click', (e)=>{
      e.preventDefault();
      if(item.classList.contains('is-animating')) return;
      item.open ? closeFaq(item, content) : openFaq(item, content);
    });
  });

  function openFaq(item: HTMLDetailsElement, content: HTMLElement){
    item.classList.add('is-animating');
    item.open = true;
    const target = content.scrollHeight;
    content.style.overflow = 'hidden';
    const anim = content.animate(
      [{ height:'0px', opacity:0 }, { height: target+'px', opacity:1 }],
      { duration:320, easing:faqEasing }
    );
    anim.onfinish = ()=>{
      content.style.overflow = '';
      content.style.height = '';
      item.classList.remove('is-animating');
    };
  }

  function closeFaq(item: HTMLDetailsElement, content: HTMLElement){
    item.classList.add('is-animating');
    const start = content.scrollHeight;
    content.style.overflow = 'hidden';
    const anim = content.animate(
      [{ height:start+'px', opacity:1 }, { height:'0px', opacity:0 }],
      { duration:280, easing:faqEasing }
    );
    anim.onfinish = ()=>{
      item.open = false;
      content.style.overflow = '';
      content.style.height = '';
      item.classList.remove('is-animating');
    };
  }
</script>

<script define:vars={{ fleetCarIcon }}>
  window.__fleetCarIcon = fleetCarIcon;
</script>
