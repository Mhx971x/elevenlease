  /* connection diagram - signature element */
  .connection-strip{padding:38px 0;background:var(--surface);border-bottom:1px solid var(--border);}
  .connect-diagram{
    position:relative;z-index:2;
    display:flex;align-items:center;justify-content:center;gap:0;
    max-width:880px;margin:0 auto;
  }
  .node{
    border:1px solid var(--border);
    background:#fff;
    box-shadow:var(--shadow-sm);
    border-radius:16px;
    padding:20px 26px;
    min-width:180px;
    text-align:center;
  }
  .node .label{font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-faint);margin-bottom:6px;}
  .node .value{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:16px;}
  .connect-line{
    flex:1;height:1px;position:relative;
    background:linear-gradient(90deg, var(--border), var(--text), var(--border));
    margin:0 16px;
    overflow:hidden;
  }
  .connect-line::after{
    content:'';position:absolute;top:-1.5px;left:-20%;
    width:20%;height:4px;
    background:radial-gradient(circle, rgba(255,0,127,0.85), transparent 70%);
    animation:travel 2.8s linear infinite;
  }
  @keyframes travel{
    0%{left:-20%;}
    100%{left:100%;}
  }
  @media(max-width:640px){
    .connect-diagram{flex-direction:column;gap:16px;}
    .connect-line{width:1px;height:40px;margin:0;background:linear-gradient(180deg, var(--border), var(--text), var(--border));}
    .connect-line::after{display:none;}
  }
  @media(max-width:980px){
    .hero-content{grid-template-columns:1fr;gap:10px;}
    .hero-copy{max-width:720px;}
    .hero-visual{min-height:430px;max-width:720px;width:100%;margin:0 auto;}
    .hero-visual-ring{width:min(470px,70vw);}
    .hero-mobile-car img{width:min(760px,112%);}
    .hero-visual-label{right:4%;top:8%;}
  }
  @media(max-width:640px){
    .hero{padding:118px 0 34px;min-height:auto;}
    .hero-content{gap:4px;}
    .hero h1{font-size:clamp(42px,13vw,58px);}
