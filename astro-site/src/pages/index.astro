    .compare-list li{font-size:10px;gap:5px;align-items:flex-start;line-height:1.3;}
    .compare-list li svg{width:12px;height:12px;margin-top:1px;}
    .compare-list-strong{margin:0 -5px;padding:4px 5px;border-radius:7px;}
    .compare-list li.compare-hide-mobile{display:none;}
    .compare-cta{margin-top:14px;padding:10px 8px;font-size:10.5px;gap:5px;white-space:nowrap;}
    .compare-cta .cta-calculator-icon{width:12px;height:12px;flex-basis:12px;}
  }
  @media(min-width:861px){
    .compare-head{max-width:none;}
    .compare-head p{max-width:none;white-space:nowrap;}
    .compare-card{padding:20px 30px 22px;}
    .compare-top{
      grid-template-areas:"text photo" "apport photo";
      grid-template-rows:auto 1fr;
      column-gap:10px;row-gap:2px;align-items:start;margin-bottom:8px;
      min-height:194px;
    }
    .compare-card-head{margin-bottom:2px;}
