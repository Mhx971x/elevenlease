  /* des solutions pour chaque profil */
  .profiles-section{padding:100px 0;border-top:1px solid var(--border);background:var(--surface);}
  #avis{background:var(--surface);}
  .profiles-head{max-width:720px;margin:0 auto 32px;text-align:center;}
  .profiles-head h2{font-size:clamp(32px,4.6vw,48px);letter-spacing:-.035em;}
  .profiles-head p{max-width:600px;margin:14px auto 0;color:var(--text-dim);font-size:16.5px;line-height:1.55;}
  .profiles-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:920px;margin:0 auto;}
  .profile-card{
    position:relative;overflow:hidden;isolation:isolate;
    background:linear-gradient(155deg, #131316 0%, #1c1c22 55%, #17121a 100%);
    border:1px solid rgba(255,255,255,.1);border-radius:26px;padding:40px 38px;
    box-shadow:0 24px 48px rgba(17,17,19,0.2), 0 8px 20px rgba(255,0,127,0.08);
    transition:transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s ease, border-color .35s ease;
  }
  .profile-card::before{
    content:'';position:absolute;inset:0;z-index:0;
    background-image:
      radial-gradient(120% 100% at 100% 0%, var(--tint, transparent), transparent 60%),
      linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size:auto, 32px 32px, 32px 32px;
    mask-image:radial-gradient(ellipse 90% 85% at 25% 15%, black, transparent);
    -webkit-mask-image:radial-gradient(ellipse 90% 85% at 25% 15%, black, transparent);
  }
  .profile-card::after{
    content:'';position:absolute;z-index:0;top:-70px;right:-70px;width:230px;height:230px;border-radius:50%;
    background:radial-gradient(circle, var(--glow, rgba(255,0,127,.35)), transparent 70%);
    filter:blur(56px);pointer-events:none;
  }
  .profile-card > *{position:relative;z-index:1;}
  .profile-card.particulier{--tint:rgba(255,0,127,0.18);--glow:rgba(255,0,127,.4);}
  .profile-card.pro{--tint:rgba(255,255,255,0.08);--glow:rgba(255,255,255,.18);}
  .profile-card:hover{border-color:rgba(255,255,255,.2);transform:translateY(-8px);box-shadow:0 32px 60px rgba(17,17,19,0.26), 0 10px 26px rgba(255,0,127,0.14);}
  .profile-icon{
    width:60px;height:60px;border-radius:18px;display:flex;align-items:center;justify-content:center;margin-bottom:24px;
  }
  .profile-icon.particulier{background:var(--accent);box-shadow:0 10px 24px rgba(255,0,127,0.35);}
  .profile-icon.pro{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.16);box-shadow:0 10px 24px rgba(0,0,0,.25);}
  .profile-card h3{font-size:22px;margin-bottom:20px;color:#fff;}
  .profile-list{display:flex;flex-direction:column;gap:13px;margin-bottom:24px;padding-bottom:28px;border-bottom:1px solid rgba(255,255,255,.12);}
  .profile-list li{display:flex;align-items:center;gap:10px;font-size:14.5px;color:rgba(255,255,255,.68);list-style:none;}
  .profile-list svg{flex:none;}
  .profile-cta{
    display:inline-flex;align-items:center;justify-content:center;gap:9px;width:100%;
    background:var(--accent);color:#fff;padding:15px 26px;border-radius:100px;
    font-weight:600;font-size:14.5px;
    transition:transform .2s ease, filter .2s ease, box-shadow .3s ease;
  }
  .profile-cta:hover{filter:brightness(1.12);transform:translateY(-2px);box-shadow:0 14px 32px rgba(255,0,127,0.3), 0 4px 10px rgba(255,0,127,0.16);}
  .profile-cta:active{transform:scale(.96);}
  @media(max-width:768px){
