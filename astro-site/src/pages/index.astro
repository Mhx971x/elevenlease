    .compare-apport-amount{line-height:1;}
    .compare-top{padding-bottom:8px;border-bottom:1px solid var(--border);}
    .compare-us .compare-top{border-bottom-color:rgba(255,0,127,0.15);}
    .compare-list{gap:6px;}
    .compare-cta{margin-top:8px;padding:11px 26px;}
