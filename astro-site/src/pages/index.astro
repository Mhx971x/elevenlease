<script>
  // shared vehicle carousel — hero and process CTA stay in sync every 3 seconds
  (function(){
    const carousels = Array.from(document.querySelectorAll('[data-vehicle-carousel]')) as HTMLElement[];
    const carGroups = carousels
      .map(carousel => Array.from(carousel.querySelectorAll('[data-carousel-car]')) as HTMLElement[])
      .filter(cars => cars.length > 0);
    if(carGroups.length === 0) return;

    const heroCarousel = document.querySelector('[data-hero-car-carousel]') as HTMLElement | null;
    const heroCars = heroCarousel
      ? Array.from(heroCarousel.querySelectorAll('[data-carousel-car]')) as HTMLElement[]
      : [];
    const carCard = document.querySelector('[data-hero-car-card]') as HTMLElement | null;
    const cardModel = carCard?.querySelector('.hero-car-card-model') as HTMLElement | null;
    const cardPrice = carCard?.querySelector('.hero-car-card-price b') as HTMLElement | null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const carCount = Math.min(...carGroups.map(cars => cars.length));
    if(carCount < 2 || reduceMotion) return;

    let currentIndex = 0;
    let cycleTimer = 0;
    let cardSwapTimer = 0;
    let leavingTimers: number[] = [];

    const updateCarCard = (car: HTMLElement) => {
      if(!carCard || !cardModel || !cardPrice) return;
      window.clearTimeout(cardSwapTimer);
      carCard.classList.add('is-changing');
      cardSwapTimer = window.setTimeout(() => {
        cardModel.textContent = car.dataset.model || '';
        cardPrice.textContent = car.dataset.price || '';
        carCard.classList.remove('is-changing');
      }, 700);
    };

    const advanceCar = () => {
      const nextIndex = (currentIndex + 1) % carCount;

      carGroups.forEach(cars => {
        const current = cars[currentIndex];
        const next = cars[nextIndex];
        current.classList.remove('is-active','is-initial');
        current.classList.add('is-leaving');
        next.classList.remove('is-leaving','is-initial');
        next.classList.add('is-active');
        leavingTimers.push(window.setTimeout(() => current.classList.remove('is-leaving'), 980));
      });

      if(heroCars[nextIndex]) updateCarCard(heroCars[nextIndex]);
      currentIndex = nextIndex;
    };

    const clearLeavingState = () => {
      leavingTimers.forEach(t => window.clearTimeout(t));
      leavingTimers = [];
      carGroups.forEach(cars => cars.forEach(car => car.classList.remove('is-leaving')));
    };

    const startCarousel = () => {
      window.clearInterval(cycleTimer);
      cycleTimer = window.setInterval(advanceCar, 3000);
    };

    window.setTimeout(() => carCard?.classList.remove('is-changing'), 1250);
    window.setTimeout(() => heroCars[0]?.classList.remove('is-initial'), 1450);
    startCarousel();

    document.addEventListener('visibilitychange', () => {
      if(document.hidden) {
        window.clearInterval(cycleTimer);
      } else {
        clearLeavingState();
        startCarousel();
      }
    });
  })();

  // hero floating stars — canvas particle field with depth, twinkle & parallax
  (function(){
    const canvas = document.getElementById('heroStars') as HTMLCanvasElement | null;
    const hero = canvas && canvas.closest('.hero') as HTMLElement | null;
    if(!canvas || !hero) return;
    const ctx = canvas.getContext('2d');
    if(!ctx) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const rand = (min: number, max: number) => Math.random()*(max-min)+min;

    let W: number, H: number, DPR: number;
    let particles: any[] = [], shootingStars: any[] = [];
    let mouseX = 0.5, mouseY = 0.5, targetX = 0.5, targetY = 0.5;
    let rafId: number, lastT = 0, running = false, heroVisible = true, nextShootingStarAt = 0;

    function makeParticle(fromTop: boolean){
      const depth = Math.random();
      return {
        x: rand(0, W),
        y: fromTop ? -10 : rand(0, H),
        r: rand(.6,1.35) + depth*.85,
        depth,
        vy: rand(3,7) + depth*8,
        driftAmp: rand(6,16) + depth*10,
        driftFreq: rand(0.15,0.35),
        phase: rand(0, Math.PI*2),
        twinkleFreq: rand(0.4,1.3),
        twinklePhase: rand(0, Math.PI*2),
        baseAlpha: rand(.12,.2) + depth*.08,
        pink: Math.random() < .3,
        glow: depth > .62 && Math.random() < .28,
      };
    }

    function seed(){
      const area = W*H;
      const target = Math.max(24,Math.min(W < 640 ? 38 : 52,Math.round(area/18000)));
      particles = Array.from({length: target}, () => makeParticle(false));
    }

    function scheduleShootingStar(now: number, first = false){
      nextShootingStarAt = now + rand(first ? 650 : 3600,first ? 1300 : 6200);
    }

    function createShootingStar(){
      const angle = rand(.28,.5);
      const lengthBias = Math.pow(Math.random(),.7);
      shootingStars.push({
        x:rand(-W*.06,W*.64),
        y:rand(H*.04,H*.38),
        len:105 + lengthBias*155,
        speed:rand(620,900),
        angle,
        life:0,
        maxLife:rand(.78,1.12),
        width:rand(1.35,2.05),
        alpha:rand(.72,.94),
        pink:Math.random() < .68,
      });
    }

    function resize(){
      const rect = hero!.getBoundingClientRect();
      W = rect.width; H = rect.height;
      DPR = Math.min(window.devicePixelRatio || 1,1.25);
      canvas!.width = W*DPR; canvas!.height = H*DPR;
      canvas!.style.width = W+'px'; canvas!.style.height = H+'px';
      ctx!.setTransform(DPR,0,0,DPR,0,0);
      seed();
      scheduleShootingStar(performance.now(),true);
      drawStatic();
    }

    function drawStatic(){
      ctx!.clearRect(0,0,W,H);
      for(const p of particles){
        ctx!.beginPath();
        ctx!.fillStyle = p.pink ? `rgba(255,0,127,${p.baseAlpha})` : `rgba(17,17,19,${p.baseAlpha})`;
        ctx!.arc(p.x,p.y,p.r,0,Math.PI*2);
        ctx!.fill();
      }
    }

    function frame(t: number){
      if(!running) return;
      const dt = Math.min((t-lastT)/1000, 0.05);
      lastT = t;
      mouseX += (targetX-mouseX)*0.04;
      mouseY += (targetY-mouseY)*0.04;
      const time = t/1000;
      const parX = (mouseX-0.5)*24;
      const parY = (mouseY-0.5)*14;

      ctx!.clearRect(0,0,W,H);

      for(const p of particles){
        p.y += p.vy*dt;
        if(p.y - p.r > H+20) Object.assign(p, makeParticle(true));
        const driftX = Math.sin(time*p.driftFreq + p.phase)*p.driftAmp;
        const twinkle = 0.55 + 0.45*Math.sin(time*p.twinkleFreq + p.twinklePhase);
        const alpha = p.baseAlpha*twinkle;
        const px = p.x + driftX + parX*p.depth;
        const py = p.y + parY*p.depth;

        ctx!.beginPath();
        ctx!.fillStyle = p.pink ? `rgba(255,0,127,${alpha})` : `rgba(17,17,19,${alpha})`;
        ctx!.arc(px,py,p.r,0,Math.PI*2);
        ctx!.fill();
        if(p.glow){
          ctx!.beginPath();
          ctx!.fillStyle = p.pink ? `rgba(255,0,127,${alpha*.14})` : `rgba(17,17,19,${alpha*.08})`;
          ctx!.arc(px,py,p.r*3.8,0,Math.PI*2);
          ctx!.fill();
        }
      }

      if(t >= nextShootingStarAt && shootingStars.length === 0){
        createShootingStar();
        scheduleShootingStar(t);
      }
      shootingStars = shootingStars.filter(s => s.life < s.maxLife);
      for(const s of shootingStars){
        s.life += dt;
        const progress = Math.min(s.life/s.maxLife,1);
        const reveal = 1-Math.pow(1-Math.min(progress/.28,1),3);
        const fade = progress < .18 ? progress/.18 : Math.max(0,1-(progress-.18)/.82);
        const liveLength = s.len*(.28 + reveal*.72);
        const x2 = s.x + Math.cos(s.angle)*s.speed*s.life;
        const y2 = s.y + Math.sin(s.angle)*s.speed*s.life;
        const x1 = x2 - Math.cos(s.angle)*liveLength;
        const y1 = y2 - Math.sin(s.angle)*liveLength;
        const grad = ctx!.createLinearGradient(x1,y1,x2,y2);
        const rgb = s.pink ? '255,0,127' : '42,42,48';
        grad.addColorStop(0,`rgba(${rgb},0)`);
        grad.addColorStop(.48,`rgba(${rgb},${s.alpha*.12*fade})`);
        grad.addColorStop(.9,`rgba(${rgb},${s.alpha*.78*fade})`);
        grad.addColorStop(1,`rgba(${rgb},${s.alpha*fade})`);
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = s.width;
        ctx!.lineCap = 'round';
        ctx!.shadowColor = s.pink ? `rgba(255,0,127,${.48*fade})` : `rgba(42,42,48,${.2*fade})`;
        ctx!.shadowBlur = 9;
        ctx!.beginPath();
        ctx!.moveTo(x1,y1);
        ctx!.lineTo(x2,y2);
        ctx!.stroke();
        ctx!.beginPath();
        ctx!.fillStyle = `rgba(${rgb},${fade})`;
        ctx!.arc(x2,y2,s.width*1.3,0,Math.PI*2);
        ctx!.fill();
        ctx!.shadowBlur = 0;
      }

      rafId = requestAnimationFrame(frame);
    }

    if(!isTouch){
      hero.addEventListener('mousemove', (e: MouseEvent)=>{
        const rect = hero!.getBoundingClientRect();
        targetX = (e.clientX-rect.left)/rect.width;
        targetY = (e.clientY-rect.top)/rect.height;
      });
    }

    function stop(){
      running = false;
      cancelAnimationFrame(rafId);
    }

    function start(){
      if(reduceMotion || document.hidden || !heroVisible || running) return;
      running = true;
      lastT = performance.now();
      rafId = requestAnimationFrame(frame);
    }

    document.addEventListener('visibilitychange',()=> document.hidden ? stop() : start());

    const visibilityObserver = new IntersectionObserver(([entry])=>{
      heroVisible = entry.isIntersecting;
      heroVisible ? start() : stop();
    },{rootMargin:'80px'});
    visibilityObserver.observe(hero);

    window.addEventListener('resize', resize);
    resize();

    start();
  })();

  // scroll reveal
  const items = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); } });
  },{threshold:0.15});
  items.forEach(i=>io.observe(i));

  // cursor glow (desktop only)
  const glow = document.getElementById('cursorGlow');
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  if(!isTouch && glow){
    window.addEventListener('mousemove', (e)=>{
      glow.classList.add('active');
      (glow as HTMLElement).style.left = e.clientX + 'px';
      (glow as HTMLElement).style.top = e.clientY + 'px';
    });
    window.addEventListener('mouseleave', ()=> glow.classList.remove('active'));
  }

  // magnetic buttons (desktop only)
  if(!isTouch){
    document.querySelectorAll<HTMLElement>('.btn-primary, .btn-ghost').forEach(btn=>{
      btn.addEventListener('mousemove', (e: MouseEvent)=>{
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left - r.width/2;
        const y = e.clientY - r.top - r.height/2;
        btn.style.transform = `translate(${x*0.18}px, ${y*0.35}px)`;
      });
      btn.addEventListener('mouseleave', ()=>{ btn.style.transform = 'translate(0,0)'; });
    });
  }

  // fleet teaser (catalogue preview carousel) — véhicules déjà rendus au
  // build ; ce script ne gère plus que le défilement horizontal.
  (function(){
    const track = document.getElementById('fleetTrack');
    const prevBtn = document.getElementById('fleetPrev') as HTMLButtonElement;
    const nextBtn = document.getElementById('fleetNext') as HTMLButtonElement;
    const indexEl = document.getElementById('fleetIndex')!;
    if(!track || !track.querySelector('.fleet-card')) return;

    function cardStep(){
      const card = track!.querySelector('.fleet-card');
      if(!card) return 300;
      const gap = parseFloat(getComputedStyle(track!).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function updateNav(){
      const step = cardStep();
      const i = Math.round(track!.scrollLeft / step);
      indexEl.textContent = String(i + 1).padStart(2,'0');
      prevBtn.disabled = track!.scrollLeft <= 4;
      nextBtn.disabled = track!.scrollLeft >= track!.scrollWidth - track!.clientWidth - 4;
    }

    prevBtn.addEventListener('click', ()=> track!.scrollBy({left: -cardStep(), behavior:'smooth'}));
    nextBtn.addEventListener('click', ()=> track!.scrollBy({left: cardStep(), behavior:'smooth'}));
    let scrollTimer: ReturnType<typeof setTimeout>;
    track.addEventListener('scroll', ()=>{
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(updateNav, 80);
    }, {passive:true});

    updateNav();
  })();

  // customer reviews carousel — buttons, keyboard and touch scrolling stay in sync
  (function(){
    const viewport = document.querySelector<HTMLElement>('[data-reviews-viewport]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-review-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-review-next]');
    if(!viewport || !prevBtn || !nextBtn) return;

    function cardStep(){
      const card = viewport!.querySelector<HTMLElement>('.review-card');
      const track = viewport!.querySelector<HTMLElement>('.reviews-track');
      if(!card || !track) return viewport!.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function updateReviewNav(){
      const maxScroll = viewport!.scrollWidth - viewport!.clientWidth;
      prevBtn!.disabled = viewport!.scrollLeft <= 3;
      nextBtn!.disabled = viewport!.scrollLeft >= maxScroll - 3;
    }

    function moveReviews(direction: number){
      viewport!.scrollBy({left: direction * cardStep(), behavior:'smooth'});
    }

    prevBtn.addEventListener('click', () => moveReviews(-1));
    nextBtn.addEventListener('click', () => moveReviews(1));
    viewport.addEventListener('keydown', (event: KeyboardEvent) => {
      if(event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      moveReviews(event.key === 'ArrowLeft' ? -1 : 1);
    });

    let reviewScrollTimer: ReturnType<typeof setTimeout>;
    viewport.addEventListener('scroll', () => {
      clearTimeout(reviewScrollTimer);
      reviewScrollTimer = setTimeout(updateReviewNav, 70);
    }, {passive:true});
    window.addEventListener('resize', updateReviewNav);
    updateReviewNav();
  })();

  // accept diagram — connector lines drawn to match the actual rendered card positions
  (function(){
    const diagram = document.getElementById('acceptDiagram');
    const fileCard = document.getElementById('acceptFile');
    const svg = document.getElementById('acceptLines');
    if(!diagram || !fileCard || !svg) return;

    function getPartners(){
      return Array.from(document.querySelectorAll<HTMLElement>('#acceptPartners [data-accept-node]'))
        .filter(node => node.offsetParent !== null);
    }

    function setDot(name: string, x: number, y: number){
      svg!.querySelectorAll(`[data-dot="${name}"]`).forEach(dot=>{
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', String(y));
      });
    }

    function setPath(selector: string, d: string){
      svg!.querySelectorAll(selector).forEach(path=> path.setAttribute('d', d));
    }

    function draw(){
      const partners = getPartners();
      if(!partners.length) return;
      const box = diagram!.getBoundingClientRect();
      const fileRect = fileCard!.getBoundingClientRect();
      const startX = fileRect.left + fileRect.width / 2 - box.left;
      const startY = fileRect.bottom - box.top;

      const points = partners.map(node=>{
        const r = node.getBoundingClientRect();
        return { x: r.left + r.width / 2 - box.left, y: r.top - box.top };
      });
      const cardTopY = points[0].y;
      const busY = startY + (cardTopY - startY) * 0.42;
      setDot('hub', startX, busY);
      setPath('[data-part="trunk"]', `M${startX},${startY} L${startX},${busY}`);

      if(window.innerWidth > 900){
        const leftX = points[0].x;
        const rightX = points[points.length - 1].x;
        const splitX = (points[2].x + points[3].x) / 2;
        setPath('[data-part="bus-pink"]', `M${leftX},${busY} L${splitX},${busY}`);
        setPath('[data-part="bus-green"]', `M${splitX},${busY} L${rightX},${busY}`);
        points.forEach((p, i)=>{
          setPath(`[data-to="${i}"]`, `M${p.x},${busY} L${p.x},${p.y}`);
          setDot(`end-${i}`, p.x, p.y);
        });
      } else if(window.innerWidth > 760){
        const col0X = points[0].x;
        const col1X = points[1].x;
        setPath('[data-part="bus-2col"]', `M${col0X},${busY} L${col1X},${busY}`);
        setPath('[data-to2="0"]', `M${col0X},${busY} L${col0X},${points[0].y}`);
        setPath('[data-to2="1"]', `M${col1X},${busY} L${col1X},${points[1].y}`);
        setDot('end2-0', col0X, points[0].y);
        setDot('end2-1', col1X, points[1].y);
      } else {
        const midY = fileRect.top + fileRect.height / 2 - box.top;
        const cardLeftX = fileRect.left - box.left;
        const cardRightX = fileRect.right - box.left;
        const left = points[0];
        const mid = points[1];
        const right = points[points.length - 1];
        setDot('hub', startX, startY);
        setPath('[data-part="trunk"]', `M${startX},${startY} L${mid.x},${mid.y}`);
        setDot('hubm-left', cardLeftX, midY);
        setDot('hubm-right', cardRightX, midY);
        setPath('[data-tom="0"]', `M${cardLeftX},${midY} L${left.x},${midY} L${left.x},${left.y}`);
        setPath('[data-tom="2"]', `M${cardRightX},${midY} L${right.x},${midY} L${right.x},${right.y}`);
        setDot('endm-0', left.x, left.y);
        setDot('endm-1', mid.x, mid.y);
        setDot('endm-2', right.x, right.y);
      }
    }

    draw();
    if(document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
    window.addEventListener('load', draw);
    let acceptResizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', ()=>{
      clearTimeout(acceptResizeTimer);
      acceptResizeTimer = setTimeout(draw, 100);
    });
  })();

  // faq accordion
  const faqEasing = 'cubic-bezier(.16,1,.3,1)';
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(item=>{
    const summary = item.querySelector('summary')!;
    const content = item.querySelector<HTMLElement>('.faq-content')!;
    summary.addEventListener('click', (e)=>{
      e.preventDefault();
      if(item.classList.contains('is-animating')) return;
      item.open ? closeFaq(item, content) : openFaq(item, content);
    });
  });

  function openFaq(item: HTMLDetailsElement, content: HTMLElement){
    item.classList.add('is-animating');
    item.open = true;
    const target = content.scrollHeight;
    content.style.overflow = 'hidden';
    const anim = content.animate(
      [{ height:'0px', opacity:0 }, { height: target+'px', opacity:1 }],
      { duration:320, easing:faqEasing }
    );
    anim.onfinish = ()=>{
      content.style.overflow = '';
      content.style.height = '';
      item.classList.remove('is-animating');
    };
  }

  function closeFaq(item: HTMLDetailsElement, content: HTMLElement){
    item.classList.add('is-animating');
    const start = content.scrollHeight;
    content.style.overflow = 'hidden';
    const anim = content.animate(
      [{ height:start+'px', opacity:1 }, { height:'0px', opacity:0 }],
      { duration:280, easing:faqEasing }
    );
    anim.onfinish = ()=>{
      item.open = false;
      content.style.overflow = '';
      content.style.height = '';
      item.classList.remove('is-animating');
    };
  }
</script>

<script define:vars={{ fleetCarIcon }}>
  window.__fleetCarIcon = fleetCarIcon;
</script>
