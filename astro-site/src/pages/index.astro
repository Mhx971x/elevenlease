---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchVehicles, type Vehicle } from '../lib/vehicles';

let fleetVehicles: Vehicle[] = [];
try {
  fleetVehicles = await fetchVehicles();
} catch (e) {
  console.error('Erreur de chargement du catalogue (accueil) au build :', e);
}

const heroBrands = [
  { name: 'Mercedes-Benz', src: '/brands/mercedesbenz.svg' },
  { name: 'BMW', src: '/brands/bmw.svg' },
  { name: 'Audi', src: '/brands/audi.svg' },
  { name: 'Volkswagen', src: '/brands/volkswagen.svg' },
  { name: 'Peugeot', src: '/brands/peugeot.svg' },
  { name: 'Renault', src: '/brands/renault.svg' },
  { name: 'CUPRA', src: '/brands/cupra.svg', className: 'brand-logo-cupra', width: 32 },
  { name: 'Toyota', src: '/brands/toyota.svg' },
  { name: 'Škoda', src: '/brands/skoda.svg' },
  { name: 'Tesla', src: '/brands/tesla.svg' },
  { name: 'Citroën', src: '/brands/citroen.svg' },
  { name: 'Hyundai', src: '/brands/hyundai.svg' },
  { name: 'Kia', src: '/brands/kia.svg' },
  { name: 'Volvo', src: '/brands/volvo.svg' },
  { name: 'Ford', src: '/brands/ford.svg' }
];

const heroCarouselVehicles = [
  { src: '/hero-premium-coupe-shadow-v3.webp', model: 'BMW Série 4', price: '399 €/mois' },
  { src: '/hero-cupra-formentor-shadow-v2.webp', model: 'CUPRA Formentor', price: '359 €/mois' },
  { src: '/hero-clio-alpine-black-shadow-v3.webp', model: 'Renault Clio 5 Alpine', price: '289 €/mois' },
  { src: '/hero-tesla-model-3-shadow-v2.webp', model: 'Tesla Model 3', price: '429 €/mois' }
];

const fleetCarIcon = `<svg viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M20 68 L32 40 Q38 30 52 30 L140 30 Q154 30 160 40 L172 68 L172 80 Q172 84 168 84 L158 84 Q158 92 150 92 Q142 92 142 84 L58 84 Q58 92 50 92 Q42 92 42 84 L32 84 Q28 84 28 80 Z" stroke="#111113" stroke-width="2.5" fill="rgba(17,17,19,0.03)"/>
  <path d="M46 40 L54 40 L50 30" stroke="#111113" stroke-width="2.2" fill="none" stroke-linejoin="round"/>
  <line x1="52" y1="30" x2="52" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <line x1="86" y1="30" x2="86" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <line x1="120" y1="30" x2="120" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <circle cx="58" cy="84" r="10" stroke="#111113" stroke-width="2.5" fill="#f6f6f7"/>
  <circle cx="142" cy="84" r="10" stroke="#111113" stroke-width="2.5" fill="#f6f6f7"/>
  <circle cx="58" cy="84" r="3" fill="#111113"/>
  <circle cx="142" cy="84" r="3" fill="#111113"/>
</svg>`;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Eleven Lease",
  "url": "https://elevenlease.fr/",
  "logo": "https://elevenlease.fr/eleven-lease-logo.png",
  "email": "contact@elevenlease.fr",
  "telephone": "+33638014986",
  "foundingDate": "2023",
  "description": "Eleven Lease connecte particuliers et professionnels à un réseau de partenaires financiers pour trouver, toutes marques confondues, le leasing automobile adapté à leur budget, partout en France.",
  "founder": {
    "@type": "Person",
    "name": "Mehdi Djaffar",
    "jobTitle": "Fondateur",
    "sameAs": ["https://www.linkedin.com/in/mehdielevenlease/"]
  },
  "sameAs": [
    "https://www.instagram.com/elevenlease",
    "https://www.tiktok.com/@elevenlease",
    "https://www.linkedin.com/company/elevenlease/"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Eleven Lease",
  "url": "https://elevenlease.fr/"
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Comment obtenir un leasing avec Eleven Lease",
  "description": "Les quatre étapes du parcours Eleven Lease, de la description du projet à la livraison du véhicule.",
  "step": [
    { "@type": "HowToStep", "position": 1, "name": "Décrivez votre projet", "text": "Véhicule, budget et besoins : quelques informations suffisent." },
    { "@type": "HowToStep", "position": 2, "name": "Nous étudions votre dossier", "text": "Votre situation est analysée pour identifier les solutions adaptées." },
    { "@type": "HowToStep", "position": 3, "name": "Recevez votre offre", "text": "Un conseiller vous présente une proposition claire et personnalisée." },
    { "@type": "HowToStep", "position": 4, "name": "Validez et prenez la route", "text": "Contrat, démarches et livraison : votre expert s'occupe du reste." }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Comment fonctionne Eleven Lease ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Vous décrivez votre projet en un seul formulaire, puis notre réseau de partenaires financiers identifie les offres de leasing (LOA/LLD) adaptées à votre budget et à votre profil. Un conseiller vous met ensuite en relation directement avec l'offre retenue." }
    },
    {
      "@type": "Question",
      "name": "Eleven Lease est-il un organisme de financement ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Non. Eleven Lease n'est pas un établissement de crédit et ne finance aucun véhicule directement : nous mettons en relation votre projet avec un réseau de partenaires financiers qui étudient et financent le dossier." }
    },
    {
      "@type": "Question",
      "name": "Combien coûte le service Eleven Lease pour le client ?",
      "acceptedAnswer": { "@type": "Answer", "text": "La mise en relation est gratuite pour le client : aucun frais n'est facturé par Eleven Lease pour l'utilisation du service." }
    },
    {
      "@type": "Question",
      "name": "Sous quel délai suis-je recontacté après ma demande ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Le délai moyen de mise en relation est de 24h après l'envoi de votre demande." }
    },
    {
      "@type": "Question",
      "name": "Y a-t-il une limite de kilométrage avec Eleven Lease ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Non. Notre offre de leasing est proposée avec un kilométrage illimité, aussi bien pour les particuliers que pour les professionnels : aucun forfait à respecter, aucune facturation de dépassement en fin de contrat." }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://elevenlease.fr/" }
  ]
};
---
<BaseLayout
  title="Eleven Lease — Le leasing qui s'adapte à votre budget"
  description="Leasing auto sur-mesure, toutes marques : décrivez votre budget, notre réseau de partenaires vous trouve l'offre adaptée sous 24h. Kilométrage illimité inclus."
  path="/"
  showProgressBar
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="grain"></div>
  <div class="cursor-glow" id="cursorGlow"></div>

  <section class="hero">
    <div class="hero-grid"></div>
    <canvas class="hero-stars" id="heroStars"></canvas>
    <div class="hero-waves" aria-hidden="true">
      <svg viewBox="0 0 1440 780" preserveAspectRatio="none">
        <defs>
          <radialGradient id="studioAura" cx="50%" cy="54%" r="50%">
            <stop offset="0" stop-color="#ff007f" stop-opacity=".27" />
            <stop offset=".32" stop-color="#ff1689" stop-opacity=".12" />
            <stop offset=".68" stop-color="#ff79b8" stop-opacity=".038" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="studioSideGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#ff007f" stop-opacity=".12" />
            <stop offset=".5" stop-color="#ff5cab" stop-opacity=".045" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="studioRing" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0" />
            <stop offset=".22" stop-color="#ff007f" stop-opacity=".025" />
            <stop offset=".5" stop-color="#ff007f" stop-opacity=".19" />
            <stop offset=".78" stop-color="#ff007f" stop-opacity=".025" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="studioFloor" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0" />
            <stop offset=".5" stop-color="#ececf0" stop-opacity=".34" />
            <stop offset="1" stop-color="#d8d8de" stop-opacity=".12" />
          </linearGradient>
          <linearGradient id="studioBeam" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff007f" stop-opacity=".055" />
            <stop offset=".52" stop-color="#ff8bc2" stop-opacity=".016" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </linearGradient>
          <radialGradient id="dotFade" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#ffffff" stop-opacity=".88" />
            <stop offset=".58" stop-color="#ffffff" stop-opacity=".42" />
            <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>
          <pattern id="studioDots" width="36" height="36" patternUnits="userSpaceOnUse">
            <circle cx="4" cy="4" r="1" fill="#ff007f" fill-opacity=".18" />
            <circle cx="22" cy="21" r=".75" fill="#17171c" fill-opacity=".10" />
          </pattern>
          <mask id="studioDotMask">
            <rect x="80" y="60" width="1280" height="600" fill="url(#dotFade)" />
          </mask>
          <filter id="auraGlow" x="-30%" y="-40%" width="160%" height="180%">
            <feGaussianBlur stdDeviation="22" />
          </filter>
        </defs>

        <g opacity=".82">
          <path d="M-80 116 L214 54 L440 668 L148 734 Z" fill="url(#studioBeam)" />
          <path d="M1520 116 L1226 54 L1000 668 L1292 734 Z" fill="url(#studioBeam)" />
        </g>

        <ellipse cx="190" cy="478" rx="250" ry="220" fill="url(#studioSideGlow)" filter="url(#auraGlow)" />
        <ellipse cx="1250" cy="478" rx="250" ry="220" fill="url(#studioSideGlow)" filter="url(#auraGlow)" />
        <ellipse cx="720" cy="494" rx="530" ry="236" fill="url(#studioAura)" filter="url(#auraGlow)" />

        <rect x="80" y="60" width="1280" height="600" fill="url(#studioDots)" mask="url(#studioDotMask)" opacity=".6" />

        <g fill="none" stroke="url(#studioRing)">
          <ellipse cx="720" cy="490" rx="330" ry="148" stroke-width="1.7" opacity=".92" />
          <ellipse cx="720" cy="490" rx="420" ry="184" stroke-width="1.4" />
          <ellipse cx="720" cy="490" rx="520" ry="224" stroke-width="1.1" opacity=".72" />
          <ellipse cx="720" cy="490" rx="628" ry="266" stroke-width=".9" opacity=".46" />
          <ellipse cx="720" cy="490" rx="724" ry="302" stroke-width=".8" opacity=".28" />
        </g>

        <rect x="0" y="560" width="1440" height="220" fill="url(#studioFloor)" />
        <g fill="none" stroke-linecap="round">
          <path d="M172 612 Q720 558 1268 612" stroke="#111119" stroke-opacity=".055" stroke-width="1" />
          <path d="M292 632 Q720 590 1148 632" stroke="#ff007f" stroke-opacity=".085" stroke-width="1" />
        </g>
      </svg>
    </div>
    <div class="wrap hero-content">
      <div class="hero-copy">
        <div class="eyebrow"><span class="dot"></span> Leasing sur-mesure, toutes marques — partout en France</div>
        <h1>
          <span class="hero-title-desktop">Le leasing qui s'adapte<br>à <em>votre budget.</em></span>
          <span class="hero-title-mobile">Le leasing qui s'adapte<br>à <em>votre budget.</em></span>
        </h1>
        <p>
          <span class="hero-copy-desktop">On ne vous impose pas une voiture.<br>On trouve celle qui correspond à votre budget.</span>
          <span class="hero-copy-mobile">On ne vous impose pas une voiture.<br>On trouve celle qui correspond à votre budget.</span>
        </p>
        <div class="hero-social-row">
          <div class="trustpilot-proof" aria-label="Trustpilot : 4,8 sur 5 basé sur plus de 200 avis">
            <span class="trustpilot-brand"><span class="trustpilot-mark" aria-hidden="true">★</span>Trustpilot</span>
            <span class="trustpilot-stars" aria-hidden="true">
              <span>★</span><span>★</span><span>★</span><span>★</span><span class="is-partial">★</span>
            </span>
            <span class="trustpilot-score"><strong>4,8/5</strong><span class="trustpilot-score-detail"> basé sur + de 200 avis</span></span>
          </div>
        </div>
        <div class="hero-actions">
          <a href="/simulation" class="btn-primary cta-with-calculator"><span class="cta-calculator-icon" aria-hidden="true"></span>Simuler mon leasing</a>
          <a href="/vehicules" class="btn-secondary-link">Voir les véhicules <span aria-hidden="true">→</span></a>
        </div>

        <div class="hero-proof-row" aria-label="Les avantages Eleven Lease">
          <div class="hero-proof">
            <strong>Illimité</strong>
            <span>Kilométrage</span>
          </div>
          <div class="hero-proof">
            <strong>24h</strong>
            <span>Réponse moyenne</span>
          </div>
          <div class="hero-proof">
            <strong>0 €</strong>
            <span>Frais client</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-speed-lines" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="hero-visual-ring" aria-hidden="true"></div>
        <div class="hero-visual-label" aria-hidden="true">
          <span>La liberté de rouler</span>
          <strong>sans compter.</strong>
        </div>
        <div class="hero-car-carousel" data-vehicle-carousel data-hero-car-carousel>
          {heroCarouselVehicles.map((vehicle, index) => (
            <img
              class={`hero-car${index === 0 ? ' is-active is-initial' : ''}`}
              src={vehicle.src}
              alt={`${vehicle.model} disponible en leasing chez Eleven Lease`}
              width="1536"
              height="1024"
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding={index === 0 ? undefined : 'async'}
              data-carousel-car
              data-model={vehicle.model}
              data-price={vehicle.price}
            >
          ))}
        </div>
        <div class="hero-car-card is-changing" data-hero-car-card aria-live="polite">
          <strong class="hero-car-card-model">BMW Série 4</strong>
          <span class="hero-car-card-price">À partir de <b>399 €/mois</b></span>
        </div>
        <picture class="hero-mobile-car">
          <source media="(min-width: 981px)" srcset="/hero-premium-coupe-v2.webp" width="1536" height="1024">
          <img src="/hero-sport-compact.webp" alt="Véhicule disponible en leasing chez Eleven Lease" width="1774" height="887" fetchpriority="high">
        </picture>
      </div>
    </div>

    <div class="wrap hero-project" aria-label="Les points forts de votre projet Eleven Lease">
      <div class="project-item">
        <span class="project-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M9.828 9.172a4 4 0 1 0 0 5.656a10 10 0 0 0 2.172 -2.828a10 10 0 0 1 2.172 -2.828a4 4 0 1 1 0 5.656a10 10 0 0 1 -2.172 -2.828a10 10 0 0 0 -2.172 -2.828" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="project-text"><strong>Km illimité</strong></span>
      </div>
      <div class="project-item">
        <span class="project-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M17.2 7a6 7 0 1 0 0 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 10h9M4 14h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 4l16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </span>
        <span class="project-text"><strong><span class="proof-full">0€ de frais client</span><span class="proof-compact">0€ de frais</span></strong></span>
      </div>
      <div class="project-item">
        <span class="project-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 011 1v14H4V6a1 1 0 011-1zM8 13h3m2 0h3m-8 3h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="project-text"><strong><span class="proof-full">Réponse sous 24h</span><span class="proof-compact">Réponse 24h</span></strong></span>
      </div>
      <div class="project-actions">
        <a href="/vehicules" class="project-stock-cta">Voir les véhicules <span aria-hidden="true">→</span></a>
        <a href="/simulation" class="project-cta cta-with-calculator"><span class="cta-calculator-icon" aria-hidden="true"></span>Simuler mon leasing <span class="project-cta-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>

  <div class="wrap hero-brands" aria-label="Les marques automobiles les plus demandées">
    <span class="brands-label">Financement multimarque</span>
    <div class="brands-viewport">
      <div class="brands-track">
        {[0, 1, 2].map((setIndex) => (
          <div class="brands-set" aria-hidden={setIndex === 0 ? undefined : 'true'}>
            {heroBrands.map((brand) => (
              <span class={brand.className ? `brand-logo ${brand.className}` : 'brand-logo'}>
                <img src={brand.src} alt={setIndex === 0 ? brand.name : ''} width={brand.width ?? 24} height="24">
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
  </section>

  <section class="connection-strip" aria-label="Le rôle d'Eleven Lease">
    <div class="wrap">
      <div class="connect-diagram">
        <div class="node"><div class="label">Vous</div><div class="value">Votre projet auto</div></div>
        <div class="connect-line"></div>
        <div class="node"><div class="label">Eleven Lease</div><div class="value">Mise en relation</div></div>
        <div class="connect-line"></div>
        <div class="node"><div class="label">Partenaire</div><div class="value">Meilleure offre</div></div>
      </div>
    </div>
  </section>

  <section id="pourquoi" class="why-section">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="section-eyebrow">Pourquoi Eleven Lease</div>
        <h2>Une offre pensée pour ceux qui roulent vraiment.</h2>
      </div>
      <div class="why-grid reveal reveal-stagger">
        <div class="why-card">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M6.5 8a4 4 0 100 8 4 4 0 003.2-1.6L12 12l2.3 2.4A4 4 0 1017.5 8a4 4 0 00-3.2 1.6L12 12l-2.3-2.4A4 4 0 006.5 8z" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>Kilométrage illimité</h3>
          <p>Aucun forfait à surveiller, aucune facture de dépassement en fin de contrat. Roulez selon votre besoin réel, pas selon une case cochée à la signature.</p>
        </div>
        <div class="why-card">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 12h4l2-7 4 14 2-7h6" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>Taillé pour les gros rouleurs</h3>
          <p>Trajets quotidiens, tournées professionnelles, longue distance : notre offre est conçue pour un usage intensif du véhicule.</p>
        </div>
        <div class="why-card">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="var(--text)" stroke-width="1.6"/><path d="M21 21l-4.3-4.3" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round"/></svg>
          <h3>Le véhicule adapté à votre besoin</h3>
          <p>Nous cherchons le modèle qui correspond réellement à votre usage, pas seulement ce qu'il y a en stock.</p>
        </div>
        <div class="why-card">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V4H6.5A2.5 2.5 0 004 6.5v13z" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>Véhicules récents</h3>
          <p>Un catalogue renouvelé régulièrement, en neuf comme en occasion récente, pour particuliers et professionnels.</p>
        </div>
        <div class="why-card">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M3 13l1.5-5A2 2 0 016.4 6.5h11.2a2 2 0 011.9 1.5L21 13M3 13v5a1 1 0 001 1h1a1 1 0 001-1v-1h12v1a1 1 0 001 1h1a1 1 0 001-1v-5M3 13h18" stroke="var(--text)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>Accompagnement de A à Z</h3>
          <p>Financement, négociation, livraison : on gère tout le parcours, vous récupérez les clés.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="catalogue" class="fleet-teaser">
    <div class="wrap">
      <div class="fleet-head reveal">
        <div>
          <div class="section-eyebrow">Le catalogue</div>
          <h2>Nos offres. <span>À saisir maintenant.</span></h2>
        </div>
        <div class="fleet-nav">
          <button class="fleet-arrow" id="fleetPrev" aria-label="Véhicule précédent" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
