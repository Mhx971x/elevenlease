          <h3>Votre projet<br><span class="process-cta-accent">commence ici.</span></h3>
          <p>Décrivez votre besoin en quelques minutes. Un conseiller revient vers vous avec une solution adaptée.</p>
          <a href="/simulation" class="btn-primary cta-with-calculator process-cta-btn"><span class="cta-calculator-icon" aria-hidden="true"></span>Simuler mon leasing <span aria-hidden="true">→</span></a>
          <div class="process-cta-proof">
            <span>Gratuit</span>
            <span>Sans engagement</span>
            <span>Réponse sous 24h</span>
          </div>
        </div>
        <div class="process-car-carousel" data-vehicle-carousel data-process-car-carousel aria-hidden="true">
          {heroCarouselVehicles.map((vehicle, index) => (
            <img
              class={`process-car${index === 0 ? ' is-active' : ''}`}
              src={vehicle.src}
              alt=""
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
              data-carousel-car
            >
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

