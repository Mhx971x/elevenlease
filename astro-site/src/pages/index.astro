  @keyframes heroCarDriveIn{
    0%{
      opacity:0;
      transform:translate3d(calc(var(--car-rest-x) + 24%),5px,0) scale(.92);
    }
    58%{
      opacity:1;
    }
    100%{opacity:1;transform:translate3d(var(--car-rest-x),0,0) scale(1);}
  }
  @keyframes heroSpeedLine{
    0%{opacity:0;transform:translateX(210px) scaleX(.2);}
    24%{opacity:.9;}
    68%{opacity:.55;transform:translateX(0) scaleX(1);}
    100%{opacity:0;transform:translateX(-90px) scaleX(.62);}
  }
  @keyframes heroRingReveal{
    0%{opacity:0;transform:scale(.76);filter:blur(10px);}
    70%{opacity:1;transform:scale(1.025);filter:blur(0);}
    100%{opacity:1;transform:scale(1);filter:none;}
