---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LEGAL, ORGANIZATION_SCHEMA } from '../config/legal';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "À propos d'Eleven Lease",
  "url": "https://elevenlease.fr/a-propos",
  "mainEntity": { ...ORGANIZATION_SCHEMA, "@context": undefined }
};

const checkIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const reasons = [
  'Une demande en ligne et un pré-check commercial initial gratuits et sans engagement.',
  'Une première réponse sous 24 à 48 h ouvrées après votre demande.',
  'Une mise en relation avec des partenaires du secteur automobile.',
  'Un pré-check commercial avant toute étude définitive du partenaire.',
];
---
<BaseLayout
  title="À propos | ELEVEN LEASE, accompagnement automobile"
  description="Découvrez ELEVEN LEASE : qualification des besoins, pré-check commercial, mise en relation et apport d'affaires dans le secteur automobile."
  path="/a-propos"
  ctaHref="/simulation"
  active="about"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  </Fragment>

  <section class="about-hero">
    <div class="wrap">
      <div class="eyebrow"><span class="dot"></span> Qui sommes-nous</div>
      <h1>Un accompagnement humain,<br><em>pas un algorithme.</em></h1>
      <p>{LEGAL.tradeName} accompagne les projets automobiles : qualification du besoin, pré-check commercial, mise en relation et apport d'affaires. L'étude définitive et toute décision de financement appartiennent au partenaire sollicité.</p>
    </div>
  </section>

  <section class="about-founder">
    <div class="wrap">
      <div class="founder-card">
        <div class="founder-avatar" aria-hidden="true">MD</div>
        <div class="founder-info">
          <div class="founder-name">{LEGAL.operatorName}</div>
          <div class="founder-role">Fondateur d'Eleven Lease</div>
          <p class="founder-bio">Il a fondé Eleven Lease pour qualifier chaque projet automobile et organiser la mise en relation avec un partenaire susceptible de l'étudier.</p>
        </div>
        <a class="founder-linkedin" href="https://www.linkedin.com/in/mehdielevenlease/" target="_blank" rel="noopener" aria-label={`Profil LinkedIn de ${LEGAL.operatorName}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 5a2 2 0 11-4-.002 2 2 0 014 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-3.96 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.68-2.91V8.48z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <section class="about-stats">
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-value">2023</div>
          <div class="stat-label">Année de création</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">1000+</div>
          <div class="stat-label">Clients accompagnés</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">Une dizaine</div>
          <div class="stat-label">Partenaires automobiles</div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-body">
    <div class="wrap">
      <div class="about-block">
        <h2>Qualifier le projet avant la mise en relation.</h2>
        <p>Notre rôle consiste à comprendre le véhicule recherché, l'usage, le budget et les contraintes du client afin de présenter un besoin commercial clair. Ce pré-check ne remplace pas l'étude définitive du partenaire et ne préjuge jamais de sa décision.</p>
      </div>

      <div class="about-block">
        <h2>Un réseau, pas un guichet unique.</h2>
        <p>Nous travaillons avec des partenaires du secteur automobile susceptibles de répondre au projet. Avec l'accord du client, les informations utiles sont transmises au partenaire sollicité, qui applique ses propres critères, réalise l'étude définitive et décide seul.</p>
      </div>

      <div class="about-block">
        <h2>Pourquoi passer par Eleven Lease.</h2>
        <div class="reasons-list">
          {reasons.map(r => <div class="reason-item"><Fragment set:html={checkIcon} /> {r}</div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="wrap">
      <h2>Un projet de leasing en tête ?</h2>
      <p>Décrivez-le en quelques minutes, notre équipe s'occupe du reste.</p>
      <div class="about-cta-actions">
        <a href="/simulation" class="btn-primary cta-with-calculator"><span class="cta-calculator-icon" aria-hidden="true"></span>Simuler mon leasing</a>
        <a href="/contact" class="btn-outline">Nous écrire</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* hero */
  .about-hero{padding:150px 0 56px;border-bottom:1px solid var(--border);}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--text-dim);border:1px solid var(--border);padding:6px 14px;border-radius:var(--radius-pill);margin-bottom:24px;width:fit-content;}
  .eyebrow .dot{width:6px;height:6px;border-radius:var(--radius-round);background:var(--accent-1);}
  .about-hero h1{font-size:clamp(30px,5vw,48px);max-width:640px;}
  .about-hero em{font-style:normal;background:var(--accent);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .about-hero p{color:var(--text-dim);font-size:15.5px;max-width:560px;margin-top:18px;line-height:1.6;}

  /* founder */
  .about-founder{padding:8px 0 48px;}
  .founder-card{
    display:flex;align-items:center;gap:22px;flex-wrap:wrap;
    border:1px solid var(--border);border-radius:var(--radius-xl);padding:26px 30px;background:#fff;box-shadow:var(--shadow-sm);
  }
  .founder-avatar{
    flex:none;width:56px;height:56px;border-radius:var(--radius-round);display:grid;place-items:center;
    background:var(--accent);color:#fff;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:16px;
  }
  .founder-info{flex:1;min-width:200px;}
  .founder-name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:17px;}
  .founder-role{color:var(--accent-1);font-size:13px;font-weight:600;margin-top:2px;}
  .founder-bio{color:var(--text-dim);font-size:14px;line-height:1.6;margin-top:8px;max-width:520px;}
  .founder-linkedin{
    flex:none;display:inline-flex;align-items:center;gap:8px;
    border:1px solid var(--border);border-radius:var(--radius-pill);padding:11px 18px;
    color:var(--text-dim);font-size:13.5px;font-weight:600;
    transition:border-color .2s ease,color .2s ease,transform .2s ease;
  }
  .founder-linkedin:hover{border-color:#0a66c2;color:#0a66c2;transform:translateY(-2px);}
  @media(max-width:640px){ .founder-card{padding:22px;} }

  /* stats */
  .about-stats{padding:48px 0;border-bottom:1px solid var(--border);}
  .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden;}
  .stat-item{background:var(--bg);padding:32px 24px;text-align:center;}
  .stat-value{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(22px,3.4vw,32px);letter-spacing:-0.02em;}
  .stat-label{color:var(--text-dim);font-size:13.5px;margin-top:8px;}
  @media(max-width:640px){ .stats-grid{grid-template-columns:1fr;} }

  /* body blocks */
  .about-body{padding:54px 0;}
  .about-block{max-width:720px;margin-bottom:56px;}
  .about-block:last-child{margin-bottom:0;}
  .about-block h2{font-size:clamp(22px,3.2vw,28px);margin-bottom:16px;}
  .about-block p{color:var(--text-dim);font-size:15px;line-height:1.75;}

  .reasons-list{display:flex;flex-direction:column;gap:14px;margin-top:8px;}
  .reason-item{display:flex;align-items:flex-start;gap:12px;color:var(--text-dim);font-size:15px;line-height:1.6;}
  .reason-item :global(svg){flex:none;color:var(--accent-1);margin-top:3px;}

  /* cta */
  .about-cta{padding:72px 0;text-align:center;border-top:1px solid var(--border);background:var(--surface);}
  @media(max-width:768px){ .about-cta{padding:64px 0;} }
  .about-cta h2{font-size:clamp(26px,4vw,36px);}
  .about-cta p{color:var(--text-dim);font-size:15.5px;max-width:480px;margin:16px auto 32px;}
  .about-cta-actions{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;}
  .btn-primary{
    background:var(--accent);color:#fff;padding:16px 28px;border-radius:var(--radius-sm);font-weight:600;font-size:15px;
    transition:transform .2s ease, filter .2s ease, box-shadow .3s ease;display:inline-block;
  }
  .btn-primary:hover{filter:brightness(1.12);transform:translateY(-2px);box-shadow:0 14px 32px rgba(255,0,127,0.22), 0 4px 10px rgba(255,0,127,0.16);}
  .btn-primary:active{transform:scale(.96);}
  .btn-outline{
    display:inline-block;border:1px solid var(--border);color:var(--text-dim);
    padding:15px 28px;border-radius:var(--radius-sm);font-weight:600;font-size:14.5px;
    box-shadow:var(--shadow-sm);
    transition:border-color .2s ease, color .2s ease, transform .2s ease, box-shadow .3s ease;
  }
  .btn-outline:hover{border-color:#d8d8dd;color:var(--text);transform:translateY(-2px);box-shadow:var(--shadow-md);}
</style>
