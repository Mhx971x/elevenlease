---
import LeasingLanding from '../components/LeasingLanding.astro';

const cards = [
  { title: 'Préserver votre trésorerie', text: "L'absence d'apport évite d'immobiliser une somme importante au démarrage du contrat." },
  { title: 'Comparer le coût réel', text: 'Le loyer augmente généralement sans apport : la comparaison doit porter sur toute la durée du contrat.' },
  { title: 'Rester libre de choisir', text: "Une demande sans apport reste soumise au profil, au véhicule et à l'accord du partenaire financier." },
];
const sections = [
  { title: "Qu'est-ce qu'un leasing sans apport ?", paragraphs: ["Un leasing sans apport est une LOA ou une LLD dont le client ne verse pas de somme personnelle importante au démarrage. Le premier loyer existe toujours, mais il n'est pas volontairement majoré par un apport destiné à réduire les mensualités suivantes.", "Cette formule protège votre épargne disponible. En contrepartie, le montant financé reste plus élevé et le loyer mensuel peut augmenter. La bonne comparaison consiste donc à regarder le premier paiement, chaque loyer, les services inclus, la valeur de rachat éventuelle et le coût total prévu au contrat."] },
  { title: 'Dans quels cas cette solution est-elle pertinente ?', paragraphs: ["Le sans-apport convient souvent aux personnes qui préfèrent garder une épargne de précaution, financer un autre projet ou éviter de placer une somme importante dans un véhicule qu'elles ne rachèteront peut-être pas.", "Il ne constitue toutefois pas un droit automatique. Le partenaire financier étudie les revenus, les charges, la stabilité de la situation, le véhicule demandé et le niveau de loyer. Eleven Lease recherche une configuration cohérente avec ces éléments, sans promettre une acceptation avant l'étude complète."] },
  { title: 'Comment préparer une demande solide ?', paragraphs: ["Définissez un budget mensuel réaliste, prévoyez l'assurance et les frais d'usage, puis rassemblez des justificatifs lisibles et récents. Un véhicule moins coûteux, une durée différente ou une mensualité mieux alignée avec votre reste à vivre peuvent rendre le projet plus cohérent.", "La simulation Eleven Lease permet de demander explicitement une solution sans apport. Nous qualifions ce besoin et pouvons organiser une mise en relation ; seul le partenaire confirme les possibilités, les conditions et sa décision."] },
];
const faqs = [
  { q: "L'apport est-il obligatoire en LOA ?", a: "Non, la loi n'impose pas un apport. Une offre sans apport dépend néanmoins des conditions commerciales et de l'acceptation du dossier par le partenaire financier." },
  { q: 'Le loyer est-il plus élevé sans apport ?', a: "Généralement oui, car aucune somme initiale ne vient réduire le montant réparti sur les loyers. Il faut comparer le coût total plutôt que la seule mensualité." },
  { q: "Peut-on choisir n'importe quel véhicule ?", a: "Vous pouvez indiquer le modèle souhaité, mais la configuration finale doit rester compatible avec votre budget et les critères du partenaire financier." },
  { q: 'La simulation est-elle payante ?', a: "Non. La demande et le pré-check commercial initial sont gratuits et sans engagement. Une première réponse commerciale est visée sous 24 à 48 h ouvrées ; elle ne préjuge pas de la décision du partenaire." },
];
---
<LeasingLanding title="Leasing sans apport | Eleven Lease" description="Découvrez comment obtenir un leasing sans apport, comparer le coût total et préparer un dossier adapté à votre budget avec Eleven Lease." path="/leasing-sans-apport" eyebrow="Financement automobile" heading="Leasing sans apport : gardez votre trésorerie disponible." lead="Demandez une LOA ou une LLD sans apport personnel initial. Nous qualifions votre besoin avant une éventuelle mise en relation avec un partenaire." directAnswer="Le leasing sans apport est possible sur certaines offres. Il augmente souvent le loyer mensuel ; seul le partenaire étudie définitivement le dossier et décide, sans garantie d'acceptation." {cards} {sections} {faqs} sourceLabel="DGCCRF — règles applicables à la LOA" sourceUrl="https://www.economie.gouv.fr/dgccrf/les-fiches-pratiques/location-avec-option-dachat-loa-dun-vehicule-quelles-sont-les-regles-connaitre" />
