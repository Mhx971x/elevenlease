  .stepper-nav{display:flex;justify-content:space-between;align-items:center;margin-top:20px;gap:12px;}
  .step-back, .step-skip, .restart-link{
    font-size:13.5px;color:var(--text-dim);cursor:pointer;background:none;border:none;font-family:inherit;padding:0;
  }
  .step-back:hover, .step-skip:hover, .restart-link:hover{color:var(--text);}
  .step-back:disabled{visibility:hidden;}
  .step-skip{text-decoration:underline;}
  .restart-link{text-decoration:underline;margin-top:14px;display:inline-block;}
  /* écran de succès */
  .success-screen{display:none;text-align:center;}
  .success-screen.show{display:block;animation:fadeUp .5s cubic-bezier(.16,1,.3,1);}
