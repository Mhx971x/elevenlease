    .btn-primary{width:100%;}
    .faq-section{padding:56px 0 64px;}
    .section-head{margin-bottom:22px;}
    .section-head h2{font-size:34px;}
    .section-head p{margin-top:10px;font-size:14px;}
    .faq-list{gap:8px;}
