  .veh-visual{position:relative;display:flex;aspect-ratio:1.53/1;align-items:center;justify-content:center;overflow:hidden;border-bottom:1px solid rgba(17,17,19,.05);background:linear-gradient(180deg,#f4f4f6,#ededf0);}
