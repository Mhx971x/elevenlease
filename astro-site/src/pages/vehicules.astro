  /* cards */
  .veh-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;}
  .veh-card{display:flex;min-width:0;overflow:hidden;flex-direction:column;border:1px solid #e4e4e8;border-radius:20px;background:#fff;box-shadow:0 7px 22px rgba(17,17,19,.045);cursor:pointer;transition:transform .3s cubic-bezier(.16,1,.3,1),border-color .3s ease,box-shadow .3s ease;}
