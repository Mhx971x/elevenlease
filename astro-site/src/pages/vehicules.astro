  .faq-item[open]{border-color:rgba(255,0,127,.2);background:linear-gradient(115deg,#fff 45%,#fff9fc);}
  .faq-item summary{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:19px 0;cursor:pointer;list-style:none;font-size:14.5px;font-weight:600;}
