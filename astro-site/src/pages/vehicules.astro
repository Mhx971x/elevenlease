  .faq-item summary:focus-visible{outline:2px solid rgba(255,0,127,.2);outline-offset:-4px;border-radius:9px;}
  .faq-icon{position:relative;flex:0 0 30px;width:30px;height:30px;border-radius:50%;background:#f5f5f7;transition:background .25s ease;}
  .faq-icon::before,.faq-icon::after{content:'';position:absolute;top:50%;left:50%;background:var(--text-dim);transition:transform .3s cubic-bezier(.16,1,.3,1),background .2s ease;}
  .faq-icon::before{width:11px;height:1.5px;transform:translate(-50%,-50%);}
  .faq-icon::after{width:1.5px;height:11px;transform:translate(-50%,-50%);}
  .faq-item[open] .faq-icon{background:rgba(255,0,127,.075);}
  .faq-item[open] .faq-icon::after{transform:translate(-50%,-50%) rotate(90deg);}
  .faq-item[open] .faq-icon::before,.faq-item[open] .faq-icon::after{background:var(--accent-1);}
  .faq-content p{max-width:790px;padding:0 46px 19px 0;color:var(--text-dim);font-size:13.5px;line-height:1.72;}

  @media(max-width:980px){
