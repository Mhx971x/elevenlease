  function formatFileSize(bytes: number){
    if(!Number.isFinite(bytes) || bytes <= 0) return '';
    if(bytes < 1024 * 1024) return Math.max(1, Math.round(bytes / 1024)) + ' Ko';
    return (bytes / (1024 * 1024)).toFixed(1).replace('.', ',') + ' Mo';
  }

  function buildDocumentPortal(lead: Lead){
    if(isPartner()) return '';
    const portal = lead.document_portal;
    const documents = portal?.documents || [];
    const expired = portal?.expired === true;
    const revoked = Boolean(portal?.revoked_at);
    const active = Boolean(portal && !expired && !revoked);
    const complete = Boolean(portal?.completed_at);
    const statusLabel = !portal
      ? 'Non créé'
      : revoked
        ? 'Lien désactivé'
      : expired
        ? 'Expiré'
        : complete
          ? 'Dossier complet'
          : documents.length + ' pièce' + (documents.length > 1 ? 's' : '') + ' reçue' + (documents.length > 1 ? 's' : '');
    const statusClass = expired ? ' expired' : complete ? ' complete' : '';
    const files = documents.map(document =>
      '<div class="document-admin-item">' +
        '<div class="document-admin-info">' +
          '<strong>' + escapeHtml(document.original_name) + '</strong>' +
          '<span>' + escapeHtml(DOCUMENT_LABELS[document.document_type] || document.document_type) +
            (document.size_bytes ? ' · ' + formatFileSize(document.size_bytes) : '') + '</span>' +
        '</div>' +
        '<button type="button" class="document-download-btn" data-document-id="' + escapeHtml(document.id) + '">Télécharger</button>' +
        '<button type="button" class="document-delete-btn" data-document-id="' + escapeHtml(document.id) + '">Supprimer</button>' +
      '</div>'
    ).join('');
    return (
      '<div class="document-portal-box">' +
        '<div class="document-portal-head">' +
          '<div><h3>Dossier documentaire sécurisé</h3><p>' +
            (active
              ? 'Lien actif jusqu’au ' + new Date(portal.expires_at).toLocaleDateString('fr-FR') + '.'
              : 'Créez un lien privé à transmettre uniquement au client qualifié.') +
          '</p></div>' +
          '<span class="document-portal-status' + statusClass + '">' + escapeHtml(statusLabel) + '</span>' +
        '</div>' +
        '<div class="document-portal-actions">' +
          '<button type="button" class="document-link-btn" data-id="' + lead.id + '" data-has-portal="' + (active ? '1' : '0') + '">' +
            (active ? 'Générer un nouveau lien' : 'Créer le lien documents') +
          '</button>' +
          (active
            ? '<button type="button" class="document-revoke-btn" data-id="' + lead.id + '">Désactiver le lien</button>'
            : '') +
        '</div>' +
        (files ? '<div class="document-admin-list">' + files + '</div>' : '') +
      '</div>'
    );
  }

