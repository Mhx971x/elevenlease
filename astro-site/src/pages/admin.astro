  }

  function renderAnalyticsRanking(target: Element, rows: AnalyticsRow[], labelFormatter = (value: string) => value){
    if(!rows.length){
      target.innerHTML = '<div class="analytics-chart-empty">Aucune donnée pour cette période</div>';
      return;
    }
    const max = Math.max(...rows.map(row => row.visitors), 1);
    target.innerHTML = rows.map(row => {
      const width = Math.max(3, (row.visitors / max) * 100);
      return '<div class="analytics-rank-row" title="' + exactNumber.format(row.pageviews) + ' pages vues">' +
        '<div class="analytics-rank-label">' + escapeHtml(labelFormatter(row.label)) + '</div>' +
        '<div class="analytics-rank-value">' + compactNumber.format(row.visitors) + '</div>' +
        '<div class="analytics-rank-track"><div class="analytics-rank-fill" style="width:' + width.toFixed(1) + '%"></div></div>' +
      '</div>';
    }).join('');
  }

  function renderAnalyticsTrend(rows: AnalyticsPayload['trend']){
    if(!rows.length){
      analyticsTrend.innerHTML = '<div class="analytics-chart-empty">Aucune visite enregistrée pour cette période</div>';
      return;
    }
    const max = Math.max(...rows.flatMap(row => [row.pageviews, row.visitors]), 1);
    analyticsTrend.innerHTML = rows.map((row, index) => {
      const date = new Date(analyticsRange === 1 ? row.date : row.date + 'T12:00:00');
      const label = analyticsRange === 1
        ? (index % 4 === 0 || index === rows.length - 1 ? date.toLocaleTimeString('fr-FR', { hour:'2-digit' }) : '')
        : analyticsRange === 30 && index % 5 !== 0 && index !== rows.length - 1
          ? ''
          : date.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit' });
      const visitorsHeight = Math.max(2, (row.visitors / max) * 100);
      const viewsHeight = Math.max(2, (row.pageviews / max) * 100);
      const periodLabel = analyticsRange === 1
        ? date.toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' })
        : date.toLocaleDateString('fr-FR');
      return '<div class="analytics-day" title="' + periodLabel + ' · ' + exactNumber.format(row.visitors) + ' visiteurs · ' + exactNumber.format(row.pageviews) + ' pages vues">' +
        '<div class="analytics-bar" style="height:' + visitorsHeight.toFixed(1) + '%"></div>' +
        '<div class="analytics-bar views" style="height:' + viewsHeight.toFixed(1) + '%"></div>' +
        (label ? '<span class="analytics-day-label">' + label + '</span>' : '') +
      '</div>';
    }).join('');
  }

  function renderAnalytics(data: AnalyticsPayload){
    analyticsVisitors.textContent = exactNumber.format(data.metrics.visitors);
    analyticsPageviews.textContent = exactNumber.format(data.metrics.pageviews);
    analyticsLeads.textContent = exactNumber.format(data.metrics.leads);
    analyticsConversion.textContent = data.metrics.conversionRate.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) + ' %';
    analyticsDepth.textContent = data.metrics.pagesPerVisitor.toLocaleString('fr-FR', { maximumFractionDigits: 1 });
    analyticsRangeLabel.textContent = data.range === 1 ? '24 dernières heures' : data.range + ' derniers jours';
    analyticsTrendSubtitle.textContent = data.range === 1 ? 'Visiteurs et pages vues par heure' : 'Visiteurs et pages vues par jour';
    renderAnalyticsTrend(data.trend);
    renderAnalyticsRanking(analyticsPages, data.pages, analyticsPageLabel);
    renderAnalyticsRanking(analyticsReferrers, data.referrers);
    renderAnalyticsRanking(analyticsCountries, data.countries, analyticsCountryLabel);
    renderAnalyticsRanking(analyticsDevices, data.devices, analyticsDeviceLabel);
    const refreshedAt = new Date(data.generatedAt).toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });
    analyticsFreshness.textContent = 'Mis à jour à ' + refreshedAt + ' · actualisation chaque minute';
  }

  async function loadAnalytics(silent = false){
    if(!silent){
      analyticsLoading.style.display = 'block';
      analyticsContent.style.display = 'none';
    }
    analyticsError.style.display = 'none';
    try{
      const response = await fetch(ADMIN_ANALYTICS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...authPayload(), range: analyticsRange }),
      });
      const data = await response.json().catch(() => ({}));
      if(!response.ok) throw new Error(data.error || ('HTTP ' + response.status));
      renderAnalytics(data as AnalyticsPayload);
      analyticsLoaded = true;
      analyticsLoading.style.display = 'none';
      analyticsContent.style.display = 'block';
      lastRefresh.textContent = 'Audience mise à jour';
    }catch(error: any){
      analyticsLoading.style.display = 'none';
      if(!silent || !analyticsLoaded){
        analyticsContent.style.display = 'none';
        analyticsError.textContent = error.message || 'Impossible de charger les statistiques.';
        analyticsError.style.display = 'block';
      }
    }
  }

