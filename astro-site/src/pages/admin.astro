  function renderLeads(){
    const query = searchInput.value.trim().toLowerCase();
    const statusVal = statusFilter.value;
    const sortVal = sortSelect.value;

    updateStats();

    let filtered = allLeads.filter(lead => {
      if(activePipelineGroup){
        const group = PIPELINE_GROUPS.find(item => item.value === activePipelineGroup);
        if(group && !group.values.includes(lead.status || 'nouveau')) return false;
      }
      if(statusVal && (lead.status || 'nouveau') !== statusVal) return false;
      if(!query) return true;
      const haystack = [
        lead.prenom, lead.nom, lead.email, lead.telephone, lead.vehicule,
        lead.entreprise, lead.siren, lead.type_vehicule_souhaite, lead.motorisation
      ]
        .filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });

    filtered = filtered.slice().sort((a, b) => {
      if(sortVal === 'name') return ((a.nom||'')+(a.prenom||'')).localeCompare((b.nom||'')+(b.prenom||''), 'fr');
      const da = new Date(a.created_at || 0), db = new Date(b.created_at || 0);
      return sortVal === 'old' ? da.getTime() - db.getTime() : db.getTime() - da.getTime();
    });

    leadResultCount.textContent = filtered.length + ' dossier' + (filtered.length > 1 ? 's' : '');

    if(filtered.length === 0){
      leadList.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }
    emptyState.style.display = 'none';
    leadList.style.display = 'flex';

    leadList.innerHTML = filtered.map((lead, i) => buildCard(lead, i)).join('');
    attachCardListeners(leadList);
  }

  function attachCardListeners(root: HTMLElement){
    root.querySelectorAll<HTMLElement>('.lead-card-header').forEach(header => {
      header.addEventListener('click', () => toggleCard(header.closest('.lead-card') as HTMLElement));
    });
    root.querySelectorAll<HTMLSelectElement>('.crm-status-select').forEach(select => {
      select.addEventListener('click', e => e.stopPropagation());
      select.addEventListener('change', e => { e.stopPropagation(); onLeadStatusChange(select); });
    });
    root.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); btn.closest('.lead-card')!.classList.add('editing'); });
    });
    root.querySelectorAll<HTMLButtonElement>('.cancel-edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); btn.closest('.lead-card')!.classList.remove('editing'); });
    });
    root.querySelectorAll<HTMLButtonElement>('.save-edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onSaveEdit(e); });
    });
    root.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDeleteLead(e); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-link-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onCreateDocumentPortal(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-copy-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onCopyDocumentPortal(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-email-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onSendDocumentRequest(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-zip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDownloadDocumentsZip(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-revoke-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onRevokeDocumentPortal(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-download-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDownloadDocument(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDeleteDocument(btn); });
    });
  }

  async function copyPortalLink(url: string){
    try{
      await navigator.clipboard.writeText(url);
      alert('Lien sécurisé copié. Vous pouvez maintenant le transmettre au client.');
    }catch{
      prompt('Copiez ce lien sécurisé et transmettez-le au client :', url);
    }
  }

  async function onSendDocumentRequest(btn: HTMLButtonElement){
    const id = btn.dataset.id!;
    const email = btn.dataset.email || '';
    const lead = allLeads.find(item => String(item.id) === String(id));
    const name = lead ? ((lead.prenom || '') + ' ' + (lead.nom || '')).trim() : 'ce client';
    if(!email) return;
    const confirmation = 'Envoyer une demande de documents à ' + name + ' (' + email + ') ?\n\n' +
      'Un nouveau lien sécurisé valable 30 jours sera créé. Le lien précédent sera désactivé.';
    if(!confirm(confirmation)) return;

    btn.disabled = true;
    const previousText = btn.textContent;
    btn.textContent = 'Envoi en cours…';
    try{
      const result = await callAdminFunction({
        ...authPayload(),
        action: 'send-document-request',
        id,
      });
      if(lead){
        lead.status = 'documents';
        lead.document_request_email_status = result.emailStatus || 'sent';
        lead.document_request_email_id = result.messageId || '';
        lead.document_request_email_sent_at = result.sentAt || new Date().toISOString();
        lead.document_request_email_error = '';
        lead.document_portal = {
          ...result.portal,
          expired: false,
          documents: lead.document_portal?.documents || [],
        };
        refreshCard(lead);
        updateStats();
      }
      alert('La demande de documents a bien été envoyée à ' + email + '.');
    }catch(err: any){
      if(lead){
        lead.document_request_email_status = 'failed';
        lead.document_request_email_error = err.message || 'Erreur d’envoi';
        refreshCard(lead);
      }else{
        btn.disabled = false;
        btn.textContent = previousText || 'Envoyer la demande par email';
      }
      alert('Impossible d’envoyer la demande de documents : ' + err.message);
    }
  }

  async function onCopyDocumentPortal(btn: HTMLButtonElement){
    const id = btn.dataset.id!;
    const lead = allLeads.find(item => String(item.id) === String(id));
    btn.disabled = true;
    const previousText = btn.textContent;
    btn.textContent = 'Copie en cours…';
    try{
      const result = await callAdminFunction({
        ...authPayload(),
        action: 'document-portal-link',
        id,
      });
      await copyPortalLink(result.url);
    }catch(err: any){
      const historical = String(err.message || '').includes('historique');
      if(historical && confirm(
        'Ce lien a été créé avant l’activation de la copie sécurisée.\n\n' +
        'Voulez-vous le renouveler maintenant ? L’ancien lien sera désactivé.'
      )){
        try{
          const result = await callAdminFunction({
            ...authPayload(),
            action: 'create-document-portal',
            id,
          });
          if(lead){
            lead.document_portal = {
              ...result.portal,
              expired:false,
              documents:lead.document_portal?.documents || [],
            };
            refreshCard(lead);
          }
          await copyPortalLink(result.url);
          return;
        }catch(renewError: any){
          alert('Impossible de renouveler le lien : ' + renewError.message);
          return;
        }
      }
      if(!historical) alert('Impossible de copier le lien actif : ' + err.message);
    }finally{
      if(btn.isConnected){
        btn.disabled = false;
        btn.textContent = previousText || 'Copier le lien actif';
      }
    }
  }

  async function onCreateDocumentPortal(btn: HTMLButtonElement){
    const id = btn.dataset.id!;
    if(btn.dataset.hasPortal === '1' && !confirm('Le lien actuel sera immédiatement désactivé. Générer un nouveau lien ?')) return;
    btn.disabled = true;
    try{
      const result = await callAdminFunction({ ...authPayload(), action: 'create-document-portal', id });
      const lead = allLeads.find(item => String(item.id) === String(id));
      if(lead){
        lead.document_portal = {
          ...result.portal,
          expired: false,
          documents: lead.document_portal?.documents || [],
        };
        refreshCard(lead);
      }
      await copyPortalLink(result.url);
    }catch(err: any){
      btn.disabled = false;
      alert('Impossible de créer le lien documentaire : ' + err.message);
    }
  }

  async function onRevokeDocumentPortal(btn: HTMLButtonElement){
    const id = btn.dataset.id!;
    if(!confirm('Désactiver immédiatement le lien documentaire de ce client ?')) return;
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'revoke-document-portal', id });
      const lead = allLeads.find(item => String(item.id) === String(id));
      if(lead){
        if(lead.document_portal) lead.document_portal.revoked_at = new Date().toISOString();
        refreshCard(lead);
      }
    }catch(err: any){
      btn.disabled = false;
      alert('Impossible de désactiver le lien : ' + err.message);
    }
  }

  async function onDownloadDocument(btn: HTMLButtonElement){
    btn.disabled = true;
    try{
      const result = await callAdminFunction({
        ...authPayload(),
        action: 'document-download',
        documentId: btn.dataset.documentId,
      });
      window.open(result.url, '_blank', 'noopener');
    }catch(err: any){
      alert('Impossible de télécharger le document : ' + err.message);
    }finally{
      btn.disabled = false;
    }
  }

  function archiveClientName(lead: Lead | undefined){
    const fullName = lead
      ? [lead.nom, lead.prenom].filter(Boolean).join(' ')
      : 'Client';
    const safeName = fullName
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[<>:"/\\|?*\u0000-\u001f]/g, '-')
      .replace(/\s+/g, ' ')
      .trim() || 'Client';
    return 'Dossier ' + safeName + '.zip';
  }

  async function onDownloadDocumentsZip(btn: HTMLButtonElement){
    const id = btn.dataset.id!;
    const lead = allLeads.find(item => String(item.id) === String(id));
    btn.disabled = true;
    const previousText = btn.textContent;
    btn.textContent = 'Création du ZIP…';
    try{
      const response = await fetch(ADMIN_FUNCTION_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
        },
        body: JSON.stringify({
          ...authPayload(),
          action: 'documents-zip',
          id,
        }),
      });
      if(!response.ok){
        const error = await response.json().catch(() => ({}));
        throw new Error(error.error || ('HTTP ' + response.status));
      }
      const blob = await response.blob();
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = archiveClientName(lead);
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }catch(err: any){
      alert('Impossible de créer le fichier ZIP : ' + err.message);
    }finally{
      btn.disabled = false;
      btn.textContent = previousText || '↓ Tout télécharger (.zip)';
    }
  }

  async function onDeleteDocument(btn: HTMLButtonElement){
    const documentId = btn.dataset.documentId!;
    if(!confirm('Supprimer définitivement ce document ?')) return;
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'delete-document', documentId });
      const card = btn.closest('.lead-card') as HTMLElement;
      const lead = allLeads.find(item => String(item.id) === String(card.dataset.id));
      if(lead?.document_portal){
        lead.document_portal.documents = (lead.document_portal.documents || [])
          .filter(document => document.id !== documentId);
        lead.document_portal.completed_at = undefined;
        refreshCard(lead);
      }
    }catch(err: any){
      btn.disabled = false;
      alert('Impossible de supprimer le document : ' + err.message);
    }
  }

  function refreshCard(lead: Lead){
    const card = leadList.querySelector('.lead-card[data-id="' + CSS.escape(String(lead.id)) + '"]');
    if(!card) return;
    const index = Array.from(leadList.children).indexOf(card);
    const wrapper = document.createElement('div');
    wrapper.innerHTML = buildCard(lead, index);
    const newCard = wrapper.firstElementChild as HTMLElement;
    if(card.classList.contains('open')){
      newCard.classList.add('open');
      const detail = newCard.querySelector('.lead-detail') as HTMLElement;
      detail.style.height = 'auto';
      detail.style.opacity = '1';
    }
    card.replaceWith(newCard);
    attachCardListeners(newCard);
  }

  async function onSaveEdit(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const card = btn.closest('.lead-card') as HTMLElement;
    const fields: Record<string, string> = {};
    card.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.lead-edit-form [data-field]').forEach(input => {
      fields[input.dataset.field!] = input.value.trim();
    });
    btn.disabled = true;
    const cancelBtn = card.querySelector('.cancel-edit-btn') as HTMLButtonElement | null;
    if(cancelBtn) cancelBtn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'update-details', id, fields });
      const lead = allLeads.find(l => String(l.id) === String(id));
      if(lead) Object.assign(lead, fields);
      updateStats();
      if(lead) refreshCard(lead);
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      if(cancelBtn) cancelBtn.disabled = false;
      alert("Impossible d'enregistrer les modifications : " + err.message);
    }
  }

  async function onDeleteLead(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const lead = allLeads.find(l => String(l.id) === String(id));
    const name = lead ? ((lead.prenom || '') + ' ' + (lead.nom || '')).trim() || 'ce lead' : 'ce lead';
    if(!confirm('Supprimer définitivement la demande de "' + name + '" ? Cette action est irréversible.')) return;
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'delete', id });
      allLeads = allLeads.filter(l => String(l.id) !== String(id));
      renderLeads();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert('Impossible de supprimer cette demande : ' + err.message);
    }
  }

  function toggleCard(card: HTMLElement){
    if(card.dataset.animating === '1') return;
    const detail = card.querySelector('.lead-detail') as HTMLElement;
    card.classList.contains('open') ? closeCard(card, detail) : openCard(card, detail);
  }

  function openCard(card: HTMLElement, detail: HTMLElement){
    card.dataset.animating = '1';
    card.classList.add('open');
    const target = detail.scrollHeight;
    detail.style.overflow = 'hidden';
    const anim = detail.animate(
      [{ height: '0px', opacity: 0 }, { height: target + 'px', opacity: 1 }],
      { duration: 320, easing: cardEasing }
    );
    anim.onfinish = () => {
      detail.style.overflow = '';
      detail.style.height = '';
      card.dataset.animating = '';
    };
  }

  function closeCard(card: HTMLElement, detail: HTMLElement){
    card.dataset.animating = '1';
    const start = detail.scrollHeight;
    detail.style.overflow = 'hidden';
    const anim = detail.animate(
      [{ height: start + 'px', opacity: 1 }, { height: '0px', opacity: 0 }],
      { duration: 280, easing: cardEasing }
    );
    anim.onfinish = () => {
      card.classList.remove('open');
      detail.style.overflow = '';
      detail.style.height = '';
      card.dataset.animating = '';
    };
  }

  async function onLeadStatusChange(select: HTMLSelectElement){
    const id = select.dataset.id!;
    const lead = allLeads.find(item => String(item.id) === String(id));
    const previousStatus = lead?.status || 'nouveau';
    const newStatus = select.value;
    select.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'update-status', id, status: newStatus });
      if(lead) lead.status = newStatus;
      renderLeads();
    }catch(err: any){
      console.error(err);
      select.value = previousStatus;
      select.disabled = false;
      alert("Impossible de mettre à jour le statut : " + err.message);
    }
  }

  async function loadLeads(){
    loadingState.style.display = 'block';
    errorState.style.display = 'none';
    leadList.style.display = 'none';
    emptyState.style.display = 'none';
    try{
      const data = await callAdminFunction({ ...authPayload() });
      allLeads = data.leads || [];
      populateInvoiceLeadOptions();
      loadingState.style.display = 'none';
      lastRefresh.textContent = 'Actualisé à ' + new Date().toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });
      renderLeads();
    }catch(err: any){
      console.error(err);
      loadingState.style.display = 'none';
      errorState.style.display = 'block';
      errorState.textContent = "Erreur de chargement : " + err.message;
    }
  }

  // ============================================================
  // Onglet "Messages de contact" — même logique que les leads, en plus
  // simple (pas de formulaire d'édition, pas d'éligibilité).
  // ============================================================
  function buildMessageCard(msg: ContactMessage, index: number){
    const status = msg.status || 'nouveau';
    const fullName = (msg.nom || '').trim() || 'Sans nom';
    const initial = (msg.nom || '?').trim().charAt(0).toUpperCase();
    const subLine = [msg.email, msg.telephone].filter(Boolean).join(' · ') || 'Aucun contact renseigné';
    const messageBox = msg.message
      ? '<div class="lead-message-box"><span class="d-label">Message</span>' + escapeHtml(msg.message) + '</div>'
      : '';
    const telHref = msg.telephone ? 'tel:' + msg.telephone.replace(/\s+/g, '') : '';
    const mailHref = msg.email ? 'mailto:' + msg.email : '';

    return (
      '<div class="lead-card" data-id="' + msg.id + '" style="animation-delay:' + Math.min(index * 0.035, 0.3) + 's">' +
        '<div class="lead-card-header">' +
          '<div class="lead-avatar">' + escapeHtml(initial) + '</div>' +
          '<div class="lead-main">' +
            '<div class="lead-name-row">' +
              '<span class="lead-name">' + escapeHtml(fullName) + '</span>' +
              '<span class="status-pill ' + status + '">' + (status === 'traite' ? 'Traité' : 'À traiter') + '</span>' +
            '</div>' +
            '<div class="lead-sub">' + escapeHtml(subLine) + '</div>' +
          '</div>' +
          '<div class="lead-meta">' +
            '<span class="lead-date">' + relativeTime(msg.created_at) + '</span>' +
            CHEVRON_SVG +
          '</div>' +
        '</div>' +
        '<div class="lead-detail">' +
          '<div class="lead-detail-inner">' +
            messageBox +
            '<div class="lead-actions">' +
              '<div class="quick-actions">' +
                (telHref ? '<a class="quick-btn" href="' + telHref + '">' + PHONE_SVG + 'Appeler</a>' : '') +
                (mailHref ? '<a class="quick-btn" href="' + mailHref + '">' + MAIL_SVG + 'Email</a>' : '') +
                (isPartner() ? '' : '<button type="button" class="delete-btn" data-id="' + msg.id + '">Supprimer</button>') +
              '</div>' +
              (isPartner() ? '' : '<button class="status-btn ' + status + '" data-id="' + msg.id + '" data-status="' + status + '"><span class="dot"></span>' + (status === 'traite' ? 'Marquer comme à traiter' : 'Marquer comme traité') + '</button>') +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function renderMessages(){
    const query = messagesSearchInput.value.trim().toLowerCase();
    const statusVal = messagesStatusFilter.value;
    const sortVal = messagesSortSelect.value;

    updateMessagesStats();

    let filtered = allMessages.filter(msg => {
      if(statusVal && (msg.status || 'nouveau') !== statusVal) return false;
      if(!query) return true;
      const haystack = [msg.nom, msg.email, msg.telephone].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });

    filtered = filtered.slice().sort((a, b) => {
      if(sortVal === 'name') return (a.nom || '').localeCompare(b.nom || '', 'fr');
      const da = new Date(a.created_at || 0), db = new Date(b.created_at || 0);
      return sortVal === 'old' ? da.getTime() - db.getTime() : db.getTime() - da.getTime();
    });

    if(filtered.length === 0){
      messageList.style.display = 'none';
      messagesEmptyState.style.display = 'block';
      return;
    }
    messagesEmptyState.style.display = 'none';
    messageList.style.display = 'flex';

    messageList.innerHTML = filtered.map((msg, i) => buildMessageCard(msg, i)).join('');
    attachMessageCardListeners(messageList);
  }

  function attachMessageCardListeners(root: HTMLElement){
    root.querySelectorAll<HTMLElement>('.lead-card-header').forEach(header => {
      header.addEventListener('click', () => toggleCard(header.closest('.lead-card') as HTMLElement));
    });
    root.querySelectorAll<HTMLButtonElement>('.status-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onToggleMessageStatus(e); });
    });
    root.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDeleteMessage(e); });
    });
  }

  function refreshMessageCard(msg: ContactMessage){
    const card = messageList.querySelector('.lead-card[data-id="' + CSS.escape(String(msg.id)) + '"]');
    if(!card) return;
    const index = Array.from(messageList.children).indexOf(card);
    const wrapper = document.createElement('div');
    wrapper.innerHTML = buildMessageCard(msg, index);
    const newCard = wrapper.firstElementChild as HTMLElement;
    if(card.classList.contains('open')){
      newCard.classList.add('open');
      const detail = newCard.querySelector('.lead-detail') as HTMLElement;
      detail.style.height = 'auto';
      detail.style.opacity = '1';
    }
    card.replaceWith(newCard);
    attachMessageCardListeners(newCard);
  }

  async function onToggleMessageStatus(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const currentStatus = btn.dataset.status;
    const newStatus = currentStatus === 'traite' ? 'nouveau' : 'traite';
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), resource: 'messages', action: 'update-status', id, status: newStatus });
      const msg = allMessages.find(m => String(m.id) === String(id));
      if(msg) msg.status = newStatus;
      renderMessages();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert("Impossible de mettre à jour le statut : " + err.message);
    }
  }

  async function onDeleteMessage(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const msg = allMessages.find(m => String(m.id) === String(id));
    const name = msg ? (msg.nom || '').trim() || 'ce message' : 'ce message';
    if(!confirm('Supprimer définitivement le message de "' + name + '" ? Cette action est irréversible.')) return;
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), resource: 'messages', action: 'delete', id });
      allMessages = allMessages.filter(m => String(m.id) !== String(id));
      renderMessages();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert('Impossible de supprimer ce message : ' + err.message);
    }
  }

  async function loadMessages(){
    messagesLoadingState.style.display = 'block';
    messagesErrorState.style.display = 'none';
    messageList.style.display = 'none';
    messagesEmptyState.style.display = 'none';
    try{
      const data = await callAdminFunction({ ...authPayload(), resource: 'messages' });
      allMessages = data.messages || [];
      messagesLoadingState.style.display = 'none';
      renderMessages();
    }catch(err: any){
      console.error(err);
      messagesLoadingState.style.display = 'none';
      messagesErrorState.style.display = 'block';
      messagesErrorState.textContent = "Erreur de chargement : " + err.message;
    }
  }

  // ============================================================
  // Onglet "Véhicules" — catalogue géré directement depuis l'admin,
  // stocké dans la table Supabase `vehicles` (remplace le Google Sheet).
  // Chaque mutation réussie (création/modif/statut/suppression) déclenche
  // côté fonction edge un rebuild Vercel : le site public se republie
  // automatiquement avec le catalogue à jour, sans intervention manuelle.
  // ============================================================
  const VEHICLE_FIELD_KEYS = [
    'brand', 'name', 'type', 'condition', 'price', 'km', 'duration', 'fuel',
    'transmission', 'places', 'finition', 'description',
    'options_confort', 'options_exterieur', 'options_interieur', 'options_technologie',
    'annee', 'puissance', 'moteur', 'autonomie_elec', 'autonomie_cumulee',
    'recharge_dc', 'recharge_ac', 'temps_charge', 'consommation', 'co2', 'coffre',
  ];
  const VEHICLE_OPTIONS_KEYS = ['options_confort', 'options_exterieur', 'options_interieur', 'options_technologie'];

  interface PhotoPreview { id: string; url: string; uploading: boolean; }
  let photoPreviews: PhotoPreview[] = [];
  let currentUploadFolder: string | null = null;
  let editingVehicleId: string | number | null = null;
  let activeUploads = 0;

  function updateVehiclesStats(){
    const total = allVehicles.length;
    const active = allVehicles.filter(v => v.active !== false).length;
    vehStatTotal.textContent = String(total);
    vehStatActive.textContent = String(active);
    vehStatInactive.textContent = String(total - active);
    document.querySelectorAll('#vehiclesPanel .stat-card').forEach((el, i) => setTimeout(() => el.classList.add('in'), i * 60));
  }

  function buildVehicleCard(v: VehicleAdmin, index: number){
    const isActive = v.active !== false;
    const statusCls = isActive ? 'nouveau' : 'traite';
    const thumb = v.photos && v.photos[0]
      ? '<img class="vehicle-thumb" src="' + escapeHtml(v.photos[0]) + '" alt="">'
      : '<div class="vehicle-thumb-placeholder">🚗</div>';
    const title = escapeHtml(v.brand + ' ' + v.name) + (v.finition ? ' ' + escapeHtml(v.finition) : '');
    const subLine = [v.price ? v.price + '€/mois' : '', v.condition, v.type].filter(Boolean).join(' · ') || 'Détails non renseignés';

    return (
      '<div class="lead-card" data-id="' + v.id + '" style="animation-delay:' + Math.min(index * 0.035, 0.3) + 's">' +
        '<div class="lead-card-header">' +
          thumb +
          '<div class="lead-main">' +
            '<div class="lead-name-row">' +
              '<span class="lead-name">' + title + '</span>' +
              '<span class="status-pill ' + statusCls + '">' + (isActive ? 'Actif' : 'Inactif') + '</span>' +
            '</div>' +
            '<div class="lead-sub">' + escapeHtml(subLine) + '</div>' +
          '</div>' +
          '<div class="lead-meta">' +
            '<span class="lead-date">' + relativeTime(v.created_at) + '</span>' +
            CHEVRON_SVG +
          '</div>' +
        '</div>' +
        '<div class="lead-detail">' +
          '<div class="lead-detail-inner">' +
            '<div class="lead-actions">' +
              '<div class="quick-actions">' +
                '<a class="quick-btn" href="/vehicule/' + escapeHtml(v.slug) + '" target="_blank" rel="noopener">Voir la fiche</a>' +
                (isPartner() ? '' : '<button type="button" class="edit-btn" data-id="' + v.id + '">Modifier</button>') +
                (isPartner() ? '' : '<button type="button" class="delete-btn" data-id="' + v.id + '">Supprimer</button>') +
              '</div>' +
              (isPartner() ? '' : '<button class="status-btn ' + statusCls + '" data-id="' + v.id + '" data-active="' + isActive + '"><span class="dot"></span>' + (isActive ? 'Désactiver (masquer)' : 'Activer (afficher)') + '</button>') +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function renderVehicles(){
    const query = vehiclesSearchInput.value.trim().toLowerCase();
    const statusVal = vehiclesStatusFilter.value;
    const sortVal = vehiclesSortSelect.value;

    updateVehiclesStats();

    let filtered = allVehicles.filter(v => {
      const isActive = v.active !== false;
      if(statusVal === 'active' && !isActive) return false;
      if(statusVal === 'inactive' && isActive) return false;
      if(!query) return true;
      const haystack = [v.brand, v.name, v.finition].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });

    filtered = filtered.slice().sort((a, b) => {
      if(sortVal === 'name') return ((a.brand||'')+(a.name||'')).localeCompare((b.brand||'')+(b.name||''), 'fr');
      if(sortVal === 'price-asc') return (a.price || 0) - (b.price || 0);
      if(sortVal === 'price-desc') return (b.price || 0) - (a.price || 0);
      const da = new Date(a.created_at || 0), db = new Date(b.created_at || 0);
      return sortVal === 'old' ? da.getTime() - db.getTime() : db.getTime() - da.getTime();
    });

    if(filtered.length === 0){
      vehicleList.style.display = 'none';
      vehiclesEmptyState.style.display = 'block';
      return;
    }
    vehiclesEmptyState.style.display = 'none';
    vehicleList.style.display = 'flex';

    vehicleList.innerHTML = filtered.map((v, i) => buildVehicleCard(v, i)).join('');
    attachVehicleCardListeners(vehicleList);
  }

  function attachVehicleCardListeners(root: HTMLElement){
    root.querySelectorAll<HTMLElement>('.lead-card-header').forEach(header => {
      header.addEventListener('click', () => toggleCard(header.closest('.lead-card') as HTMLElement));
    });
    root.querySelectorAll<HTMLButtonElement>('.status-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onToggleVehicleActive(e); });
    });
    root.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (e.currentTarget as HTMLButtonElement).dataset.id!;
        const vehicle = allVehicles.find(v => String(v.id) === String(id));
        if(vehicle) openVehicleForm(vehicle);
      });
    });
    root.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDeleteVehicle(e); });
    });
  }

  async function onToggleVehicleActive(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const newActive = btn.dataset.active !== 'true';
    btn.disabled = true;
    try{
      await callAdminVehiclesFunction({ ...authPayload(), action: 'update-status', id, active: newActive });
      const vehicle = allVehicles.find(v => String(v.id) === String(id));
      if(vehicle) vehicle.active = newActive;
      renderVehicles();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert("Impossible de mettre à jour le statut : " + err.message);
    }
  }

  async function onDeleteVehicle(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const vehicle = allVehicles.find(v => String(v.id) === String(id));
    const name = vehicle ? (vehicle.brand + ' ' + vehicle.name).trim() : 'ce véhicule';
    if(!confirm('Supprimer définitivement "' + name + '" ainsi que ses photos ? Cette action est irréversible.')) return;
    btn.disabled = true;
    try{
      await callAdminVehiclesFunction({ ...authPayload(), action: 'delete', id });
      allVehicles = allVehicles.filter(v => String(v.id) !== String(id));
      renderVehicles();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert('Impossible de supprimer ce véhicule : ' + err.message);
    }
  }

  async function loadVehicles(){
    vehiclesLoadingState.style.display = 'block';
    vehiclesErrorState.style.display = 'none';
    vehicleList.style.display = 'none';
    vehiclesEmptyState.style.display = 'none';
    try{
      const data = await callAdminVehiclesFunction({ ...authPayload() });
      allVehicles = data.vehicles || [];
      vehiclesLoadingState.style.display = 'none';
      renderVehicles();
    }catch(err: any){
      console.error(err);
      vehiclesLoadingState.style.display = 'none';
      vehiclesErrorState.style.display = 'block';
      vehiclesErrorState.textContent = "Erreur de chargement : " + err.message;
    }
  }

  // --- formulaire d'ajout / modification ---

  function renderPhotoPreviews(){
    photoPreviewGrid.innerHTML = photoPreviews.map(p =>
      '<div class="photo-preview-item' + (p.uploading ? ' uploading' : '') + '" data-id="' + p.id + '">' +
        '<img src="' + p.url + '" alt="">' +
        (p.uploading ? '' : '<button type="button" class="photo-preview-remove" data-id="' + p.id + '">×</button>') +
      '</div>'
    ).join('');
    photoPreviewGrid.querySelectorAll<HTMLButtonElement>('.photo-preview-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        photoPreviews = photoPreviews.filter(p => p.id !== btn.dataset.id);
        renderPhotoPreviews();
      });
    });
  }

  async function uploadPhoto(file: File){
    if(!currentUploadFolder) currentUploadFolder = crypto.randomUUID();
    const id = 'up-' + Math.random().toString(36).slice(2);
    photoPreviews.push({ id, url: URL.createObjectURL(file), uploading: true });
    renderPhotoPreviews();
    activeUploads++;
    saveVehicleBtn.disabled = true;
    try{
      const res = await callAdminVehiclesFunction({
        ...authPayload(),
        action: 'create-upload-url',
        folder: currentUploadFolder,
        filename: file.name,
      });
      const { error } = await supabaseClient.storage.from('vehicle-photos').uploadToSignedUrl(res.path, res.token, file);
      if(error) throw error;
      const preview = photoPreviews.find(p => p.id === id);
      if(preview){ preview.url = res.publicUrl; preview.uploading = false; }
      renderPhotoPreviews();
    }catch(err: any){
      console.error(err);
      photoPreviews = photoPreviews.filter(p => p.id !== id);
      renderPhotoPreviews();
      alert("Échec de l'upload d'une photo : " + err.message);
    }finally{
      activeUploads--;
      if(activeUploads === 0) saveVehicleBtn.disabled = false;
    }
  }

  function handleFiles(files: FileList | null){
    if(!files) return;
    Array.from(files).forEach(file => uploadPhoto(file));
  }

  photoDropzone.addEventListener('click', () => photoFileInput.click());
  photoFileInput.addEventListener('change', () => { handleFiles(photoFileInput.files); photoFileInput.value = ''; });
  photoDropzone.addEventListener('dragover', (e) => { e.preventDefault(); photoDropzone.classList.add('dragover'); });
  photoDropzone.addEventListener('dragleave', () => photoDropzone.classList.remove('dragover'));
  photoDropzone.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault();
    photoDropzone.classList.remove('dragover');
    handleFiles(e.dataTransfer ? e.dataTransfer.files : null);
  });

  function openVehicleForm(vehicle?: VehicleAdmin){
    editingVehicleId = vehicle ? vehicle.id : null;
    currentUploadFolder = crypto.randomUUID();
    photoPreviews = (vehicle?.photos || []).map(url => ({ id: 'existing-' + url, url, uploading: false }));
    renderPhotoPreviews();

    vehicleForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-field]').forEach(el => {
      const key = el.dataset.field!;
      let val: unknown = vehicle ? vehicle[key] : '';
      if(Array.isArray(val)) val = (val as string[]).join(', ');
      el.value = val != null ? String(val) : '';
    });

    vehicleFormTitle.textContent = vehicle ? 'Modifier le véhicule' : 'Ajouter un véhicule';
    saveVehicleBtn.textContent = vehicle ? 'Enregistrer les modifications' : 'Ajouter le véhicule';
    addVehiclePanel.classList.add('open');
    addVehiclePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function closeVehicleForm(){
    addVehiclePanel.classList.remove('open');
    vehicleForm.reset();
    photoPreviews = [];
    renderPhotoPreviews();
    editingVehicleId = null;
  }

  addVehicleBtn.addEventListener('click', () => openVehicleForm());
  cancelVehicleFormBtn.addEventListener('click', closeVehicleForm);

  vehicleForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if(activeUploads > 0) return;

    const fields: Record<string, unknown> = {};
    vehicleForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-field]').forEach(el => {
      const key = el.dataset.field!;
      if(VEHICLE_OPTIONS_KEYS.includes(key)){
        fields[key] = el.value.split(',').map(s => s.trim()).filter(Boolean);
      } else if(key === 'price'){
        fields[key] = el.value === '' ? null : Number(el.value);
      } else {
        fields[key] = el.value.trim();
      }
    });
    fields.photos = photoPreviews.filter(p => !p.uploading).map(p => p.url);

    saveVehicleBtn.disabled = true;
    const prevText = saveVehicleBtn.textContent;
    saveVehicleBtn.textContent = 'Enregistrement…';
    try{
      if(editingVehicleId){
        await callAdminVehiclesFunction({ ...authPayload(), action: 'update-details', id: editingVehicleId, fields });
      } else {
        await callAdminVehiclesFunction({ ...authPayload(), action: 'create', fields });
      }
      closeVehicleForm();
      await loadVehicles();
    }catch(err: any){
      console.error(err);
      alert("Impossible d'enregistrer le véhicule : " + err.message);
    }finally{
      saveVehicleBtn.disabled = false;
      saveVehicleBtn.textContent = prevText;
    }
  });

  vehiclesSearchInput.addEventListener('input', renderVehicles);
  vehiclesStatusFilter.addEventListener('change', renderVehicles);
  vehiclesSortSelect.addEventListener('change', renderVehicles);

  // ============================================================
  // Facturation clients - paramètres, brouillons, émission et PDF
  // ============================================================

  function localIsoDate(date = new Date()){
    const offset = date.getTimezoneOffset() * 60_000;
    return new Date(date.getTime() - offset).toISOString().slice(0, 10);
  }

  function addInvoiceDays(dateValue: string, days: number){
    const date = new Date(dateValue + 'T12:00:00');
    date.setDate(date.getDate() + days);
    return localIsoDate(date);
  }

  function invoiceMoney(value: unknown){
    return (Number(value) || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }

  function invoiceDateLabel(value?: string | null){
    if(!value) return '-';
    const date = new Date(value + 'T12:00:00');
    return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('fr-FR');
  }

  function setInvoiceMessage(target: HTMLElement, message = '', type: 'success' | 'error' | '' = ''){
    target.textContent = message;
    target.classList.toggle('success', type === 'success');
    target.classList.toggle('error', type === 'error');
  }

  function invoiceSettingsReady(settings = currentInvoiceSettings){
    if(!settings) return false;
    return Boolean(
      settings.business_name && settings.address_line1 && settings.postal_code && settings.city &&
      settings.registration_number && settings.vat_mode &&
      (settings.vat_mode !== 'standard' || settings.vat_number)
    );
  }

  function fillInvoiceSettingsForm(settings: InvoiceSettings){
    issuerBusinessName.value = settings.business_name || 'Eleven Lease';
    issuerLegalStatus.value = settings.legal_status || 'Société en cours d’immatriculation';
    issuerAddressLine1.value = settings.address_line1 || '';
    issuerAddressLine2.value = settings.address_line2 || '';
    issuerPostalCode.value = settings.postal_code || '';
    issuerCity.value = settings.city || '';
    issuerCountry.value = settings.country || 'France';
    issuerRegistrationNumber.value = settings.registration_number || 'SIRET en cours d’attribution';
    issuerRcs.value = settings.rcs || '';
    issuerVatMode.value = settings.vat_mode || '';
    issuerVatNumber.value = settings.vat_number || '';
    issuerDefaultVatRate.value = String(settings.default_vat_rate ?? 20);
    issuerEmail.value = settings.email || 'contact@elevenlease.fr';
    issuerPhone.value = settings.phone || '';
    issuerIban.value = settings.iban || '';
    issuerBic.value = settings.bic || '';
    issuerPaymentTerms.value = String(settings.payment_terms_days ?? 0);
    syncInvoiceVatMode();
  }

  function renderInvoiceSettings(settings: InvoiceSettings){
    currentInvoiceSettings = settings;
    const ready = invoiceSettingsReady(settings);
    invoiceSettingsSummary.classList.toggle('ready', ready);
    invoiceIssuerName.textContent = settings.business_name || 'Eleven Lease';
    invoicePreviewIssuer.textContent = (settings.business_name || 'Eleven Lease').toUpperCase();
    invoiceIssuerStatus.textContent = ready
      ? [settings.registration_number, settings.vat_mode === 'exempt' ? 'TVA non applicable' : 'TVA applicable'].filter(Boolean).join(' · ')
      : 'Configuration à compléter avant la première émission.';
    issueInvoiceBtn.disabled = !ready;
    fillInvoiceSettingsForm(settings);
  }

  function syncInvoiceVatMode(){
    const exempt = issuerVatMode.value === 'exempt';
    issuerVatNumber.disabled = exempt;
    issuerDefaultVatRate.disabled = exempt;
    if(exempt) issuerDefaultVatRate.value = '0';
    else if(Number(issuerDefaultVatRate.value) === 0) issuerDefaultVatRate.value = '20';
  }

  function setInvoiceVatRate(value: number){
    const normalized = String(value);
    if(!Array.from(invoiceVatRate.options).some(option => option.value === normalized)){
      invoiceVatRate.add(new Option(value.toLocaleString('fr-FR') + ' %', normalized));
    }
    invoiceVatRate.value = normalized;
  }

  function populateInvoiceLeadOptions(){
    const selected = invoiceLeadSelect.value;
    const rows = allLeads.slice().sort((a, b) => ((a.nom || '') + (a.prenom || '')).localeCompare((b.nom || '') + (b.prenom || ''), 'fr'));
    invoiceLeadSelect.innerHTML = '<option value="">Saisie manuelle</option>' + rows.map(lead => {
      const name = ((lead.prenom || '') + ' ' + (lead.nom || '')).trim() || 'Sans nom';
      return '<option value="' + escapeHtml(String(lead.id)) + '">' + escapeHtml(name + (lead.email ? ' · ' + lead.email : '')) + '</option>';
    }).join('');
    if(rows.some(lead => String(lead.id) === selected)) invoiceLeadSelect.value = selected;
  }

  function resetInvoiceForm(){
    invoiceForm.reset();
    invoiceDraftId.value = '';
    invoiceFormTitle.textContent = 'Préparer une facture';
    invoiceCustomerCountry.value = 'France';
    invoiceServicePreset.value = 'Frais de mise en relation et accompagnement commercial';
    invoiceServiceLabel.value = invoiceServicePreset.value;
    const today = localIsoDate();
    invoiceIssueDate.value = today;
    invoiceServiceDate.value = today;
    invoiceDueDate.value = addInvoiceDays(today, Number(currentInvoiceSettings?.payment_terms_days || 0));
    invoiceQuantity.value = '1';
    setInvoiceVatRate(currentInvoiceSettings?.vat_mode === 'exempt' ? 0 : Number(currentInvoiceSettings?.default_vat_rate ?? 20));
    invoiceVatRate.disabled = currentInvoiceSettings?.vat_mode === 'exempt';
    invoicePaymentMethod.value = 'virement';
    setInvoiceMessage(invoiceFormMessage);
    updateInvoicePreview();
  }

  function invoiceFormPayload(){
    return {
      draftId: invoiceDraftId.value || undefined,
      leadId: invoiceLeadSelect.value || undefined,
      customerName: invoiceCustomerName.value.trim(),
      customerEmail: invoiceCustomerEmail.value.trim(),
      customerAddressLine1: invoiceCustomerAddressLine1.value.trim(),
      customerAddressLine2: invoiceCustomerAddressLine2.value.trim(),
      customerPostalCode: invoiceCustomerPostalCode.value.trim(),
      customerCity: invoiceCustomerCity.value.trim(),
      customerCountry: invoiceCustomerCountry.value.trim() || 'France',
      serviceLabel: invoiceServiceLabel.value.trim(),
      issueDate: invoiceIssueDate.value,
      serviceDate: invoiceServiceDate.value,
      dueDate: invoiceDueDate.value,
      quantity: Number(invoiceQuantity.value || 1),
      unitPriceHt: Number(invoiceUnitPrice.value),
      vatRate: Number(invoiceVatRate.value || 0),
      paymentMethod: invoicePaymentMethod.value,
      notes: invoiceNotes.value.trim(),
    };
  }

  function updateInvoicePreview(){
    const quantity = Number(invoiceQuantity.value || 0);
    const unitPrice = Number(invoiceUnitPrice.value || 0);
    const totalHt = Math.round(quantity * unitPrice * 100) / 100;
    const vatRate = Number(invoiceVatRate.value || 0);
    const vat = Math.round(totalHt * vatRate) / 100;
    const totalTtc = totalHt + vat;
    invoicePreviewDate.textContent = invoiceDateLabel(invoiceIssueDate.value);
    invoicePreviewCustomer.textContent = invoiceCustomerName.value.trim() || 'Client à renseigner';
    invoicePreviewAddress.textContent = [invoiceCustomerAddressLine1.value.trim(), invoiceCustomerPostalCode.value.trim(), invoiceCustomerCity.value.trim()].filter(Boolean).join(', ') || 'Adresse de facturation';
    invoicePreviewService.textContent = invoiceServiceLabel.value.trim() || 'Prestation à renseigner';
    invoicePreviewHt.textContent = invoiceMoney(totalHt) + ' HT';
    invoicePreviewVat.textContent = invoiceMoney(vat);
    invoicePreviewTtc.textContent = invoiceMoney(totalTtc);
  }

  function invoiceStatusLabel(invoice: InvoiceAdmin){
    if(invoice.document_type === 'credit_note') return 'Avoir émis';
    const labels: Record<string, string> = { draft:'Brouillon', issued:'Émise', paid:'Payée', credited:'Avoir créé' };
    return labels[invoice.status] || invoice.status;
  }

  function renderInvoices(){
    const query = invoiceSearchInput.value.trim().toLowerCase();
    const status = invoiceStatusFilter.value;
    const rows = allInvoices.filter(invoice => {
      if(status && invoice.status !== status) return false;
      const haystack = [invoice.invoice_number, invoice.customer_name, invoice.customer_email, invoice.service_label].filter(Boolean).join(' ').toLowerCase();
      return !query || haystack.includes(query);
    });
    invoicesEmptyState.style.display = rows.length ? 'none' : 'block';
    invoiceHistoryList.style.display = rows.length ? 'flex' : 'none';
    invoiceHistoryList.innerHTML = rows.map(invoice => {
      const number = invoice.invoice_number || 'Brouillon';
      const statusClass = invoice.document_type === 'credit_note' ? 'credited' : invoice.status;
      const canDownload = invoice.status !== 'draft' && invoice.invoice_number;
      const actions = invoice.status === 'draft'
        ? '<button type="button" class="invoice-action-btn" data-action="edit" data-id="' + invoice.id + '">Reprendre</button>'
        : (canDownload ? '<button type="button" class="invoice-action-btn" data-action="download" data-id="' + invoice.id + '">PDF</button>' : '') +
          (invoice.document_type === 'invoice' && invoice.status === 'issued' ? '<button type="button" class="invoice-action-btn" data-action="paid" data-id="' + invoice.id + '">Marquer payée</button>' : '') +
          (invoice.document_type === 'invoice' && ['issued','paid'].includes(invoice.status) ? '<button type="button" class="invoice-action-btn danger" data-action="credit" data-id="' + invoice.id + '">Créer un avoir</button>' : '');
      return '<article class="invoice-history-item">' +
        '<div class="invoice-history-main"><strong>' + escapeHtml(invoice.customer_name) + '</strong><span>' + escapeHtml(number) + ' · ' + escapeHtml(invoice.service_label) + '</span><span class="invoice-status ' + statusClass + '">' + invoiceStatusLabel(invoice) + '</span></div>' +
        '<div class="invoice-history-date">Créée le ' + invoiceDateLabel(invoice.issue_date || invoice.created_at?.slice(0, 10)) + '<span>Échéance ' + invoiceDateLabel(invoice.due_date) + '</span></div>' +
        '<div class="invoice-history-total">' + invoiceMoney(invoice.total_ttc) + '</div>' +
        '<div class="invoice-history-actions">' + actions + '</div>' +
      '</article>';
    }).join('');

    invoiceHistoryList.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(button => {
      button.addEventListener('click', () => handleInvoiceAction(button.dataset.action || '', button.dataset.id || '', button));
    });
  }

  function loadInvoiceIntoForm(invoice: InvoiceAdmin){
    if(invoice.status !== 'draft') return;
    invoiceDraftId.value = invoice.id;
    invoiceFormTitle.textContent = 'Modifier le brouillon';
    invoiceLeadSelect.value = invoice.lead_id || '';
    invoiceCustomerName.value = invoice.customer_name || '';
    invoiceCustomerEmail.value = invoice.customer_email || '';
    invoiceCustomerAddressLine1.value = invoice.customer_address_line1 || '';
    invoiceCustomerAddressLine2.value = invoice.customer_address_line2 || '';
    invoiceCustomerPostalCode.value = invoice.customer_postal_code || '';
    invoiceCustomerCity.value = invoice.customer_city || '';
    invoiceCustomerCountry.value = invoice.customer_country || 'France';
    invoiceServicePreset.value = '';
    invoiceServiceLabel.value = invoice.service_label || '';
    invoiceIssueDate.value = invoice.issue_date || localIsoDate();
    invoiceServiceDate.value = invoice.service_date || invoiceIssueDate.value;
    invoiceDueDate.value = invoice.due_date || invoiceIssueDate.value;
    invoiceQuantity.value = String(invoice.quantity || 1);
    invoiceUnitPrice.value = String(invoice.unit_price_ht || '');
    setInvoiceVatRate(Number(invoice.vat_rate || 0));
    invoicePaymentMethod.value = invoice.payment_method || 'virement';
    invoiceNotes.value = invoice.notes || '';
    updateInvoicePreview();
    invoiceForm.scrollIntoView({ behavior:'smooth', block:'start' });
  }

  async function handleInvoiceAction(action: string, id: string, button: HTMLButtonElement){
    const invoice = allInvoices.find(item => item.id === id);
    if(!invoice) return;
    if(action === 'edit') return loadInvoiceIntoForm(invoice);
    if(action === 'download'){
      try{ await downloadInvoicePdf(invoice as InvoicePdfData); }
      catch(err: any){ alert('Impossible de générer le PDF : ' + err.message); }
      return;
    }
    const previousText = button.textContent || '';
    try{
      if(action === 'paid'){
        if(!confirm('Confirmer que la facture ' + invoice.invoice_number + ' est réglée ?')) return;
        button.disabled = true; button.textContent = 'Mise à jour…';
        await callAdminInvoicesFunction({ ...authPayload(), action:'mark-paid', id });
      }
      if(action === 'credit'){
        if(!confirm('Créer un avoir intégral pour la facture ' + invoice.invoice_number + ' ? Cette action est définitive.')) return;
        button.disabled = true; button.textContent = 'Création…';
        const result = await callAdminInvoicesFunction({ ...authPayload(), action:'credit', id, creditDate: localIsoDate() });
        if(result.invoice) await downloadInvoicePdf(result.invoice as InvoicePdfData);
      }
      await loadInvoices(true);
    }catch(err: any){
      alert(err.message || 'Impossible de mettre à jour la facture.');
    }finally{
      button.disabled = false; button.textContent = previousText;
    }
  }

  async function loadInvoices(silent = false){
    if(isPartner()) return;
    if(!silent){
      invoicesLoadingState.style.display = 'block';
      invoicesErrorState.style.display = 'none';
    }
    try{
      const data = await callAdminInvoicesFunction({ ...authPayload(), action:'list' });
      allInvoices = data.invoices || [];
      renderInvoiceSettings(data.settings as InvoiceSettings);
      populateInvoiceLeadOptions();
      if(!invoiceDraftId.value) resetInvoiceForm();
      renderInvoices();
      invoicesLoaded = true;
      invoicesLoadingState.style.display = 'none';
      if(!invoiceSettingsReady()) invoiceSettingsFormPanel.classList.add('open');
    }catch(err: any){
      invoicesLoadingState.style.display = 'none';
      invoicesErrorState.style.display = 'block';
      invoicesErrorState.textContent = 'Erreur de chargement : ' + err.message;
    }
  }

  toggleInvoiceSettingsBtn.addEventListener('click', () => invoiceSettingsFormPanel.classList.toggle('open'));
  closeInvoiceSettingsBtn.addEventListener('click', () => invoiceSettingsFormPanel.classList.remove('open'));
  issuerVatMode.addEventListener('change', syncInvoiceVatMode);

  invoiceSettingsForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const settings = {
      business_name: issuerBusinessName.value,
      legal_status: issuerLegalStatus.value,
      address_line1: issuerAddressLine1.value,
      address_line2: issuerAddressLine2.value,
      postal_code: issuerPostalCode.value,
      city: issuerCity.value,
      country: issuerCountry.value,
      registration_number: issuerRegistrationNumber.value,
      rcs: issuerRcs.value,
      vat_mode: issuerVatMode.value,
      vat_number: issuerVatNumber.value,
      default_vat_rate: Number(issuerDefaultVatRate.value || 0),
      email: issuerEmail.value,
      phone: issuerPhone.value,
      iban: issuerIban.value,
      bic: issuerBic.value,
      payment_terms_days: Number(issuerPaymentTerms.value || 0),
    };
    saveInvoiceSettingsBtn.disabled = true;
    setInvoiceMessage(invoiceSettingsMessage, 'Enregistrement…');
    try{
      const data = await callAdminInvoicesFunction({ ...authPayload(), action:'save-settings', settings });
      renderInvoiceSettings(data.settings as InvoiceSettings);
      resetInvoiceForm();
      setInvoiceMessage(invoiceSettingsMessage, 'Paramètres enregistrés.', 'success');
      window.setTimeout(() => invoiceSettingsFormPanel.classList.remove('open'), 700);
    }catch(err: any){
      setInvoiceMessage(invoiceSettingsMessage, err.message || 'Impossible d’enregistrer les paramètres.', 'error');
    }finally{
      saveInvoiceSettingsBtn.disabled = false;
    }
  });

  invoiceLeadSelect.addEventListener('change', () => {
    const lead = allLeads.find(item => String(item.id) === invoiceLeadSelect.value);
    if(lead){
      invoiceCustomerName.value = ((lead.prenom || '') + ' ' + (lead.nom || '')).trim();
      invoiceCustomerEmail.value = lead.email || '';
    }
    updateInvoicePreview();
  });
  invoiceServicePreset.addEventListener('change', () => {
    if(invoiceServicePreset.value) invoiceServiceLabel.value = invoiceServicePreset.value;
    updateInvoicePreview();
  });
  invoiceIssueDate.addEventListener('change', () => {
    invoiceDueDate.value = addInvoiceDays(invoiceIssueDate.value || localIsoDate(), Number(currentInvoiceSettings?.payment_terms_days || 0));
    updateInvoicePreview();
  });
  invoiceForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea').forEach(field => {
    field.addEventListener('input', updateInvoicePreview);
    field.addEventListener('change', updateInvoicePreview);
  });
  resetInvoiceBtn.addEventListener('click', resetInvoiceForm);
  invoiceSearchInput.addEventListener('input', renderInvoices);
  invoiceStatusFilter.addEventListener('change', renderInvoices);

  saveInvoiceDraftBtn.addEventListener('click', async () => {
    const payload = invoiceFormPayload();
    if(!payload.customerName || !payload.serviceLabel || !payload.unitPriceHt){
      setInvoiceMessage(invoiceFormMessage, 'Nom du client, prestation et montant requis pour le brouillon.', 'error');
      return;
    }
    saveInvoiceDraftBtn.disabled = true;
    setInvoiceMessage(invoiceFormMessage, 'Enregistrement du brouillon…');
    try{
      const data = await callAdminInvoicesFunction({ ...authPayload(), action:'save-draft', ...payload });
      invoiceDraftId.value = data.invoice.id;
      invoiceFormTitle.textContent = 'Modifier le brouillon';
      setInvoiceMessage(invoiceFormMessage, 'Brouillon enregistré.', 'success');
      await loadInvoices(true);
    }catch(err: any){
      setInvoiceMessage(invoiceFormMessage, err.message || 'Impossible d’enregistrer le brouillon.', 'error');
    }finally{
      saveInvoiceDraftBtn.disabled = false;
    }
  });

  invoiceForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if(!invoiceSettingsReady()){
      invoiceSettingsFormPanel.classList.add('open');
      setInvoiceMessage(invoiceFormMessage, 'Complétez d’abord les paramètres de facturation.', 'error');
      return;
    }
    if(!invoiceForm.reportValidity()) return;
    if(!confirm('Émettre cette facture ? Son numéro et son contenu deviendront définitifs.')) return;
    const payload = invoiceFormPayload();
    issueInvoiceBtn.disabled = true;
    setInvoiceMessage(invoiceFormMessage, 'Émission de la facture…');
    try{
      const data = await callAdminInvoicesFunction({ ...authPayload(), action:'issue', ...payload });
      const invoice = data.invoice as InvoicePdfData;
      try{
        await downloadInvoicePdf(invoice);
        setInvoiceMessage(invoiceFormMessage, 'Facture ' + invoice.invoice_number + ' émise et téléchargée.', 'success');
      }catch(pdfError: any){
        setInvoiceMessage(invoiceFormMessage, 'Facture émise. Le PDF peut être retéléchargé depuis l’historique.', 'error');
        console.error(pdfError);
      }
      resetInvoiceForm();
      await loadInvoices(true);
    }catch(err: any){
      setInvoiceMessage(invoiceFormMessage, err.message || 'Impossible d’émettre la facture.', 'error');
    }finally{
      issueInvoiceBtn.disabled = !invoiceSettingsReady();
    }
  });

  function applyRoleRestrictions(){
    const partner = isPartner();
    roleBadge.style.display = partner ? 'inline-flex' : 'none';
    addVehicleBtn.style.display = partner ? 'none' : 'inline-flex';
    tabInvoicesBtn.style.display = partner ? 'none' : '';
    if(partner && activeAdminTab === 'invoices') setActiveTab('leads');
  }

  function showDashboard(){
    loginScreen.style.display = 'none';
    dashboard.style.display = 'block';
    logoutBtn.style.display = 'inline-block';
    applyRoleRestrictions();
    loadLeads();
    loadMessages();
    loadVehicles();
  }

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    loginError.classList.remove('show');
    const username = usernameInput.value.trim();
    const password = passwordInput.value;
    if(!password) return;
    loginBtn.disabled = true;
    loginBtn.textContent = 'Vérification…';
    try{
      const data = await callAdminFunction({ username: username || undefined, password });
      sessionStorage.setItem('adminPassword', password);
      if(username) sessionStorage.setItem('adminUsername', username);
      sessionStorage.setItem('adminRole', data.role || 'admin');
      showDashboard();
    }catch(err: any){
      showLoginError(err.message === 'Identifiants incorrects' ? 'Identifiants incorrects.' : err.message);
    }finally{
      loginBtn.disabled = false;
      loginBtn.textContent = 'Se connecter';
    }
  });

  logoutBtn.addEventListener('click', () => {
    stopAnalyticsRefresh();
    sessionStorage.removeItem('adminPassword');
    sessionStorage.removeItem('adminUsername');
    sessionStorage.removeItem('adminRole');
    location.reload();
  });

  refreshBtn.addEventListener('click', () => {
    if(activeAdminTab === 'analytics'){
      loadAnalytics();
      return;
    }
    if(activeAdminTab === 'invoices'){
      loadInvoices();
      return;
    }
    loadLeads();
    loadMessages();
    loadVehicles();
  });
  pipelineReset.addEventListener('click', () => {
    activePipelineGroup = '';
    statusFilter.value = '';
    renderLeads();
  });
  searchInput.addEventListener('input', renderLeads);
  statusFilter.addEventListener('change', () => {
    activePipelineGroup = '';
    renderLeads();
  });
  sortSelect.addEventListener('change', renderLeads);
  messagesSearchInput.addEventListener('input', renderMessages);
  messagesStatusFilter.addEventListener('change', renderMessages);
  messagesSortSelect.addEventListener('change', renderMessages);

  // reprend la session si un mot de passe est déjà mémorisé (onglet en cours)
  if(sessionStorage.getItem('adminPassword')){
    showDashboard();
  }
</script>

</body>
</html>
