      await callAdminFunction({ ...authPayload(), resource: 'messages', action: 'delete', id });
      allMessages = allMessages.filter(m => String(m.id) !== String(id));
      renderMessages();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert('Impossible de supprimer ce message : ' + err.message);
    }
  }

  async function loadMessages(){
    messagesLoadingState.style.display = 'block';
    messagesErrorState.style.display = 'none';
    messageList.style.display = 'none';
    messagesEmptyState.style.display = 'none';
    try{
