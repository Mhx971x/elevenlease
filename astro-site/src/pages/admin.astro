      : '';
    const telHref = lead.telephone ? 'tel:' + lead.telephone.replace(/\s+/g, '') : '';
    const mailHref = lead.email ? 'mailto:' + lead.email : '';

    return (
      '<div class="lead-card" data-id="' + lead.id + '" data-status="' + escapeHtml(statusInfo.value) +
        '" style="--status-color:' + statusInfo.color + ';animation-delay:' + Math.min(index * 0.035, 0.3) + 's">' +
        '<div class="lead-card-header">' +
          '<div class="lead-avatar ' + (eligInfo.cls === 'eligible' ? 'eligible' : '') + '">' + escapeHtml(initial) + '</div>' +
          '<div class="lead-main">' +
            '<div class="lead-name-row">' +
              '<span class="lead-name">' + escapeHtml(fullName) + '</span>' +
              '<span class="badge ' + eligInfo.cls + '"><span class="badge-dot"></span>' + escapeHtml(eligInfo.label) + '</span>' +
            '</div>' +
            '<div class="lead-sub">' + escapeHtml(subLine) + '</div>' +
          '</div>' +
          '<div class="lead-meta">' +
            (isPartner()
              ? '<span class="crm-status-readonly" style="--status-color:' + statusInfo.color + '">' + escapeHtml(statusInfo.label) + '</span>'
              : '<select class="crm-status-select" data-id="' + lead.id + '" aria-label="Statut de ' + escapeHtml(fullName) +
                '" style="--status-color:' + statusInfo.color + '">' + leadStatusOptions(status) + '</select>') +
            '<span class="lead-date">' + relativeTime(lead.created_at) + '</span>' +
            CHEVRON_SVG +
          '</div>' +
        '</div>' +
        '<div class="lead-detail">' +
          '<div class="lead-detail-inner">' +
            '<div class="lead-view">' +
            '<div class="detail-grid"><div class="detail-item"><div class="d-label">Téléphone</div><div class="d-value">' + escapeHtml(lead.telephone || '-') + '</div></div>' +
              '<div class="detail-item"><div class="d-label">Email</div><div class="d-value">' + escapeHtml(lead.email || '-') + '</div></div>' +
              '<div class="detail-item"><div class="d-label">Profil</div><div class="d-value">' + escapeHtml(lead.profil || '-') + '</div></div>' +
            '</div>' +
            detailGrid +
            riskNote +
            messageBox +
            buildDocumentPortal(lead) +
            '<div class="lead-actions">' +
              '<div class="quick-actions">' +
                (telHref ? '<a class="quick-btn" href="' + telHref + '">' + PHONE_SVG + 'Appeler</a>' : '') +
                (mailHref ? '<a class="quick-btn" href="' + mailHref + '">' + MAIL_SVG + 'Email</a>' : '') +
                (isPartner() ? '' : '<button type="button" class="edit-btn" data-id="' + lead.id + '">Modifier</button>') +
                (isPartner() ? '' : '<button type="button" class="delete-btn" data-id="' + lead.id + '">Supprimer</button>') +
              '</div>' +
              '<span class="lead-stage-summary"><span style="background:' + statusInfo.color + '"></span>Étape actuelle : ' + escapeHtml(statusInfo.label) + '</span>' +
            '</div>' +
            '</div>' +
            (isPartner() ? '' : buildEditForm(lead)) +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function renderLeads(){
    const query = searchInput.value.trim().toLowerCase();
    const statusVal = statusFilter.value;
    const sortVal = sortSelect.value;

    updateStats();

    let filtered = allLeads.filter(lead => {
      if(statusVal && (lead.status || 'nouveau') !== statusVal) return false;
      if(!query) return true;
      const haystack = [
        lead.prenom, lead.nom, lead.email, lead.telephone, lead.vehicule,
        lead.entreprise, lead.siren, lead.type_vehicule_souhaite, lead.motorisation
      ]
        .filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });

    filtered = filtered.slice().sort((a, b) => {
      if(sortVal === 'name') return ((a.nom||'')+(a.prenom||'')).localeCompare((b.nom||'')+(b.prenom||''), 'fr');
      const da = new Date(a.created_at || 0), db = new Date(b.created_at || 0);
      return sortVal === 'old' ? da.getTime() - db.getTime() : db.getTime() - da.getTime();
    });

    leadResultCount.textContent = filtered.length + ' dossier' + (filtered.length > 1 ? 's' : '');

    if(filtered.length === 0){
      leadList.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }
    emptyState.style.display = 'none';
    leadList.style.display = 'flex';

    leadList.innerHTML = filtered.map((lead, i) => buildCard(lead, i)).join('');
    attachCardListeners(leadList);
  }

  function attachCardListeners(root: HTMLElement){
    root.querySelectorAll<HTMLElement>('.lead-card-header').forEach(header => {
      header.addEventListener('click', () => toggleCard(header.closest('.lead-card') as HTMLElement));
    });
    root.querySelectorAll<HTMLSelectElement>('.crm-status-select').forEach(select => {
      select.addEventListener('click', e => e.stopPropagation());
      select.addEventListener('change', e => { e.stopPropagation(); onLeadStatusChange(select); });
    });
    root.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); btn.closest('.lead-card')!.classList.add('editing'); });
    });
    root.querySelectorAll<HTMLButtonElement>('.cancel-edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); btn.closest('.lead-card')!.classList.remove('editing'); });
    });
    root.querySelectorAll<HTMLButtonElement>('.save-edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onSaveEdit(e); });
    });
    root.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDeleteLead(e); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-link-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onCreateDocumentPortal(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-revoke-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onRevokeDocumentPortal(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-download-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDownloadDocument(btn); });
    });
    root.querySelectorAll<HTMLButtonElement>('.document-delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDeleteDocument(btn); });
    });
  }

  async function copyPortalLink(url: string){
    try{
      await navigator.clipboard.writeText(url);
      alert('Lien sécurisé copié. Vous pouvez maintenant le transmettre au client.');
    }catch{
      prompt('Copiez ce lien sécurisé et transmettez-le au client :', url);
    }
  }

  async function onCreateDocumentPortal(btn: HTMLButtonElement){
    const id = btn.dataset.id!;
    if(btn.dataset.hasPortal === '1' && !confirm('Le lien actuel sera immédiatement désactivé. Générer un nouveau lien ?')) return;
    btn.disabled = true;
    try{
      const result = await callAdminFunction({ ...authPayload(), action: 'create-document-portal', id });
      const lead = allLeads.find(item => String(item.id) === String(id));
      if(lead){
        lead.document_portal = {
          ...result.portal,
          expired: false,
          documents: lead.document_portal?.documents || [],
        };
        refreshCard(lead);
      }
      await copyPortalLink(result.url);
    }catch(err: any){
      btn.disabled = false;
      alert('Impossible de créer le lien documentaire : ' + err.message);
    }
  }

  async function onRevokeDocumentPortal(btn: HTMLButtonElement){
    const id = btn.dataset.id!;
    if(!confirm('Désactiver immédiatement le lien documentaire de ce client ?')) return;
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'revoke-document-portal', id });
      const lead = allLeads.find(item => String(item.id) === String(id));
      if(lead){
        if(lead.document_portal) lead.document_portal.revoked_at = new Date().toISOString();
        refreshCard(lead);
      }
    }catch(err: any){
      btn.disabled = false;
      alert('Impossible de désactiver le lien : ' + err.message);
    }
  }

  async function onDownloadDocument(btn: HTMLButtonElement){
    btn.disabled = true;
    try{
      const result = await callAdminFunction({
        ...authPayload(),
        action: 'document-download',
        documentId: btn.dataset.documentId,
      });
      window.open(result.url, '_blank', 'noopener');
    }catch(err: any){
      alert('Impossible de télécharger le document : ' + err.message);
    }finally{
      btn.disabled = false;
    }
  }

  async function onDeleteDocument(btn: HTMLButtonElement){
    const documentId = btn.dataset.documentId!;
    if(!confirm('Supprimer définitivement ce document ?')) return;
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'delete-document', documentId });
      const card = btn.closest('.lead-card') as HTMLElement;
      const lead = allLeads.find(item => String(item.id) === String(card.dataset.id));
      if(lead?.document_portal){
        lead.document_portal.documents = (lead.document_portal.documents || [])
          .filter(document => document.id !== documentId);
        lead.document_portal.completed_at = undefined;
        refreshCard(lead);
      }
    }catch(err: any){
      btn.disabled = false;
      alert('Impossible de supprimer le document : ' + err.message);
    }
  }

  function refreshCard(lead: Lead){
    const card = leadList.querySelector('.lead-card[data-id="' + CSS.escape(String(lead.id)) + '"]');
    if(!card) return;
    const index = Array.from(leadList.children).indexOf(card);
    const wrapper = document.createElement('div');
    wrapper.innerHTML = buildCard(lead, index);
    const newCard = wrapper.firstElementChild as HTMLElement;
    if(card.classList.contains('open')){
      newCard.classList.add('open');
      const detail = newCard.querySelector('.lead-detail') as HTMLElement;
      detail.style.height = 'auto';
      detail.style.opacity = '1';
    }
    card.replaceWith(newCard);
    attachCardListeners(newCard);
  }

  async function onSaveEdit(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const card = btn.closest('.lead-card') as HTMLElement;
    const fields: Record<string, string> = {};
    card.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.lead-edit-form [data-field]').forEach(input => {
      fields[input.dataset.field!] = input.value.trim();
    });
    btn.disabled = true;
    const cancelBtn = card.querySelector('.cancel-edit-btn') as HTMLButtonElement | null;
    if(cancelBtn) cancelBtn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'update-details', id, fields });
      const lead = allLeads.find(l => String(l.id) === String(id));
      if(lead) Object.assign(lead, fields);
      updateStats();
      if(lead) refreshCard(lead);
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      if(cancelBtn) cancelBtn.disabled = false;
      alert("Impossible d'enregistrer les modifications : " + err.message);
    }
  }

  async function onDeleteLead(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const lead = allLeads.find(l => String(l.id) === String(id));
    const name = lead ? ((lead.prenom || '') + ' ' + (lead.nom || '')).trim() || 'ce lead' : 'ce lead';
    if(!confirm('Supprimer définitivement la demande de "' + name + '" ? Cette action est irréversible.')) return;
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'delete', id });
      allLeads = allLeads.filter(l => String(l.id) !== String(id));
      renderLeads();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert('Impossible de supprimer cette demande : ' + err.message);
    }
  }

  function toggleCard(card: HTMLElement){
    if(card.dataset.animating === '1') return;
    const detail = card.querySelector('.lead-detail') as HTMLElement;
    card.classList.contains('open') ? closeCard(card, detail) : openCard(card, detail);
  }

  function openCard(card: HTMLElement, detail: HTMLElement){
    card.dataset.animating = '1';
    card.classList.add('open');
    const target = detail.scrollHeight;
    detail.style.overflow = 'hidden';
    const anim = detail.animate(
      [{ height: '0px', opacity: 0 }, { height: target + 'px', opacity: 1 }],
      { duration: 320, easing: cardEasing }
    );
    anim.onfinish = () => {
      detail.style.overflow = '';
      detail.style.height = '';
      card.dataset.animating = '';
    };
  }

  function closeCard(card: HTMLElement, detail: HTMLElement){
    card.dataset.animating = '1';
    const start = detail.scrollHeight;
    detail.style.overflow = 'hidden';
    const anim = detail.animate(
      [{ height: start + 'px', opacity: 1 }, { height: '0px', opacity: 0 }],
      { duration: 280, easing: cardEasing }
    );
    anim.onfinish = () => {
      card.classList.remove('open');
      detail.style.overflow = '';
      detail.style.height = '';
      card.dataset.animating = '';
    };
  }

  async function onLeadStatusChange(select: HTMLSelectElement){
    const id = select.dataset.id!;
    const lead = allLeads.find(item => String(item.id) === String(id));
    const previousStatus = lead?.status || 'nouveau';
    const newStatus = select.value;
    select.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), action: 'update-status', id, status: newStatus });
      if(lead) lead.status = newStatus;
      renderLeads();
    }catch(err: any){
      console.error(err);
      select.value = previousStatus;
      select.disabled = false;
      alert("Impossible de mettre à jour le statut : " + err.message);
    }
  }

  async function loadLeads(){
    loadingState.style.display = 'block';
    errorState.style.display = 'none';
    leadList.style.display = 'none';
    emptyState.style.display = 'none';
    try{
      const data = await callAdminFunction({ ...authPayload() });
      allLeads = data.leads || [];
      loadingState.style.display = 'none';
      lastRefresh.textContent = 'Actualisé à ' + new Date().toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit' });
      renderLeads();
    }catch(err: any){
      console.error(err);
      loadingState.style.display = 'none';
      errorState.style.display = 'block';
      errorState.textContent = "Erreur de chargement : " + err.message;
    }
  }

  // ============================================================
  // Onglet "Messages de contact" — même logique que les leads, en plus
  // simple (pas de formulaire d'édition, pas d'éligibilité).
  // ============================================================
  function buildMessageCard(msg: ContactMessage, index: number){
    const status = msg.status || 'nouveau';
    const fullName = (msg.nom || '').trim() || 'Sans nom';
    const initial = (msg.nom || '?').trim().charAt(0).toUpperCase();
    const subLine = [msg.email, msg.telephone].filter(Boolean).join(' · ') || 'Aucun contact renseigné';
    const messageBox = msg.message
      ? '<div class="lead-message-box"><span class="d-label">Message</span>' + escapeHtml(msg.message) + '</div>'
      : '';
    const telHref = msg.telephone ? 'tel:' + msg.telephone.replace(/\s+/g, '') : '';
    const mailHref = msg.email ? 'mailto:' + msg.email : '';

    return (
      '<div class="lead-card" data-id="' + msg.id + '" style="animation-delay:' + Math.min(index * 0.035, 0.3) + 's">' +
        '<div class="lead-card-header">' +
          '<div class="lead-avatar">' + escapeHtml(initial) + '</div>' +
          '<div class="lead-main">' +
            '<div class="lead-name-row">' +
              '<span class="lead-name">' + escapeHtml(fullName) + '</span>' +
              '<span class="status-pill ' + status + '">' + (status === 'traite' ? 'Traité' : 'À traiter') + '</span>' +
            '</div>' +
            '<div class="lead-sub">' + escapeHtml(subLine) + '</div>' +
          '</div>' +
          '<div class="lead-meta">' +
            '<span class="lead-date">' + relativeTime(msg.created_at) + '</span>' +
            CHEVRON_SVG +
          '</div>' +
        '</div>' +
        '<div class="lead-detail">' +
          '<div class="lead-detail-inner">' +
            messageBox +
            '<div class="lead-actions">' +
              '<div class="quick-actions">' +
                (telHref ? '<a class="quick-btn" href="' + telHref + '">' + PHONE_SVG + 'Appeler</a>' : '') +
                (mailHref ? '<a class="quick-btn" href="' + mailHref + '">' + MAIL_SVG + 'Email</a>' : '') +
                (isPartner() ? '' : '<button type="button" class="delete-btn" data-id="' + msg.id + '">Supprimer</button>') +
              '</div>' +
              (isPartner() ? '' : '<button class="status-btn ' + status + '" data-id="' + msg.id + '" data-status="' + status + '"><span class="dot"></span>' + (status === 'traite' ? 'Marquer comme à traiter' : 'Marquer comme traité') + '</button>') +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function renderMessages(){
    const query = messagesSearchInput.value.trim().toLowerCase();
    const statusVal = messagesStatusFilter.value;
    const sortVal = messagesSortSelect.value;

    updateMessagesStats();

    let filtered = allMessages.filter(msg => {
      if(statusVal && (msg.status || 'nouveau') !== statusVal) return false;
      if(!query) return true;
      const haystack = [msg.nom, msg.email, msg.telephone].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(query);
    });

    filtered = filtered.slice().sort((a, b) => {
      if(sortVal === 'name') return (a.nom || '').localeCompare(b.nom || '', 'fr');
      const da = new Date(a.created_at || 0), db = new Date(b.created_at || 0);
      return sortVal === 'old' ? da.getTime() - db.getTime() : db.getTime() - da.getTime();
    });

    if(filtered.length === 0){
      messageList.style.display = 'none';
      messagesEmptyState.style.display = 'block';
      return;
    }
    messagesEmptyState.style.display = 'none';
    messageList.style.display = 'flex';

    messageList.innerHTML = filtered.map((msg, i) => buildMessageCard(msg, i)).join('');
    attachMessageCardListeners(messageList);
  }

  function attachMessageCardListeners(root: HTMLElement){
    root.querySelectorAll<HTMLElement>('.lead-card-header').forEach(header => {
      header.addEventListener('click', () => toggleCard(header.closest('.lead-card') as HTMLElement));
    });
    root.querySelectorAll<HTMLButtonElement>('.status-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onToggleMessageStatus(e); });
    });
    root.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); onDeleteMessage(e); });
    });
  }

  function refreshMessageCard(msg: ContactMessage){
    const card = messageList.querySelector('.lead-card[data-id="' + CSS.escape(String(msg.id)) + '"]');
    if(!card) return;
    const index = Array.from(messageList.children).indexOf(card);
    const wrapper = document.createElement('div');
    wrapper.innerHTML = buildMessageCard(msg, index);
    const newCard = wrapper.firstElementChild as HTMLElement;
    if(card.classList.contains('open')){
      newCard.classList.add('open');
      const detail = newCard.querySelector('.lead-detail') as HTMLElement;
      detail.style.height = 'auto';
      detail.style.opacity = '1';
    }
    card.replaceWith(newCard);
    attachMessageCardListeners(newCard);
  }

  async function onToggleMessageStatus(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const currentStatus = btn.dataset.status;
    const newStatus = currentStatus === 'traite' ? 'nouveau' : 'traite';
    btn.disabled = true;
    try{
      await callAdminFunction({ ...authPayload(), resource: 'messages', action: 'update-status', id, status: newStatus });
      const msg = allMessages.find(m => String(m.id) === String(id));
      if(msg) msg.status = newStatus;
      renderMessages();
    }catch(err: any){
      console.error(err);
      btn.disabled = false;
      alert("Impossible de mettre à jour le statut : " + err.message);
    }
  }

  async function onDeleteMessage(e: Event){
    const btn = e.currentTarget as HTMLButtonElement;
    const id = btn.dataset.id!;
    const msg = allMessages.find(m => String(m.id) === String(id));
    const name = msg ? (msg.nom || '').trim() || 'ce message' : 'ce message';
    if(!confirm('Supprimer définitivement le message de "' + name + '" ? Cette action est irréversible.')) return;
