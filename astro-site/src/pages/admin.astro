---
// Espace admin interne — pas de layout partagé (pas de nav publique,
// pas d'indexation) : head minimal construit directement ici.
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Espace admin | Eleven Lease</title>
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#ffffff;
    --surface:#f6f6f7;
    --surface-2:#eeeef1;
    --border:#e4e4e8;
    --text:#111113;
    --text-dim:#5a5a62;
    --text-faint:#96969e;
    --accent-1:#ff007f;
    --accent-2:#8d0a32;
    --accent:linear-gradient(135deg,var(--accent-1),var(--accent-2));
    --shadow-sm:0 1px 2px rgba(17,17,19,0.04), 0 1px 1px rgba(17,17,19,0.03);
    --shadow-md:0 12px 32px rgba(17,17,19,0.08), 0 2px 8px rgba(17,17,19,0.04);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{
    background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;
    line-height:1.5;min-height:100vh;
  }
  h1,h2,.display{font-family:'Space Grotesk',sans-serif;font-weight:700;letter-spacing:-0.02em;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1080px;margin:0 auto;padding:0 32px;}
  @media(max-width:768px){ .wrap{padding:0 20px;} }

  header{border-bottom:1px solid var(--border);padding:18px 0;}
  .header-row{display:flex;align-items:center;justify-content:space-between;}
  .logo{display:flex;align-items:center;gap:10px;}
  .logo-icon{width:106px;height:46px;background-image:url('/eleven-lease-logo-light.png');background-repeat:no-repeat;background-size:contain;background-position:center;flex:none;}
  .logo-tag{font-size:12px;color:var(--text-faint);border-left:1px solid var(--border);padding-left:14px;margin-left:4px;}
  .btn-ghost{
    border:1px solid var(--border);padding:9px 18px;border-radius:100px;
    font-weight:600;font-size:13.5px;color:var(--text);background:none;cursor:pointer;
    transition:border-color .2s ease, transform .2s ease;
  }
  .btn-ghost:hover{border-color:#b8b8c2;transform:translateY(-1px);}
  .btn-primary{
    background:var(--accent);color:#fff;padding:10px 22px;border-radius:100px;border:none;
    font-weight:600;font-size:13.5px;cursor:pointer;display:inline-block;font-family:inherit;
    transition:transform .2s ease, filter .2s ease;
  }
  .btn-primary:hover{filter:brightness(1.12);transform:translateY(-1px);}
  .btn-primary:active{transform:scale(.97);}
  .btn-primary:disabled{opacity:.5;cursor:default;transform:none;}

  /* login screen */
  #loginScreen{min-height:calc(100vh - 66px);display:flex;align-items:center;justify-content:center;padding:32px;}
  .login-card{
    width:100%;max-width:380px;border:1px solid var(--border);border-radius:20px;
    padding:40px 34px;background:var(--surface);box-shadow:var(--shadow-md);
    animation:fadeUp .6s cubic-bezier(.16,1,.3,1) both;
  }
  @keyframes fadeUp{ from{opacity:0;transform:translateY(16px);} to{opacity:1;transform:translateY(0);} }
  .login-card h1{font-size:22px;margin-bottom:8px;}
  .login-card p{color:var(--text-dim);font-size:14px;margin-bottom:26px;}
  .login-card input{
    width:100%;background:var(--bg);border:1px solid var(--border);border-radius:10px;
    padding:13px 16px;color:var(--text);font-size:15px;font-family:inherit;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  .login-card input:focus{outline:none;border-color:var(--accent-1);box-shadow:0 0 0 3px rgba(255,0,127,0.15);}
  .login-card .btn-primary{width:100%;margin-top:16px;padding:13px 22px;}
  .login-error{color:#dc2626;font-size:13px;margin-top:14px;display:none;}
  .login-error.show{display:block;}

  /* dashboard */
  #dashboard{display:none;padding:40px 0 80px;}
  .dash-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px;margin-bottom:28px;}
  .dash-head h1{font-size:clamp(24px,3vw,32px);}
  .dash-head p{color:var(--text-dim);font-size:14px;margin-top:6px;}
  .dash-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}

  /* tabs */
  .tab-bar{display:flex;gap:10px;margin-bottom:24px;flex-wrap:wrap;}
  .tab-btn{
    display:inline-flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:var(--text-dim);
    background:var(--surface);border:1px solid var(--border);border-radius:100px;padding:10px 18px;
    cursor:pointer;font-family:inherit;transition:border-color .2s ease, color .2s ease, background .2s ease, transform .2s ease;
  }
  .tab-btn:hover{border-color:#b8b8c2;transform:translateY(-1px);}
  .tab-btn.active{background:var(--accent);color:#fff;border-color:transparent;}
  .tab-count{
    display:none;align-items:center;justify-content:center;min-width:19px;height:19px;padding:0 5px;
    border-radius:100px;background:var(--accent-1);color:#fff;font-size:11px;font-weight:700;line-height:1;
  }
  .tab-btn.active .tab-count{background:rgba(255,255,255,0.28);}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}

  /* stats */
  .stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:26px;}
  @media(max-width:640px){ .stats-row{grid-template-columns:1fr 1fr;} }
  .stats-row-3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:26px;}
  @media(max-width:640px){ .stats-row-3{grid-template-columns:1fr;} }
  .stat-card{
    border:1px solid var(--border);border-radius:14px;padding:18px 20px;background:var(--surface);box-shadow:var(--shadow-sm);
    opacity:0;transform:translateY(10px);transition:opacity .5s cubic-bezier(.16,1,.3,1), transform .5s cubic-bezier(.16,1,.3,1), border-color .25s ease;
  }
  .stat-card.in{opacity:1;transform:translateY(0);}
  .stat-card.in:hover{border-color:#c8c8d0;transform:translateY(-3px);}
  .stat-card .num{font-family:'Space Grotesk',sans-serif;font-size:26px;font-weight:700;}
  .stat-card .label{font-size:12.5px;color:var(--text-dim);margin-top:4px;}
  .stat-card.accent .num{color:var(--accent-1);}

  /* toolbar */
  .toolbar{display:flex;gap:10px;margin-bottom:22px;flex-wrap:wrap;}
  .toolbar input, .toolbar select{
    background:var(--surface);border:1px solid var(--border);border-radius:10px;
    padding:10px 14px;color:var(--text);font-size:14px;font-family:inherit;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  .toolbar input{flex:1;min-width:200px;}
  .toolbar input:focus, .toolbar select:focus{outline:none;border-color:var(--accent-1);box-shadow:0 0 0 3px rgba(255,0,127,0.15);}

  /* lead cards */
  .lead-list{display:flex;flex-direction:column;gap:10px;}
  .lead-card{
    border:1px solid var(--border);border-radius:16px;background:var(--surface);overflow:hidden;box-shadow:var(--shadow-sm);
    opacity:0;animation:cardIn .45s cubic-bezier(.16,1,.3,1) forwards;
    transition:border-color .25s ease, box-shadow .25s ease;
  }
  .lead-card:hover{border-color:#d4d4da;box-shadow:var(--shadow-md);}
  @keyframes cardIn{ from{opacity:0;transform:translateY(8px);} to{opacity:1;transform:translateY(0);} }

  .lead-card-header{display:flex;align-items:center;gap:16px;padding:16px 20px;cursor:pointer;user-select:none;}
  .lead-avatar{
    width:38px;height:38px;border-radius:50%;background:var(--surface-2);border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;
    font-weight:700;font-size:14px;flex:none;color:var(--text-dim);transition:background .25s ease, color .25s ease;
  }
  .lead-avatar.eligible{background:var(--accent);color:#fff;border-color:transparent;}
  .lead-main{flex:1;min-width:0;}
  .lead-name-row{display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
  .lead-name{font-weight:600;font-size:15px;}
  .lead-sub{font-size:13px;color:var(--text-dim);margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .lead-meta{text-align:right;flex:none;display:flex;align-items:center;gap:14px;}
  .lead-date{font-size:12px;color:var(--text-faint);white-space:nowrap;}
  .lead-chevron{transition:transform .35s cubic-bezier(.16,1,.3,1);color:var(--text-faint);flex:none;}
  .lead-card.open .lead-chevron{transform:rotate(180deg);}
  .lead-card.open{border-color:#c8c8d0;}

  .lead-detail{height:0;opacity:0;overflow:hidden;}
  .lead-card.open .lead-detail{height:auto;opacity:1;}
  .lead-detail-inner{padding:2px 20px 22px;border-top:1px solid var(--border);margin:0 0 0;padding-top:18px;}

  .detail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px 20px;margin-bottom:18px;}
  .detail-item .d-label{font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--text-faint);margin-bottom:4px;}
  .detail-item .d-value{font-size:14px;color:var(--text);}

  .risk-note, .lead-message-box{
    background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:13px 15px;
    font-size:13.5px;color:var(--text-dim);line-height:1.6;margin-bottom:14px;
  }
  .risk-note{border-color:#e8d0d0;}
  .risk-note .d-label, .lead-message-box .d-label{
    font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--text-faint);margin-bottom:6px;display:block;
  }

  .lead-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-top:4px;}
  .quick-actions{display:flex;gap:8px;flex-wrap:wrap;}
  .quick-btn{
    display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;
    padding:8px 14px;border-radius:100px;border:1px solid var(--border);color:var(--text);background:none;
    transition:border-color .2s ease, transform .2s ease;
  }
  .quick-btn:hover{border-color:#a0a0ac;transform:translateY(-1px);}

  .badge{
    display:inline-flex;align-items:center;gap:6px;font-size:11.5px;padding:4px 11px;
    border-radius:100px;border:1px solid var(--border);white-space:nowrap;
  }
  .badge.eligible{background:var(--accent);color:#fff;border-color:transparent;}
  .badge.complex{color:var(--text-dim);}
  .badge.neutral{color:var(--text-faint);}
  .badge-dot{width:5px;height:5px;border-radius:50%;background:currentColor;flex:none;}

  .status-pill{
    font-size:11px;font-weight:600;padding:4px 10px;border-radius:100px;border:1px solid var(--border);
    color:var(--text-faint);white-space:nowrap;
  }
  .status-pill.traite{color:var(--text-dim);}
  .status-pill.nouveau{color:var(--accent-1);border-color:var(--accent-1);}

  .status-btn{
    display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;
    padding:8px 15px;border-radius:100px;border:1px solid var(--border);background:none;color:var(--text-dim);
    cursor:pointer;font-family:inherit;transition:border-color .25s ease, color .25s ease, background .25s ease;
  }
  .status-btn .dot{width:7px;height:7px;border-radius:50%;background:var(--text-faint);transition:background .25s ease;flex:none;}
  .status-btn.nouveau{color:var(--accent-1);border-color:var(--accent-1);}
  .status-btn.nouveau .dot{background:var(--accent-1);}
  .status-btn:hover{border-color:#a0a0ac;}
  .status-btn:disabled{opacity:.5;cursor:default;}

  .edit-btn, .delete-btn{
    display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;
    padding:8px 15px;border-radius:100px;border:1px solid var(--border);background:none;color:var(--text-dim);
    cursor:pointer;font-family:inherit;transition:border-color .2s ease, color .2s ease, transform .2s ease;
  }
  .edit-btn:hover{border-color:#a0a0ac;color:var(--text);transform:translateY(-1px);}
  .delete-btn:hover{border-color:#dc2626;color:#dc2626;transform:translateY(-1px);}
  .edit-btn:disabled, .delete-btn:disabled{opacity:.5;cursor:default;transform:none;}

  .document-portal-box{
    margin:18px 0;padding:18px 20px;border:1px solid var(--border);border-radius:14px;background:var(--surface);
  }
  .document-portal-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;}
  .document-portal-head h3{font-size:14px;margin-bottom:4px;}
  .document-portal-head p{color:var(--text-dim);font-size:12px;line-height:1.55;}
  .document-portal-status{
    flex:none;padding:5px 10px;border-radius:99px;border:1px solid var(--border);
    color:var(--text-dim);font-size:10.5px;font-weight:700;white-space:nowrap;
  }
  .document-portal-status.complete{background:#edf9f3;border-color:#c9eadb;color:#137a51;}
  .document-portal-status.expired{color:#b42318;border-color:#f0c7c4;}
  .document-portal-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;}
  .document-link-btn,.document-revoke-btn,.document-download-btn,.document-delete-btn{
    display:inline-flex;align-items:center;padding:8px 13px;border-radius:99px;border:1px solid var(--border);
    background:#fff;color:var(--text);font:600 11.5px/1 'Inter',sans-serif;cursor:pointer;
  }
  .document-link-btn{background:var(--text);border-color:var(--text);color:#fff;}
  .document-revoke-btn,.document-delete-btn{color:#b42318;}
  .document-admin-list{display:flex;flex-direction:column;gap:7px;margin-top:14px;}
  .document-admin-item{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:10px;background:#fff;border:1px solid var(--border);}
  .document-admin-info{display:flex;flex-direction:column;min-width:0;flex:1;}
  .document-admin-info strong{font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .document-admin-info span{font-size:10px;color:var(--text-faint);}
  .document-download-btn,.document-delete-btn{padding:6px 9px;font-size:10px;}
  .document-link-btn:disabled,.document-revoke-btn:disabled,.document-download-btn:disabled,.document-delete-btn:disabled{opacity:.5;cursor:default;}

  .lead-edit-form{display:none;}
  .lead-card.editing .lead-view{display:none;}
  .lead-card.editing .lead-edit-form{display:block;}
  .edit-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px 16px;margin-bottom:16px;}
  .edit-field{display:flex;flex-direction:column;gap:6px;font-size:12px;color:var(--text-dim);}
  .edit-field-full{margin-bottom:16px;}
  .edit-field input, .edit-field textarea{
    background:var(--bg);border:1px solid var(--border);border-radius:10px;
    padding:10px 12px;color:var(--text);font-size:13.5px;font-family:inherit;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  .edit-field textarea{resize:vertical;min-height:70px;}
  .edit-field input:focus, .edit-field textarea:focus{
    outline:none;border-color:var(--accent-1);box-shadow:0 0 0 3px rgba(255,0,127,0.15);
  }
  .edit-actions{display:flex;justify-content:flex-end;gap:10px;}
  .edit-actions .btn-ghost, .edit-actions .btn-primary{padding:9px 18px;font-size:13px;}

  /* onglet véhicules : miniatures, formulaire, glisser-déposer photos */
  .vehicle-thumb{width:48px;height:36px;border-radius:8px;object-fit:cover;background:var(--surface-2);border:1px solid var(--border);flex:none;}
  .vehicle-thumb-placeholder{
    width:48px;height:36px;border-radius:8px;background:var(--surface-2);border:1px solid var(--border);flex:none;
    display:flex;align-items:center;justify-content:center;font-size:16px;
  }
  .add-vehicle-panel{display:none;margin-bottom:22px;border:1px solid var(--border);border-radius:16px;background:var(--surface);padding:22px;box-shadow:var(--shadow-md);}
  .add-vehicle-panel.open{display:block;}
  .add-vehicle-panel h2{font-size:17px;margin-bottom:18px;}
  .dropzone{
    border:2px dashed var(--border);border-radius:14px;padding:24px;text-align:center;
    color:var(--text-dim);font-size:13.5px;cursor:pointer;transition:border-color .2s ease, background .2s ease;
    margin-bottom:14px;
  }
  .dropzone:hover, .dropzone.dragover{border-color:var(--accent-1);background:rgba(255,0,127,0.05);}
  .photo-preview-grid{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px;}
  .photo-preview-item{position:relative;width:76px;height:56px;border-radius:8px;overflow:hidden;border:1px solid var(--border);background:var(--surface-2);}
  .photo-preview-item img{width:100%;height:100%;object-fit:cover;display:block;}
  .photo-preview-item.uploading{opacity:.5;}
  .photo-preview-remove{
    position:absolute;top:2px;right:2px;width:18px;height:18px;border-radius:50%;
    background:rgba(10,10,10,0.75);color:#fff;border:none;cursor:pointer;font-size:12px;line-height:1;
    display:flex;align-items:center;justify-content:center;
  }

  .empty-state, .loading-state, .error-state{
    text-align:center;padding:70px 20px;color:var(--text-dim);font-size:14.5px;
    border:1px solid var(--border);border-radius:16px;background:var(--surface);box-shadow:var(--shadow-sm);
  }
  .error-state{color:#dc2626;}
  .spinner{
    width:22px;height:22px;border-radius:50%;border:2px solid var(--border);border-top-color:var(--text);
    animation:spin .7s linear infinite;margin:0 auto 16px;
  }
  @keyframes spin{ to{transform:rotate(360deg);} }

  @media (prefers-reduced-motion: reduce){ *{animation:none !important;transition:none !important;} }
  @media(max-width:600px){
    .document-portal-head{flex-direction:column;gap:8px;}
    .document-admin-item{align-items:flex-start;flex-wrap:wrap;}
  }

  /* Mini CRM — nouvelle structure de navigation et de pilotage */
  :root{
    --crm-bg:#f3f4f6;
    --crm-dark:#18181b;
    --crm-muted:#73737d;
    --crm-green:#168653;
  }
  body{background:var(--crm-bg);}
  header{height:74px;padding:0;background:#fff;}
  header .wrap{max-width:none;height:100%;padding:0 28px;}
  .logo-icon{width:100px;}
  #dashboard{padding:0;}
  .crm-layout{min-height:calc(100vh - 74px);display:grid;grid-template-columns:248px minmax(0,1fr);}
  .crm-sidebar{
    position:sticky;top:0;height:calc(100vh - 74px);padding:28px 18px 22px;
    display:flex;flex-direction:column;background:var(--crm-dark);color:#fff;
  }
  .crm-sidebar-title{
    padding:0 11px 12px;color:#787880;font-size:10px;font-weight:800;
    letter-spacing:.12em;text-transform:uppercase;
  }
  .crm-sidebar .tab-bar{display:flex;flex-direction:column;gap:6px;margin:0;}
  .crm-sidebar .tab-btn{
    width:100%;min-height:46px;display:grid;grid-template-columns:24px 1fr auto;gap:10px;
    padding:10px 12px;border:1px solid transparent;border-radius:11px;background:transparent;
    color:#aaaab2;text-align:left;
  }
  .crm-sidebar .tab-btn:hover{border-color:#34343a;background:#222226;color:#fff;transform:none;}
  .crm-sidebar .tab-btn.active{border-color:#38383e;background:#2a2a2f;color:#fff;box-shadow:inset 3px 0 0 var(--accent-1);}
  .nav-icon{width:24px;height:24px;display:grid;place-items:center;color:#85858e;font-size:17px;}
  .crm-sidebar .tab-btn.active .nav-icon{color:#ff4fa8;}
  .crm-sidebar .tab-count{justify-self:end;background:var(--accent-1);}
  .crm-sidebar-note{
    margin-top:auto;padding:17px;border:1px solid #333338;border-radius:13px;
    background:linear-gradient(145deg,#222226,#1c1c20);display:flex;flex-direction:column;gap:6px;
  }
  .crm-sidebar-note strong{font-family:'Space Grotesk',sans-serif;font-size:12.5px;}
  .crm-sidebar-note span{color:#8e8e97;font-size:10.5px;line-height:1.55;}
  .crm-workspace{min-width:0;padding:34px clamp(24px,4vw,52px) 70px;overflow:hidden;}
  .dash-head{margin-bottom:26px;align-items:center;}
  .page-kicker{margin-bottom:6px;color:var(--accent-1);font-size:10px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;}
  .dash-head h1{font-size:30px;}
  .dash-head p{margin-top:4px;}
  .last-refresh{color:var(--text-faint);font-size:11.5px;}
  .dash-actions .btn-ghost{background:#fff;}

  .stats-row,.stats-row-3{gap:14px;margin-bottom:22px;}
  .stat-card{
    min-height:126px;padding:18px 19px;border-radius:16px;background:#fff;box-shadow:0 8px 28px rgba(24,24,27,.045);
  }
  .stat-card.accent{background:var(--crm-dark);color:#fff;border-color:var(--crm-dark);}
  .stat-card.urgent .num{color:var(--accent-1);}
  .stat-card.success .num{color:var(--crm-green);}
  .stat-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
  .stat-icon{width:26px;height:26px;border-radius:8px;background:var(--surface);display:grid;place-items:center;color:var(--text-dim);font-size:13px;}
  .stat-card.accent .stat-icon{background:#2c2c31;color:#ff4fa8;}
  .stat-trend{color:var(--text-faint);font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;}
  .stat-card .num{font-size:29px;line-height:1;}
  .stat-card .label{margin-top:7px;}
  .stat-card.accent .label{color:#a7a7af;}

  .pipeline-section{
    margin-bottom:22px;padding:20px;border:1px solid var(--border);border-radius:17px;background:#fff;
    box-shadow:0 8px 28px rgba(24,24,27,.035);
  }
  .pipeline-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px;}
  .pipeline-heading>div{display:flex;flex-direction:column;gap:3px;}
  .pipeline-heading strong{font-family:'Space Grotesk',sans-serif;font-size:14px;}
  .pipeline-heading span{color:var(--text-faint);font-size:10.5px;}
  .pipeline-reset{border:none;background:none;color:var(--accent-1);font:700 10.5px/1 'Inter',sans-serif;cursor:pointer;}
  .pipeline-overview{display:grid;grid-template-columns:repeat(9,minmax(76px,1fr));gap:7px;}
  .pipeline-step{
    position:relative;min-width:0;padding:12px 9px 11px;border:1px solid var(--border);border-radius:11px;
    background:#fafafc;color:var(--text);cursor:pointer;text-align:left;font-family:inherit;transition:.2s ease;
  }
  .pipeline-step:hover,.pipeline-step.active{border-color:var(--stage-color);background:#fff;transform:translateY(-2px);box-shadow:0 8px 18px rgba(24,24,27,.07);}
  .pipeline-dot{display:block;width:7px;height:7px;margin-bottom:10px;border-radius:50%;background:var(--stage-color);}
  .pipeline-step strong{display:block;font-family:'Space Grotesk',sans-serif;font-size:19px;line-height:1;}
  .pipeline-step>span:last-child{display:block;margin-top:5px;color:var(--text-dim);font-size:9.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

  .list-panel{
    padding:22px;border:1px solid var(--border);border-radius:18px;background:#fff;
    box-shadow:0 12px 36px rgba(24,24,27,.045);
  }
  .list-panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
  .list-panel-head>div{display:flex;align-items:baseline;gap:10px;}
  .list-panel-head h2{font-size:17px;}
  .list-panel-head span{color:var(--text-faint);font-size:11px;}
  .toolbar{gap:9px;margin-bottom:18px;padding-bottom:18px;border-bottom:1px solid var(--border);}
  .search-field{min-width:240px;display:flex;align-items:center;gap:8px;flex:1;padding:0 13px;border:1px solid var(--border);border-radius:11px;background:var(--surface);}
  .search-field>span{color:var(--text-faint);font-size:19px;}
  .toolbar .search-field input{min-width:0;width:100%;padding:10px 0;border:none;background:transparent;}
  .toolbar .search-field input:focus{box-shadow:none;}
  .toolbar select{background:#fff;}

  .lead-list{gap:9px;}
  .lead-card{position:relative;border-radius:13px;background:#fff;box-shadow:none;}
  .lead-card::before{content:"";position:absolute;left:-1px;top:15px;bottom:15px;width:3px;border-radius:0 4px 4px 0;background:var(--status-color,var(--border));}
  .lead-card:hover{border-color:#cfcfd6;box-shadow:0 9px 24px rgba(24,24,27,.06);}
  .lead-card-header{min-height:76px;padding:15px 17px 15px 20px;gap:13px;}
  .lead-avatar{width:40px;height:40px;background:#f1f1f4;}
  .lead-avatar.eligible{background:#111113;}
  .lead-name{font-size:14px;}
  .lead-sub{font-size:11.5px;}
  .lead-meta{min-width:210px;justify-content:flex-end;}
  .crm-status-select{
    max-width:158px;padding:7px 29px 7px 12px;border:1px solid color-mix(in srgb,var(--status-color) 35%,#e1e1e5);
    border-radius:999px;background-color:color-mix(in srgb,var(--status-color) 8%,#fff);
    color:var(--status-color);font:700 10.5px/1 'Inter',sans-serif;cursor:pointer;
  }
  .crm-status-select:focus{outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--status-color) 16%,transparent);}
  .crm-status-readonly{padding:7px 11px;border-radius:999px;background:#f4f4f6;color:var(--status-color);font-size:10.5px;font-weight:700;}
  .lead-date{font-size:10.5px;}
  .lead-detail-inner{margin:0;padding:22px 22px 22px 74px;background:#fafafc;}
  .detail-grid{padding:16px;border:1px solid var(--border);border-radius:12px;background:#fff;}
  .lead-stage-summary{display:inline-flex;align-items:center;gap:7px;color:var(--text-dim);font-size:10.5px;font-weight:600;}
  .lead-stage-summary>span{width:7px;height:7px;border-radius:50%;}
  .document-portal-box{background:#fff;}

  @media(max-width:1100px){
    .pipeline-overview{display:flex;overflow-x:auto;padding-bottom:4px;scrollbar-width:thin;}
    .pipeline-step{min-width:98px;}
  }
  @media(max-width:850px){
    header .wrap{padding:0 18px;}
    .crm-layout{grid-template-columns:1fr;}
    .crm-sidebar{position:static;height:auto;padding:10px 14px;}
    .crm-sidebar-title,.crm-sidebar-note{display:none;}
    .crm-sidebar .tab-bar{flex-direction:row;overflow-x:auto;}
    .crm-sidebar .tab-btn{width:auto;min-width:max-content;grid-template-columns:22px auto auto;padding:9px 12px;}
    .crm-sidebar .tab-btn.active{box-shadow:inset 0 -3px 0 var(--accent-1);}
    .crm-workspace{padding:26px 18px 55px;}
    .stats-row{grid-template-columns:repeat(2,1fr);}
  }
  @media(max-width:600px){
    header{height:64px;}
    .crm-layout{min-height:calc(100vh - 64px);}
    .logo-tag{display:none;}
    .logo-icon{width:88px;}
    .crm-workspace{padding:22px 10px 45px;}
    .dash-head{display:block;margin:0 6px 20px;}
    .dash-head h1{font-size:25px;}
    .dash-actions{margin-top:14px;justify-content:space-between;}
    .last-refresh{display:none;}
    .stats-row{gap:8px;margin-bottom:14px;}
    .stat-card{min-height:108px;padding:14px;border-radius:13px;}
    .stat-card .num{font-size:24px;}
    .pipeline-section{padding:16px 14px;margin-bottom:14px;border-radius:15px;}
    .pipeline-heading{align-items:center;}
    .pipeline-heading span{display:none;}
    .pipeline-step{min-width:91px;}
    .list-panel{padding:15px 10px;border-radius:15px;}
    .list-panel-head{margin:0 5px 14px;}
    .toolbar{display:grid;grid-template-columns:1fr 1fr;padding:0 4px 15px;}
    .search-field{grid-column:1/-1;min-width:0;}
    .toolbar select{min-width:0;width:100%;padding:10px 8px;font-size:11px;}
    .lead-card-header{align-items:flex-start;padding:14px 12px 14px 17px;gap:10px;flex-wrap:wrap;}
    .lead-avatar{width:36px;height:36px;}
    .lead-main{width:calc(100% - 50px);}
    .lead-meta{width:100%;min-width:0;padding-left:46px;justify-content:space-between;}
    .crm-status-select{max-width:180px;}
    .lead-detail-inner{padding:17px 12px;}
    .detail-grid{grid-template-columns:1fr 1fr;padding:13px;gap:13px;}
    .lead-actions{align-items:flex-start;flex-direction:column;}
  }
</style>
</head>
<body>

<header>
  <div class="wrap header-row">
    <div class="logo">
      <span class="logo-icon" role="img" aria-label="Eleven Lease"></span>      <span class="logo-tag">Espace admin</span>
    </div>
    <div style="display:flex;align-items:center;gap:14px;">
      <span class="logo-tag" id="roleBadge" style="display:none;">Lecture seule</span>
      <button class="btn-ghost" id="logoutBtn" style="display:none;">Se déconnecter</button>
    </div>
  </div>
</header>

<div id="loginScreen">
  <div class="login-card">
    <h1>Accès réservé</h1>
    <p>Entrez le mot de passe admin pour consulter les demandes reçues.</p>
    <form id="loginForm">
      <input type="text" id="usernameInput" placeholder="Identifiant (partenaires uniquement)" autocomplete="username" autofocus style="margin-bottom:10px;">
      <input type="password" id="passwordInput" placeholder="Mot de passe" autocomplete="current-password">
      <button type="submit" class="btn-primary" id="loginBtn">Se connecter</button>
      <div class="login-error" id="loginError"></div>
    </form>
  </div>
</div>

<div id="dashboard">
  <div class="crm-layout">
    <aside class="crm-sidebar">
      <div class="crm-sidebar-title">Navigation</div>
      <div class="tab-bar">
        <button type="button" class="tab-btn active" id="tabLeadsBtn">
          <span class="nav-icon">⌁</span><span>Dossiers clients</span>
          <span class="tab-count" id="leadsTabCount">0</span>
        </button>
        <button type="button" class="tab-btn" id="tabMessagesBtn">
          <span class="nav-icon">✉</span><span>Messages</span>
          <span class="tab-count" id="messagesTabCount">0</span>
        </button>
        <button type="button" class="tab-btn" id="tabVehiclesBtn">
          <span class="nav-icon">◇</span><span>Catalogue véhicules</span>
        </button>
      </div>
      <div class="crm-sidebar-note">
        <strong>Eleven Lease CRM</strong>
        <span>Centralisez les demandes, documents et étapes de chaque dossier.</span>
      </div>
    </aside>

    <main class="crm-workspace">
      <div class="dash-head">
        <div>
          <div class="page-kicker">Pilotage commercial</div>
          <h1 id="dashboardTitle">Dossiers clients</h1>
          <p id="dashboardSubtitle">Suivez chaque demande, de la simulation à la livraison.</p>
        </div>
        <div class="dash-actions">
          <span class="last-refresh" id="lastRefresh">Données à jour</span>
          <button class="btn-ghost" id="refreshBtn">↻ Actualiser</button>
        </div>
      </div>

    <div class="tab-panel active" id="leadsPanel">
      <div class="stats-row">
        <div class="stat-card accent" id="statTotalCard"><div class="stat-top"><span class="stat-icon">◎</span><span class="stat-trend">Global</span></div><div class="num" id="statTotal">0</div><div class="label">Dossiers au total</div></div>
        <div class="stat-card urgent" id="statNouveauCard"><div class="stat-top"><span class="stat-icon">+</span><span class="stat-trend">Action</span></div><div class="num" id="statNouveau">0</div><div class="label">Nouveaux leads</div></div>
        <div class="stat-card" id="statTraiteCard"><div class="stat-top"><span class="stat-icon">↗</span><span class="stat-trend">En cours</span></div><div class="num" id="statTraite">0</div><div class="label">Dossiers actifs</div></div>
        <div class="stat-card success" id="statEligibleCard"><div class="stat-top"><span class="stat-icon">✓</span><span class="stat-trend">Conversion</span></div><div class="num" id="statEligible">0</div><div class="label">Acceptés ou livrés</div></div>
      </div>

      <section class="pipeline-section">
        <div class="pipeline-heading">
          <div><strong>Pipeline des dossiers</strong><span>Cliquez sur une étape pour filtrer</span></div>
          <button type="button" class="pipeline-reset" id="pipelineReset">Voir tous les dossiers</button>
        </div>
        <div class="pipeline-overview" id="pipelineOverview"></div>
      </section>

      <div class="list-panel">
        <div class="list-panel-head">
          <div><h2>Liste des dossiers</h2><span id="leadResultCount">0 dossier</span></div>
        </div>
        <div class="toolbar">
          <label class="search-field"><span aria-hidden="true">⌕</span><input type="text" id="searchInput" placeholder="Rechercher un client, un email, un véhicule…"></label>
          <select id="statusFilter" aria-label="Filtrer par statut">
            <option value="">Tous les statuts</option>
            <option value="nouveau">Nouveau lead</option>
            <option value="contacte">Contacté</option>
            <option value="qualifie">Qualifié</option>
            <option value="documents">Documents demandés</option>
            <option value="complet">Dossier complet</option>
            <option value="etude">En étude</option>
            <option value="accepte">Accepté</option>
            <option value="refuse">Refusé</option>
            <option value="livre">Livré</option>
            <option value="traite">Traité (ancien)</option>
          </select>
          <select id="sortSelect" aria-label="Trier les dossiers">
            <option value="recent">Plus récent d'abord</option>
            <option value="old">Plus ancien d'abord</option>
            <option value="name">Par nom (A → Z)</option>
          </select>
        </div>

        <div id="loadingState" class="loading-state"><div class="spinner"></div>Chargement des demandes…</div>
        <div id="errorState" class="error-state" style="display:none;"></div>
        <div id="emptyState" class="empty-state" style="display:none;">Aucune demande ne correspond à votre recherche.</div>
        <div class="lead-list" id="leadList" style="display:none;"></div>
      </div>
    </div>

    <div class="tab-panel" id="messagesPanel">
      <div class="stats-row-3">
        <div class="stat-card accent" id="msgStatTotalCard"><div class="num" id="msgStatTotal">0</div><div class="label">Messages au total</div></div>
        <div class="stat-card accent" id="msgStatNouveauCard"><div class="num" id="msgStatNouveau">0</div><div class="label">À traiter</div></div>
        <div class="stat-card" id="msgStatTraiteCard"><div class="num" id="msgStatTraite">0</div><div class="label">Traités</div></div>
      </div>

      <div class="toolbar">
        <input type="text" id="messagesSearchInput" placeholder="Rechercher un nom, un email…">
        <select id="messagesStatusFilter">
          <option value="">Tous les statuts</option>
          <option value="nouveau">À traiter</option>
          <option value="traite">Traité</option>
        </select>
        <select id="messagesSortSelect">
          <option value="recent">Plus récent d'abord</option>
          <option value="old">Plus ancien d'abord</option>
          <option value="name">Par nom (A → Z)</option>
        </select>
      </div>

      <div id="messagesLoadingState" class="loading-state"><div class="spinner"></div>Chargement des messages…</div>
      <div id="messagesErrorState" class="error-state" style="display:none;"></div>
      <div id="messagesEmptyState" class="empty-state" style="display:none;">Aucun message ne correspond à votre recherche.</div>
      <div class="lead-list" id="messageList" style="display:none;"></div>
    </div>

    <div class="tab-panel" id="vehiclesPanel">
      <div class="stats-row-3">
        <div class="stat-card accent" id="vehStatTotalCard"><div class="num" id="vehStatTotal">0</div><div class="label">Véhicules au total</div></div>
        <div class="stat-card accent" id="vehStatActiveCard"><div class="num" id="vehStatActive">0</div><div class="label">Actifs (visibles)</div></div>
        <div class="stat-card" id="vehStatInactiveCard"><div class="num" id="vehStatInactive">0</div><div class="label">Inactifs (masqués)</div></div>
      </div>

      <div class="toolbar">
        <input type="text" id="vehiclesSearchInput" placeholder="Rechercher une marque, un modèle…">
        <select id="vehiclesStatusFilter">
          <option value="">Tous les statuts</option>
          <option value="active">Actifs</option>
          <option value="inactive">Inactifs</option>
        </select>
        <select id="vehiclesSortSelect">
          <option value="recent">Plus récent d'abord</option>
          <option value="old">Plus ancien d'abord</option>
          <option value="name">Par nom (A → Z)</option>
          <option value="price-asc">Prix croissant</option>
          <option value="price-desc">Prix décroissant</option>
        </select>
        <button type="button" class="btn-primary" id="addVehicleBtn">+ Ajouter un véhicule</button>
      </div>

      <div class="add-vehicle-panel" id="addVehiclePanel">
        <h2 id="vehicleFormTitle">Ajouter un véhicule</h2>
        <form id="vehicleForm">
          <div class="edit-grid">
            <label class="edit-field"><span>Marque *</span><input type="text" data-field="brand" required></label>
            <label class="edit-field"><span>Modèle *</span><input type="text" data-field="name" required></label>
            <label class="edit-field"><span>Finition</span><input type="text" data-field="finition"></label>
            <label class="edit-field">
              <span>Type</span>
              <select data-field="type">
                <option value="">—</option>
                <option value="citadine">Citadine</option>
                <option value="berline">Berline</option>
                <option value="suv">SUV</option>
                <option value="electrique">Électrique</option>
              </select>
            </label>
            <label class="edit-field">
              <span>État</span>
              <select data-field="condition">
                <option value="">—</option>
                <option value="neuf">Neuf</option>
                <option value="occasion">Occasion</option>
              </select>
            </label>
            <label class="edit-field"><span>Prix (€/mois)</span><input type="number" data-field="price" min="0" step="1"></label>
            <label class="edit-field"><span>Kilométrage annuel</span><input type="text" data-field="km" placeholder="Ex : 20 000 km / an"></label>
            <label class="edit-field"><span>Durée</span><input type="text" data-field="duration" placeholder="Ex : 36 mois"></label>
            <label class="edit-field"><span>Carburant</span><input type="text" data-field="fuel"></label>
            <label class="edit-field"><span>Transmission</span><input type="text" data-field="transmission"></label>
            <label class="edit-field"><span>Places</span><input type="text" data-field="places"></label>
            <label class="edit-field"><span>Année</span><input type="text" data-field="annee"></label>
            <label class="edit-field"><span>Puissance</span><input type="text" data-field="puissance"></label>
            <label class="edit-field"><span>Moteur</span><input type="text" data-field="moteur"></label>
            <label class="edit-field"><span>Autonomie électrique</span><input type="text" data-field="autonomie_elec"></label>
            <label class="edit-field"><span>Autonomie cumulée</span><input type="text" data-field="autonomie_cumulee"></label>
            <label class="edit-field"><span>Recharge DC</span><input type="text" data-field="recharge_dc"></label>
            <label class="edit-field"><span>Recharge AC</span><input type="text" data-field="recharge_ac"></label>
            <label class="edit-field"><span>Temps de charge</span><input type="text" data-field="temps_charge"></label>
            <label class="edit-field"><span>Consommation</span><input type="text" data-field="consommation"></label>
            <label class="edit-field"><span>CO2</span><input type="text" data-field="co2"></label>
            <label class="edit-field"><span>Coffre</span><input type="text" data-field="coffre"></label>
            <label class="edit-field"><span>Options confort (séparées par des virgules)</span><input type="text" data-field="options_confort"></label>
            <label class="edit-field"><span>Options extérieur</span><input type="text" data-field="options_exterieur"></label>
            <label class="edit-field"><span>Options intérieur</span><input type="text" data-field="options_interieur"></label>
            <label class="edit-field"><span>Options technologie</span><input type="text" data-field="options_technologie"></label>
          </div>
          <label class="edit-field edit-field-full"><span>Description</span><textarea data-field="description" rows="3"></textarea></label>

          <div class="edit-field-full">
            <span style="font-size:12px;color:var(--text-dim);display:block;margin-bottom:8px;">Photos</span>
            <div class="dropzone" id="photoDropzone">
              Glissez-déposez des photos ici, ou cliquez pour parcourir
              <input type="file" id="photoFileInput" accept="image/*" multiple style="display:none;">
            </div>
            <div class="photo-preview-grid" id="photoPreviewGrid"></div>
          </div>

          <div class="edit-actions">
            <button type="button" class="btn-ghost" id="cancelVehicleFormBtn">Annuler</button>
            <button type="submit" class="btn-primary" id="saveVehicleBtn">Ajouter le véhicule</button>
          </div>
        </form>
      </div>

      <div id="vehiclesLoadingState" class="loading-state"><div class="spinner"></div>Chargement des véhicules…</div>
      <div id="vehiclesErrorState" class="error-state" style="display:none;"></div>
      <div id="vehiclesEmptyState" class="empty-state" style="display:none;">Aucun véhicule ne correspond à votre recherche.</div>
      <div class="lead-list" id="vehicleList" style="display:none;"></div>
    </div>
    </main>
  </div>
</div>

<script>
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

  // ============================================================
  // Configuration Supabase — à renseigner avec les valeurs de votre
  // projet (Project Settings > API). ADMIN_FUNCTION_URL correspond à
  // l'URL de la fonction "admin-leads" une fois déployée, du type :
  // https://xxxxx.supabase.co/functions/v1/admin-leads
  // ============================================================
  const SUPABASE_URL = "https://syzlvsfhdmegmebsvscm.supabase.co";
  const SUPABASE_ANON_KEY = "sb_publishable_aF6YEQBB5UrjOrNo9RTMjw_SM3MPKvM";
  const ADMIN_FUNCTION_URL = "https://syzlvsfhdmegmebsvscm.supabase.co/functions/v1/admin-leads";
  const ADMIN_VEHICLES_FUNCTION_URL = "https://syzlvsfhdmegmebsvscm.supabase.co/functions/v1/admin-vehicles";

  interface Lead {
    id: string | number;
    status?: string;
    prenom?: string; nom?: string; email?: string; telephone?: string;
    vehicule?: string; recherche_vehicule?: string; entreprise?: string; financement?: string;
    type_vehicule_souhaite?: string; motorisation?: string; budget_souhaite?: string;
    neuf_occasion?: string; kilometrage_annuel?: string; duree_contrat?: string;
    apport?: string; date_livraison?: string; vehicule_reprise?: string;
    vehicule_reprise_details?: string; statut_pro?: string; anciennete?: string;
    revenus?: string; charges?: string; age?: string; ficp?: string;
    statut_juridique?: string; siren?: string; chiffre_affaires?: string;
    anciennete_entreprise?: string; consent_recontact?: boolean;
    eligible?: string; criteres_risque?: string; message?: string;
    confirmation_email_status?: string; confirmation_email_id?: string;
    confirmation_email_sent_at?: string; confirmation_email_error?: string;
    document_portal?: {
      id: string; expires_at: string; expired?: boolean; revoked_at?: string; completed_at?: string;
      created_at?: string; documents?: Array<{
        id: string; document_type: string; original_name: string;
        mime_type: string; size_bytes: number; uploaded_at: string;
      }>;
    } | null;
    profil?: string; created_at?: string;
    [key: string]: unknown;
  }
  interface ContactMessage {
    id: string | number;
    status?: string;
    nom?: string; email?: string; telephone?: string; message?: string; created_at?: string;
  }
  interface VehicleAdmin {
    id: string | number;
    created_at?: string; updated_at?: string; active?: boolean; slug: string;
    brand: string; name: string; type?: string; condition?: string; price?: number | null;
