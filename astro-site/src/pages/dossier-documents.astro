---
// Portail privé accessible uniquement avec un jeton dans le fragment de l'URL.
// Cette page est volontairement absente du menu et du sitemap.
import { LEGAL } from '../config/legal';
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
  <meta name="referrer" content="no-referrer">
  <title>Mon dossier sécurisé | Eleven Lease</title>
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <header class="portal-header">
    <div class="header-inner">
      <span class="logo" role="img" aria-label="Eleven Lease"></span>
      <div class="secure-label">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="5" y="10" width="14" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M8 10V7a4 4 0 018 0v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Espace sécurisé
      </div>
    </div>
  </header>

  <main>
    <section class="state-card loading-state" id="loadingState">
      <div class="spinner" aria-hidden="true"></div>
      <h1>Ouverture de votre dossier…</h1>
      <p>Nous vérifions votre lien sécurisé.</p>
    </section>

    <section class="state-card error-state" id="errorState" hidden>
      <div class="state-icon" aria-hidden="true">!</div>
      <h1>Ce dossier n’est pas accessible</h1>
      <p id="errorMessage">Le lien est invalide ou a expiré.</p>
      <a href="mailto:contact@elevenlease.fr" class="secondary-button">Contacter Eleven Lease</a>
    </section>

    <div class="portal-content" id="portalContent" hidden>
      <aside class="portal-sidebar">
        <section class="intro-card">
          <div class="eyebrow">Finalisation de votre demande</div>
          <h1 id="welcomeTitle">Complétez votre dossier</h1>
          <p class="intro-copy">
            Ajoutez les justificatifs demandés pour permettre à {LEGAL.tradeName} de préparer la mise en relation avec le partenaire chargé de l'étude définitive.
          </p>
          <div class="project-line" id="projectLine" hidden></div>
          <div class="progress-block">
            <div class="progress-ring" id="progressRing">
              <strong id="progressPercent">0 %</strong>
            </div>
            <div class="progress-copy">
              <span>Progression</span>
              <strong id="progressLabel">0 étape sur 0</strong>
              <small>Vous pouvez revenir compléter ce dossier plus tard avec le même lien.</small>
            </div>
          </div>
        </section>

        <section class="security-note">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3l8 4v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V7l8-4z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <strong>Vos documents sont en accès restreint.</strong>
            <p>Ils sont accessibles aux personnes habilitées par {LEGAL.tradeName} et peuvent être transmis au partenaire sollicité pour son étude définitive. Ne partagez pas ce lien.</p>
          </div>
        </section>
      </aside>

      <div class="portal-main">
        <section class="complete-banner" id="completeBanner" hidden>
          <div class="complete-icon" aria-hidden="true">✓</div>
          <div>
            <strong>Votre dossier est complet.</strong>
            <p>Merci, {LEGAL.tradeName} peut finaliser le pré-check et préparer la transmission au partenaire. Celui-ci reste seul décisionnaire.</p>
          </div>
        </section>

        <section class="documents-section">
          <div class="section-heading">
            <div>
              <div class="section-kicker">Vos justificatifs</div>
              <h2>Documents demandés</h2>
              <p>Sélectionnez plusieurs fichiers en une fois si nécessaire.</p>
            </div>
            <div class="format-note">PDF ou photo<br>15 Mo max.</div>
          </div>
          <div class="document-list" id="documentList"></div>
        </section>

        <section class="optional-section">
          <div>
            <div class="section-kicker">Facultatif</div>
            <h2>Un autre document utile ?</h2>
            <p>Ajoutez toute pièce complémentaire demandée par votre conseiller.</p>
          </div>
          <label class="optional-upload">
            <input type="file" id="otherFileInput" accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,.heif,application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif" multiple>
            <span>+ Ajouter des fichiers</span>
          </label>
          <div class="upload-progress" hidden>
            <div class="upload-progress-head">
              <span class="upload-progress-label">Préparation…</span>
              <strong class="upload-progress-percent">0 %</strong>
            </div>
            <div class="upload-progress-track" role="progressbar" aria-label="Progression du téléversement" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <span class="upload-progress-fill"></span>
            </div>
          </div>
          <div class="upload-feedback" aria-live="polite"></div>
          <div class="other-documents" id="otherDocuments"></div>
        </section>
      </div>
    </div>
  </main>

  <footer>
    <span>Besoin d’aide ?</span>
    <a href={`mailto:${LEGAL.email}`}>{LEGAL.email}</a>
    <span class="footer-separator">·</span>
    <a href="https://taap.it/elevenleasewhatsapp" target="_blank" rel="noopener">WhatsApp</a>
    <span class="footer-separator">·</span>
    <a href="/confidentialite" target="_blank" rel="noopener">Confidentialité</a>
    <br>
    <span>{LEGAL.operatorName} – Entrepreneur individuel · SIREN {LEGAL.siren}</span>
  </footer>

  <script>
    const SUPABASE_URL = 'https://syzlvsfhdmegmebsvscm.supabase.co';
    const SUPABASE_ANON_KEY = 'sb_publishable_aF6YEQBB5UrjOrNo9RTMjw_SM3MPKvM';
    const PORTAL_FUNCTION_URL = SUPABASE_URL + '/functions/v1/document-portal';
    const BUCKET = 'lead-documents';
    const MAX_FILE_SIZE = 15 * 1024 * 1024;

    interface Requirement {
      id: string;
      label: string;
      description: string;
    }

    interface UploadedDocument {
      id: string;
      document_type: string;
      original_name: string;
      mime_type: string;
      size_bytes: number;
      uploaded_at: string;
    }

    interface PortalData {
      portal: { expiresAt: string; completed: boolean };
      client: { firstName: string; profile: string; vehicle: string };
      requirements: Requirement[];
      documents: UploadedDocument[];
    }

    const loadingState = document.getElementById('loadingState') as HTMLElement;
    const errorState = document.getElementById('errorState') as HTMLElement;
    const errorMessage = document.getElementById('errorMessage') as HTMLElement;
    const portalContent = document.getElementById('portalContent') as HTMLElement;
    const welcomeTitle = document.getElementById('welcomeTitle') as HTMLElement;
    const projectLine = document.getElementById('projectLine') as HTMLElement;
    const progressLabel = document.getElementById('progressLabel') as HTMLElement;
    const progressPercent = document.getElementById('progressPercent') as HTMLElement;
    const progressRing = document.getElementById('progressRing') as HTMLElement;
    const completeBanner = document.getElementById('completeBanner') as HTMLElement;
    const documentList = document.getElementById('documentList') as HTMLElement;
    const otherDocuments = document.getElementById('otherDocuments') as HTMLElement;
    const otherFileInput = document.getElementById('otherFileInput') as HTMLInputElement;

    const token = location.hash.slice(1).trim();
    let portalData: PortalData | null = null;

    function escapeHtml(value: unknown){
      return String(value).replace(/[&<>"']/g, character => ({
        '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
      }[character] as string));
    }

    function formatSize(bytes: number){
      if(bytes < 1024 * 1024) return Math.max(1, Math.round(bytes / 1024)) + ' Ko';
      return (bytes / (1024 * 1024)).toFixed(1).replace('.', ',') + ' Mo';
    }

    function mimeTypeFor(file: File){
      if(file.type) return file.type.toLowerCase();
      const extension = file.name.split('.').pop()?.toLowerCase();
      const fallback: Record<string, string> = {
        pdf:'application/pdf', jpg:'image/jpeg', jpeg:'image/jpeg',
        png:'image/png', webp:'image/webp', heic:'image/heic', heif:'image/heif'
      };
      return fallback[extension || ''] || '';
    }

    async function callPortal(body: Record<string, unknown>){
      const response = await fetch(PORTAL_FUNCTION_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
        },
        body: JSON.stringify({ ...body, token }),
      });
      const data = await response.json().catch(() => ({}));
      if(!response.ok) throw new Error(data.error || 'Une erreur est survenue.');
      return data;
    }

    function showError(message: string){
      loadingState.hidden = true;
      portalContent.hidden = true;
      errorMessage.textContent = message;
      errorState.hidden = false;
    }

    function documentsFor(type: string){
      return (portalData?.documents || []).filter(document => document.document_type === type);
    }

    function uploadedFileMarkup(document: UploadedDocument){
      return (
        '<div class="uploaded-file">' +
          '<div class="file-check">✓</div>' +
          '<div class="file-info">' +
            '<strong>' + escapeHtml(document.original_name) + '</strong>' +
            '<span>' + formatSize(document.size_bytes) + '</span>' +
          '</div>' +
          '<button type="button" class="remove-file" data-document-id="' + escapeHtml(document.id) + '" aria-label="Supprimer ' + escapeHtml(document.original_name) + '">Supprimer</button>' +
        '</div>'
      );
    }

    function render(){
      if(!portalData) return;
      const total = portalData.requirements.length;
      const completeCount = portalData.requirements.filter(requirement =>
        documentsFor(requirement.id).length > 0
      ).length;
      const percent = total ? Math.round((completeCount / total) * 100) : 0;

      progressLabel.textContent = completeCount + ' étape' + (completeCount > 1 ? 's' : '') + ' sur ' + total;
      progressPercent.textContent = percent + ' %';
      progressRing.style.setProperty('--progress', (percent * 3.6) + 'deg');
      completeBanner.hidden = completeCount !== total;

      documentList.innerHTML = portalData.requirements.map((requirement, index) => {
        const files = documentsFor(requirement.id);
        const done = files.length > 0;
        const countLabel = done
          ? files.length + ' fichier' + (files.length > 1 ? 's' : '') + ' ajouté' + (files.length > 1 ? 's' : '')
          : 'À ajouter';
        return (
          '<article class="document-card ' + (done ? 'is-complete' : '') + '" data-type="' + escapeHtml(requirement.id) + '">' +
            '<div class="document-status">' + (done ? '✓' : (index + 1)) + '</div>' +
            '<div class="document-copy">' +
              '<div class="document-title-row">' +
                '<h3>' + escapeHtml(requirement.label) + '</h3>' +
                '<span class="file-count">' + countLabel + '</span>' +
              '</div>' +
              '<p>' + escapeHtml(requirement.description) + '</p>' +
              '<div class="uploaded-files">' + files.map(uploadedFileMarkup).join('') + '</div>' +
              '<label class="upload-button">' +
                '<input type="file" class="document-input" data-document-type="' + escapeHtml(requirement.id) + '" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,.heif,application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif">' +
                '<span><b>+</b> ' + (done ? 'Ajouter un autre fichier' : 'Ajouter un fichier') + '</span>' +
              '</label>' +
              '<div class="upload-progress" hidden>' +
                '<div class="upload-progress-head">' +
                  '<span class="upload-progress-label">Préparation…</span>' +
                  '<strong class="upload-progress-percent">0 %</strong>' +
                '</div>' +
                '<div class="upload-progress-track" role="progressbar" aria-label="Progression du téléversement" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">' +
                  '<span class="upload-progress-fill"></span>' +
                '</div>' +
              '</div>' +
              '<div class="upload-feedback" aria-live="polite"></div>' +
            '</div>' +
          '</article>'
        );
      }).join('');

      otherDocuments.innerHTML = documentsFor('autre').map(uploadedFileMarkup).join('');
      attachListeners();
    }

    function setCardBusy(input: HTMLInputElement, busy: boolean, message = ''){
      const card = input.closest('.document-card, .optional-section') as HTMLElement;
      const feedback = card?.querySelector('.upload-feedback') as HTMLElement | null;
      input.disabled = busy;
      card?.classList.toggle('is-uploading', busy);
      if(feedback) feedback.textContent = message;
    }

    function setUploadProgress(input: HTMLInputElement, percent: number, label: string){
      const card = input.closest('.document-card, .optional-section') as HTMLElement | null;
      const progress = card?.querySelector('.upload-progress') as HTMLElement | null;
      const track = progress?.querySelector('.upload-progress-track') as HTMLElement | null;
      const fill = progress?.querySelector('.upload-progress-fill') as HTMLElement | null;
      const progressLabel = progress?.querySelector('.upload-progress-label') as HTMLElement | null;
      const progressPercent = progress?.querySelector('.upload-progress-percent') as HTMLElement | null;
      const safePercent = Math.max(0, Math.min(100, Math.round(percent)));
      if(!progress || !track || !fill || !progressLabel || !progressPercent) return;
      progress.hidden = false;
      progressLabel.textContent = label;
      progressPercent.textContent = safePercent + ' %';
      fill.style.width = safePercent + '%';
      track.setAttribute('aria-valuenow', String(safePercent));
      track.setAttribute('aria-valuetext', label + ', ' + safePercent + ' %');
    }

    function resetUploadProgress(input: HTMLInputElement){
      const card = input.closest('.document-card, .optional-section') as HTMLElement | null;
      const progress = card?.querySelector('.upload-progress') as HTMLElement | null;
      const track = progress?.querySelector('.upload-progress-track') as HTMLElement | null;
      const fill = progress?.querySelector('.upload-progress-fill') as HTMLElement | null;
      const progressPercent = progress?.querySelector('.upload-progress-percent') as HTMLElement | null;
      if(progress) progress.hidden = true;
      if(fill) fill.style.width = '0%';
      if(progressPercent) progressPercent.textContent = '0 %';
      if(track){
        track.setAttribute('aria-valuenow', '0');
        track.removeAttribute('aria-valuetext');
      }
    }

    function uploadToSignedUrlWithProgress(
      path: string,
      uploadToken: string,
      file: File,
      onProgress: (percent: number) => void
    ){
      return new Promise<void>((resolve, reject) => {
        const cleanPath = path.split('/').filter(Boolean).map(encodeURIComponent).join('/');
        const uploadUrl = SUPABASE_URL + '/storage/v1/object/upload/sign/' +
          encodeURIComponent(BUCKET) + '/' + cleanPath + '?token=' + encodeURIComponent(uploadToken);
        const body = new FormData();
        body.append('cacheControl', '0');
        body.append('', file);
        const request = new XMLHttpRequest();
        request.open('PUT', uploadUrl);
        request.setRequestHeader('apikey', SUPABASE_ANON_KEY);
        request.setRequestHeader('Authorization', 'Bearer ' + SUPABASE_ANON_KEY);
        request.setRequestHeader('x-upsert', 'false');
        request.upload.addEventListener('progress', event => {
          if(event.lengthComputable && event.total > 0){
            onProgress((event.loaded / event.total) * 100);
          }
        });
        request.addEventListener('load', () => {
          if(request.status >= 200 && request.status < 300){
            onProgress(100);
            resolve();
            return;
          }
          let message = 'Le document n’a pas pu être envoyé.';
          try{
            const response = JSON.parse(request.responseText || '{}');
            message = response.message || response.error || message;
          }catch{}
          reject(new Error(message));
        });
        request.addEventListener('error', () => reject(new Error('Connexion interrompue pendant le téléversement.')));
        request.addEventListener('abort', () => reject(new Error('Téléversement annulé.')));
        request.send(body);
      });
    }

    async function uploadFiles(input: HTMLInputElement, documentType: string){
      const files = Array.from(input.files || []);
      if(!files.length) return;
      setCardBusy(input, true, 'Préparation du transfert…');
      setUploadProgress(input, 0, files.length > 1 ? 'Préparation de ' + files.length + ' fichiers' : 'Préparation du fichier');

      try{
        for(let index = 0; index < files.length; index++){
          const file = files[index];
          if(file.size <= 0 || file.size > MAX_FILE_SIZE){
            throw new Error(file.name + ' dépasse la limite de 15 Mo.');
          }
          const mimeType = mimeTypeFor(file);
          const filePosition = files.length > 1 ? ' · fichier ' + (index + 1) + ' sur ' + files.length : '';
          setCardBusy(input, true);
          setUploadProgress(input, 0, file.name + filePosition);
          const upload = await callPortal({
            action: 'create-upload',
            documentType,
            originalName: file.name,
            mimeType,
            size: file.size,
          });
          await uploadToSignedUrlWithProgress(
            upload.path,
            upload.uploadToken,
            file,
            percent => setUploadProgress(input, percent, file.name + filePosition)
          );
          setUploadProgress(input, 100, 'Validation de ' + file.name);
          const result = await callPortal({
            action: 'complete-upload',
            documentType,
            path: upload.path,
            originalName: file.name,
            mimeType,
            size: file.size,
          });
          portalData!.documents = result.documents || portalData!.documents;
          portalData!.portal.completed = result.completed === true;
        }
        render();
        resetUploadProgress(input);
        setCardBusy(input, false, files.length > 1 ? files.length + ' fichiers ajoutés.' : 'Fichier ajouté.');
        input.value = '';
      }catch(error: any){
        console.error(error);
        setCardBusy(input, false, error.message || 'Le document n’a pas pu être envoyé.');
        input.value = '';
        return;
      }
    }

    async function removeDocument(button: HTMLButtonElement){
      const documentId = button.dataset.documentId;
      if(!documentId || !confirm('Supprimer ce document du dossier ?')) return;
      button.disabled = true;
      try{
        const result = await callPortal({ action: 'delete-document', documentId });
        portalData!.documents = result.documents || [];
        portalData!.portal.completed = result.completed === true;
        render();
      }catch(error: any){
        button.disabled = false;
        alert(error.message || 'Le document n’a pas pu être supprimé.');
      }
    }

    function attachListeners(){
      documentList.querySelectorAll<HTMLInputElement>('.document-input').forEach(input => {
        input.addEventListener('change', () => uploadFiles(input, input.dataset.documentType || 'autre'));
      });
      document.querySelectorAll<HTMLButtonElement>('.remove-file').forEach(button => {
        button.addEventListener('click', () => removeDocument(button));
      });
    }

    otherFileInput.addEventListener('change', () => uploadFiles(otherFileInput, 'autre'));

    async function initialize(){
      if(!token){
        showError('Ce lien ne contient pas de clé d’accès. Utilisez le lien complet transmis par votre conseiller.');
        return;
      }
      try{
        portalData = await callPortal({ action: 'portal-info' }) as PortalData;
        welcomeTitle.textContent = portalData.client.firstName
          ? 'Bonjour ' + portalData.client.firstName + ', complétez votre dossier'
          : 'Complétez votre dossier';
        if(portalData.client.vehicle){
          projectLine.textContent = 'Projet : ' + portalData.client.vehicle;
          projectLine.hidden = false;
        }
        loadingState.hidden = true;
        portalContent.hidden = false;
        render();
      }catch(error: any){
        showError(error.message || 'Ce lien est invalide ou a expiré.');
      }
    }

    initialize();
  </script>
</body>
</html>

<style is:global>
  :root{
    --bg:#f4f4f6;--surface:#fff;--surface-soft:#f8f8fa;--border:#e4e4e9;
    --text:#151517;--dim:#62626b;--faint:#92929b;--pink:#f00078;--pink-dark:#a5074a;
    --green:#137a51;--green-soft:#edf9f3;--shadow:0 18px 50px rgba(25,25,28,.08);
    --radius-xs:6px;--radius-sm:10px;--radius-md:12px;--radius-lg:16px;
    --radius-xl:24px;--radius-pill:999px;--radius-round:50%;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{min-height:100vh;background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;line-height:1.5;}
  button,input{font:inherit;}
  button{cursor:pointer;}
  .portal-header{background:#fff;border-bottom:1px solid var(--border);}
  .header-inner{max-width:1120px;height:82px;margin:0 auto;padding:0 28px;display:flex;align-items:center;justify-content:space-between;}
  .logo{width:112px;height:50px;background:url('/eleven-lease-logo-light.png') center/contain no-repeat;}
  .secure-label{display:flex;align-items:center;gap:7px;padding:8px 12px;border-radius:var(--radius-pill);background:var(--green-soft);color:var(--green);font-size:12px;font-weight:700;}
  main{max-width:1120px;margin:0 auto;padding:52px 24px 72px;}
  h1,h2,h3{font-family:'Space Grotesk',sans-serif;letter-spacing:-.025em;}
  .state-card{max-width:560px;margin:70px auto;text-align:center;background:#fff;border:1px solid var(--border);border-radius:var(--radius-xl);padding:54px 34px;box-shadow:var(--shadow);}
  .state-card h1{font-size:25px;margin:18px 0 9px;}
  .state-card p{color:var(--dim);font-size:14.5px;}
  .spinner{width:30px;height:30px;margin:0 auto;border:3px solid #e7e7eb;border-top-color:var(--pink);border-radius:var(--radius-round);animation:spin .8s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .state-icon{width:42px;height:42px;margin:0 auto;border-radius:var(--radius-round);display:grid;place-items:center;background:#fff0f0;color:#c83232;font-size:22px;font-weight:700;}
  .secondary-button{display:inline-flex;margin-top:24px;padding:12px 20px;border:1px solid var(--border);border-radius:var(--radius-pill);font-size:13.5px;font-weight:600;text-decoration:none;}
  .portal-content{display:grid;grid-template-columns:minmax(280px,340px) minmax(0,1fr);gap:24px;align-items:start;}
  .portal-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
  .portal-main{min-width:0;display:flex;flex-direction:column;gap:18px;}
  .intro-card,.documents-section,.optional-section,.security-note{background:#fff;border:1px solid var(--border);border-radius:var(--radius-xl);}
  .intro-card{position:relative;overflow:hidden;padding:34px;background:#19191c;color:#fff;border:none;box-shadow:0 24px 60px rgba(25,25,28,.16);}
  .intro-card::after{content:"";position:absolute;width:250px;height:250px;right:-120px;top:-125px;border-radius:var(--radius-round);background:radial-gradient(circle,rgba(240,0,120,.35),transparent 68%);pointer-events:none;}
  .eyebrow{position:relative;z-index:1;color:#ff69b1;font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:14px;}
  .intro-card h1{position:relative;z-index:1;font-size:clamp(27px,3vw,34px);line-height:1.08;}
