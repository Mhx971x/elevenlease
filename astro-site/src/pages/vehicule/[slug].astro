<div class="toast" id="toast">Lien copié</div>

<script define:vars={{ carIcon, carouselPhotos, carouselSizes }}>
  window.__vehCarIcon = carIcon;

  const toast = document.getElementById('toast');
  function showToast(message) {
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 1800);
  }

  // carousel
  if (carouselPhotos.length > 1) {
    let current = 0;
    const img = document.getElementById('carouselImg');
    const thumbs = Array.from(document.querySelectorAll('.photo-grid-item'));
    const preloaders = carouselPhotos.slice(1).map(source => {
      const preloader = new Image();
      preloader.sizes = carouselSizes;
      preloader.srcset = source.srcset;
      preloader.src = source.src;
      return preloader;
    });
    function showPhoto(i) {
      current = (i + carouselPhotos.length) % carouselPhotos.length;
      img.src = carouselPhotos[current].src;
      img.srcset = carouselPhotos[current].srcset;
      img.dataset.fallback = carouselPhotos[current].original;
      thumbs.forEach((t, ti) => t.classList.toggle('active', ti === current));
    }
    thumbs.forEach(t => t.addEventListener('click', () => showPhoto(Number(t.dataset.index))));
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    if (prevBtn) prevBtn.addEventListener('click', () => showPhoto(current - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => showPhoto(current + 1));
  }

  // share
  const shareBtn = document.getElementById('shareBtn');
  shareBtn.addEventListener('click', async () => {
    const url = window.location.href;
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url }); } catch (e) { /* annulé */ }
    } else {
      try {
        await navigator.clipboard.writeText(url);
        showToast('Lien copié');
      } catch (e) { showToast(url); }
    }
  });

  // magnetic CTA buttons (desktop only)
  if (!window.matchMedia('(pointer: coarse)').matches) {
    document.querySelectorAll('.btn-primary:not(.vd-financing-cta)').forEach(btn => {
      btn.addEventListener('mousemove', (e) => {
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left - r.width / 2;
        const y = e.clientY - r.top - r.height / 2;
        btn.style.transform = `translate(${x * 0.18}px, ${y * 0.35}px)`;
      });
      btn.addEventListener('mouseleave', () => { btn.style.transform = 'translate(0,0)'; });
    });
  }

  // faq accordion
  const faqEasing = 'cubic-bezier(.16,1,.3,1)';
  document.querySelectorAll('.faq-item').forEach(item => {
    const summary = item.querySelector('summary');
    const content = item.querySelector('.faq-content');
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      if (item.classList.contains('is-animating')) return;
      item.open ? closeFaq(item, content) : openFaq(item, content);
    });
  });

  function openFaq(item, content) {
    item.classList.add('is-animating');
    item.open = true;
    const target = content.scrollHeight;
    content.style.overflow = 'hidden';
    const anim = content.animate(
      [{ height: '0px', opacity: 0 }, { height: target + 'px', opacity: 1 }],
      { duration: 320, easing: faqEasing }
    );
    anim.onfinish = () => {
      content.style.overflow = '';
      content.style.height = '';
      item.classList.remove('is-animating');
    };
  }

  function closeFaq(item, content) {
    item.classList.add('is-animating');
    const start = content.scrollHeight;
    content.style.overflow = 'hidden';
    const anim = content.animate(
      [{ height: start + 'px', opacity: 1 }, { height: '0px', opacity: 0 }],
      { duration: 280, easing: faqEasing }
    );
    anim.onfinish = () => {
      item.open = false;
      content.style.overflow = '';
      content.style.height = '';
      item.classList.remove('is-animating');
    };
  }
</script>

