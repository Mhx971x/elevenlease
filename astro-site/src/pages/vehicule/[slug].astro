---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchVehicles, parseDureeMonths, computeIndicativePrice, type Vehicle } from '../../lib/vehicles';

export async function getStaticPaths() {
  let vehicles: Vehicle[] = [];
  try {
    vehicles = await fetchVehicles();
  } catch (e) {
    console.error('Erreur de chargement des véhicules au build (fiches véhicule) :', e);
  }
  return vehicles.map(v => ({
    params: { slug: v.slug },
    props: { vehicle: v, allVehicles: vehicles },
  }));
}

const { vehicle: v, allVehicles } = Astro.props as { vehicle: Vehicle; allVehicles: Vehicle[] };

const pageTitle = `${v.brand} ${v.name} — Leasing LOA/LLD | Eleven Lease`;
const pageDescription = (v.description && v.description.trim())
  ? v.description.trim().slice(0, 155)
  : `Découvrez le ${v.brand} ${v.name} en leasing avec une offre indicative adaptée à votre projet. Simulation gratuite en 2 minutes, kilométrage selon l'offre.`;
const canonicalPath = `/vehicule/${v.slug}`;

const photos = v.photos.length ? v.photos : [];
const baseDuree = parseDureeMonths(v.duration);
const APPORT_STEPS = [0, 2000, 5000];

// Le prix admin reste la mensualité sans apport. Les autres scénarios et le
// prix d'appel de la fiche sont toujours dérivés de cette valeur unique.
const financingExamples = APPORT_STEPS.map(apport => ({
  apport,
  price: computeIndicativePrice(v.price, baseDuree, baseDuree, apport),
}));
const minimumMonthlyPrice = Math.min(...financingExamples.map(example => example.price));
const carouselSizes = '(max-width: 760px) calc(100vw - 36px), (max-width: 1000px) 50vw, 580px';

function getOptimizedImageUrl(
  src: string,
  width: number,
  quality = 78,
  height?: number,
  resize: 'contain' | 'cover' = 'contain',
): string {
  try {
    const url = new URL(src);
    const publicObjectPath = '/storage/v1/object/public/';
    if (!url.pathname.includes(publicObjectPath)) return src;
    url.pathname = url.pathname.replace(publicObjectPath, '/storage/v1/render/image/public/');
    url.searchParams.set('width', String(width));
    if (height) url.searchParams.set('height', String(height));
    url.searchParams.set('resize', resize);
    url.searchParams.set('quality', String(quality));
    return url.toString();
  } catch {
    return src;
  }
}

const carouselPhotos = photos.map(original => ({
  original,
  src: getOptimizedImageUrl(original, 960, 82, 654, 'contain'),
  srcset: [640, 960, 1280]
    .map(width => `${getOptimizedImageUrl(original, width, 82, Math.round(width / 1.47), 'contain')} ${width}w`)
    .join(', '),
}));

const canonicalUrl = `https://elevenlease.fr${canonicalPath}`;

const vehicleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Vehicle',
  name: `${v.brand} ${v.name}${v.finition ? ' ' + v.finition : ''}`,
  brand: { '@type': 'Brand', name: v.brand },
  model: v.name,
  description: pageDescription,
  url: canonicalUrl,
  ...(photos.length && { image: photos }),
  ...(v.finition && { vehicleConfiguration: v.finition }),
  ...(v.annee && { vehicleModelDate: v.annee }),
  ...(v.fuel && { fuelType: v.fuel }),
  ...(v.transmission && { vehicleTransmission: v.transmission }),
  ...(v.places && /^\d+$/.test(v.places) && { seatingCapacity: Number(v.places) }),
  ...(v.puissance && /^\d+$/.test(v.puissance) && {
    vehicleEngine: {
      '@type': 'EngineSpecification',
      enginePower: { '@type': 'QuantitativeValue', value: v.puissance, unitCode: 'HUR' },
    },
  }),
  ...(v.price && {
    offers: {
      '@type': 'Offer',
      url: canonicalUrl,
      priceCurrency: 'EUR',
      price: minimumMonthlyPrice,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: minimumMonthlyPrice,
        priceCurrency: 'EUR',
        unitText: 'MONTH',
      },
      businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
      seller: { '@type': 'Organization', name: 'Eleven Lease' },
    },
  }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://elevenlease.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Véhicules', item: 'https://elevenlease.fr/vehicules' },
    { '@type': 'ListItem', position: 3, name: `${v.brand} ${v.name}`, item: canonicalUrl },
  ],
};

const vehicleFaq = [
  {
    q: 'Leasing sans apport ?',
    a: "Oui. Selon votre profil, le véhicule et la solution de financement, certaines offres peuvent être proposées sans apport initial.",
  },
  {
    q: 'Dossier refusé, que faire ?',
    a: "Un refus ne signifie pas forcément la fin de votre projet. Lorsque c'est possible, votre dossier peut être étudié auprès d'autres partenaires ou orienté vers une solution plus adaptée.",
  },
  {
    q: 'Réponse en combien de temps ?',
    a: "Une première étude est généralement réalisée rapidement après réception des informations nécessaires. Notre objectif est de vous apporter une première réponse sous 24 à 48 h ouvrées.",
  },
  {
    q: 'Puis-je choisir mon véhicule ?',
    a: 'Oui. Vous pouvez nous indiquer un modèle précis ou simplement vos critères : budget, marque, type de véhicule, motorisation ou équipement.',
  },
  {
    q: 'Quels documents fournir ?',
    a: "Cela dépend de votre profil. Nous pouvons notamment demander une pièce d'identité, un justificatif de domicile, des justificatifs de revenus et certains documents bancaires ou professionnels.",
  },
  {
    q: 'Kilométrage limité ?',
    a: "Cela dépend du contrat. Les exemples présentés sur cette page sont calculés sur 20 000 km par an, tandis que des solutions avec un kilométrage différent, élevé ou illimité peuvent être disponibles selon les partenaires.",
  },
  {
    q: 'Simulation gratuite ?',
    a: "Oui. La demande de simulation et l'étude initiale sont gratuites et sans engagement. Vous restez libre d'accepter ou non la proposition reçue.",
  },
];

const vehicleReviews = [
  {
    name: 'Sofiane M.',
    initials: 'SM',
    profile: 'Particulier · Audi A3',
    text: "Réponse rapide et proposition cohérente avec mon budget. Tout m'a été expliqué clairement.",
  },
  {
    name: 'Laura D.',
    initials: 'LD',
    profile: 'Professionnelle · Utilitaire',
    text: "Je roule beaucoup pour mon activité. L'accompagnement m'a permis d'étudier une solution vraiment adaptée.",
  },
  {
    name: 'Yanis B.',
    initials: 'YB',
    profile: 'Particulier · BMW X2',
    text: "Mon dossier a été repris sérieusement et d'autres pistes ont été explorées avec moi.",
  },
];

const journeySteps = [
  { number: '1', title: 'Faites votre simulation', text: 'Indiquez vos besoins et votre budget en quelques clics.' },
  { number: '2', title: 'Nous étudions votre dossier', text: 'Votre projet est présenté aux partenaires les plus adaptés.' },
  { number: '3', title: 'Recevez votre proposition', text: 'Vous validez librement une offre claire et personnalisée.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: vehicleFaq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

function getSimilarVehicles(current: Vehicle, all: Vehicle[]): Vehicle[] {
  const others = all.filter(o => o.slug !== current.slug);
  const sameType = current.type ? others.filter(o => o.type === current.type) : [];
  const rest = others.filter(o => !sameType.includes(o));
  rest.sort((a, b) => Math.abs(a.price - current.price) - Math.abs(b.price - current.price));
  return [...sameType, ...rest].slice(0, 3);
}
const similarVehicles = getSimilarVehicles(v, allVehicles);

const carIcon = `<svg viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M20 68 L32 40 Q38 30 52 30 L140 30 Q154 30 160 40 L172 68 L172 80 Q172 84 168 84 L158 84 Q158 92 150 92 Q142 92 142 84 L58 84 Q58 92 50 92 Q42 92 42 84 L32 84 Q28 84 28 80 Z" stroke="#111113" stroke-width="2.5" fill="rgba(17,17,19,0.03)"/>
  <path d="M46 40 L54 40 L50 30" stroke="#111113" stroke-width="2.2" fill="none" stroke-linejoin="round"/>
  <line x1="52" y1="30" x2="52" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <line x1="86" y1="30" x2="86" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <line x1="120" y1="30" x2="120" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <circle cx="58" cy="84" r="10" stroke="#111113" stroke-width="2.5" fill="#f6f6f7"/>
  <circle cx="142" cy="84" r="10" stroke="#111113" stroke-width="2.5" fill="#f6f6f7"/>
  <circle cx="58" cy="84" r="3" fill="#111113"/>
  <circle cx="142" cy="84" r="3" fill="#111113"/>
</svg>`;
const shareIcon = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M8.6 10.6l6.8-3.9M8.6 13.4l6.8 3.9" stroke="currentColor" stroke-width="1.8"/></svg>`;
const chevronIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const checkIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="var(--accent-1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const phoneIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.7 3.6 4.9 6.3 6.3l2.1-2.1c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`;
const particulierIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;
const proIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 12h18" stroke="currentColor" stroke-width="1.8"/></svg>`;
const euroIcon = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M14.5 8.3c-.7-.5-1.6-.8-2.5-.8-2.2 0-4 2-4 4.5s1.8 4.5 4 4.5c.9 0 1.8-.3 2.5-.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M7 11h5.5M7 13h4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;

const specIcons: Record<string, string> = {
  fuel: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  calendar: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  gauge: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="13" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 13l4-4M12 5v1.5M4.5 13H6M18 13h1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  gear: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v2.4M12 18.6V21M21 12h-2.4M5.4 12H3M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7M18.4 18.4l-1.7-1.7M7.3 7.3L5.6 5.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  engine: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 21V6a2 2 0 012-2h6a2 2 0 012 2v15M4 21h10M4 10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 8l2.5 2.5A2 2 0 0117 12v5a1.5 1.5 0 003 0V9l-3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  battery: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="2" y="8" width="18" height="8" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M22 10v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11.5 10l-2 3h3l-2 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  road: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M8 3L4 21M16 3l4 18M12 3v3M12 10v3M12 17v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  plug: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 3v5M15 3v5M7 8h10v3a5 5 0 01-5 5 5 5 0 01-5-5V8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 16v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  clock: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  leaf: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 20c0-9 6-15 16-15 0 10-6 15-16 15z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20c4-4 8-7 16-15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  trunk: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  seats: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M6 17V6a2 2 0 012-2h2a2 2 0 012 2v11M6 17h6M16 10v7M16 10h3a2 2 0 012 2v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};

---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path={canonicalPath}
  ogImage={photos[0]}
  active="vehicules"
  promoResponseLabel="Première réponse sous 24 à 48 h ouvrées"
  promoResponseLabelCompact="Réponse 24–48 h"
>
<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify(vehicleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  {carouselPhotos[1] && <link rel="preload" as="image" href={carouselPhotos[1].src} imagesrcset={carouselPhotos[1].srcset} imagesizes={carouselSizes} />}
</Fragment>
<div id="pageContent">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <a href="/">Accueil</a><span class="crumb-sep">/</span>
      <a href="/vehicules">Véhicules</a><span class="crumb-sep">/</span>
      <span class="crumb-current">{v.brand} {v.name}</span>
      <button type="button" class="vd-share" id="shareBtn"><Fragment set:html={shareIcon} /> Partager</button>
    </nav>

    <section class="vd-hero">
      <div class="vd-media">
        <div class="vd-carousel" id="carousel">
          <span class="vd-visual-label">Visuels d'illustration</span>
          {carouselPhotos.length
            ? <img
                id="carouselImg"
                src={carouselPhotos[0].src}
                srcset={carouselPhotos[0].srcset}
                sizes={carouselSizes}
                width="1920"
                height="1080"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                data-fallback={carouselPhotos[0].original}
                alt={`${v.brand} ${v.name}`}
                onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.srcset='';this.src=this.dataset.fallback;return;}this.replaceWith(Object.assign(document.createElement('div'),{className:'carousel-icon',innerHTML:window.__vehCarIcon}))"
              />
            : <div class="carousel-icon"><Fragment set:html={carIcon} /></div>
          }
          {photos.length > 1 && (
            <>
              <button type="button" class="vd-carousel-arrow prev" id="prevBtn" aria-label="Photo précédente"><Fragment set:html={chevronIcon} /></button>
              <button type="button" class="vd-carousel-arrow next" id="nextBtn" aria-label="Photo suivante"><Fragment set:html={chevronIcon} /></button>
            </>
          )}
        </div>
        {photos.length > 1 && (
          <div class="vd-thumbnails photo-grid">
            {photos.slice(0, 5).map((p, i) => (
              <button type="button" class={`photo-grid-item ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Voir la photo ${i + 1}`}>
                <img
                  src={getOptimizedImageUrl(p, 180, 68, 124, 'cover')}
                  width="180"
                  height="124"
                  data-fallback={p}
                  alt={`${v.brand} ${v.name} — photo ${i + 1}`}
                  loading="lazy"
                  decoding="async"
                  onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback;}"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="vd-offer">
        <h1><span class="vd-title-main"><span>{v.brand}</span> {v.name}</span>{v.finition && <small class="vd-title-finish">{v.finition}</small>}</h1>
        <p class="vd-hero-meta">{[v.fuel, v.transmission].filter(Boolean).join(' · ')}</p>

        <div class="vd-price-card">
          <div class="vd-offer-badge">Offre indicative</div>
          <div class="vd-price-eyebrow">Dès</div>
          <div class="vd-price"><span class="amount">{minimumMonthlyPrice}</span><span class="currency">€</span><span class="period">/mois</span></div>
          <div class="vd-price-note">0 € d'apport possible</div>

          <div class="vd-price-facts">
            <div class="vd-price-fact"><span><Fragment set:html={specIcons.calendar} /></span><strong>{baseDuree} mois</strong></div>
            <div class="vd-price-fact"><span><Fragment set:html={specIcons.road} /></span><strong>20 000<br />km/an</strong></div>
            <div class="vd-price-fact"><span><Fragment set:html={euroIcon} /></span><strong>Selon<br />apport</strong></div>
          </div>

          <a href={`/simulation?vehicule=${encodeURIComponent(v.brand + ' ' + v.name)}`} class="vd-primary-cta btn-primary cta-with-calculator"><span class="cta-calculator-icon" aria-hidden="true"></span>Simuler mon leasing</a>
          <div class="vd-cta-proof"><span>Gratuit</span><span>Sans engagement</span><span>2 min</span></div>
          <a href="tel:+33638014986" class="vd-call"><Fragment set:html={phoneIcon} /> Parler à un conseiller</a>
        </div>
      </div>
    </section>

    <section class="vd-spec-strip" aria-label="Informations essentielles">
      <div class="vd-spec-item"><span><Fragment set:html={specIcons.fuel} /></span><p><small>Motorisation</small><strong>{v.fuel || 'Selon modèle'}</strong></p></div>
      <div class="vd-spec-item"><span><Fragment set:html={specIcons.gear} /></span><p><small>Boîte</small><strong>{v.transmission || 'Selon modèle'}</strong></p></div>
      <div class="vd-spec-item"><span><Fragment set:html={specIcons.gauge} /></span><p><small>Finition</small><strong>{v.finition || v.name}</strong></p></div>
      <div class="vd-spec-item"><span><Fragment set:html={euroIcon} /></span><p><small>Offre</small><strong>Sur étude de dossier</strong></p></div>
      <div class="vd-spec-item"><span><Fragment set:html={particulierIcon} /></span><p><small>Profils</small><strong>Particulier et professionnel</strong></p></div>
      <div class="vd-spec-item"><span><Fragment set:html={specIcons.calendar} /></span><p><small>Visuels</small><strong>Photos à titre indicatif</strong></p></div>
    </section>

    <section class="vd-offer-overview is-single">
      <article class="vd-panel vd-services">
        <header class="vd-card-head">
          <h2>Selon l'offre <span class="highlight-mark">sélectionnée</span></h2>
          <p>Les prestations exactes sont précisées dans votre proposition personnalisée.</p>
        </header>
        <div class="vd-service-grid">
          <div><span><Fragment set:html={specIcons.gear} /></span><strong>Entretien</strong></div>
          <div><span><Fragment set:html={checkIcon} /></span><strong>Garantie</strong></div>
          <div><span><Fragment set:html={phoneIcon} /></span><strong>Assistance</strong></div>
          <div><span><Fragment set:html={specIcons.leaf} /></span><strong>Services</strong></div>
        </div>
      </article>
    </section>

  </div>

  <section class="financing-section">
    <div class="wrap">
      <header class="vd-section-head">
        <h2>Votre financement en <span class="highlight-mark">exemple</span></h2>
        <p>Des solutions flexibles adaptées à votre budget.</p>
      </header>
      <div class="vd-financing-grid">
        {financingExamples.map((f, index) => (
          <div class={`vd-financing-card ${index === 0 ? 'is-featured' : ''}`}>
            {index === 0 && <span class="vd-popular">Le plus demandé</span>}
            <div class="vd-financing-label">{f.apport === 0 ? "0€ d'apport" : `${f.apport.toLocaleString('fr-FR')}€ d'apport`}</div>
