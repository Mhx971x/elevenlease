---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchVehicles, parseDureeMonths, computeIndicativePrice, type Vehicle } from '../../lib/vehicles';

export async function getStaticPaths() {
  let vehicles: Vehicle[] = [];
  try {
    vehicles = await fetchVehicles();
  } catch (e) {
    console.error('Erreur de chargement des véhicules au build (fiches véhicule) :', e);
  }
  return vehicles.map(v => ({
    params: { slug: v.slug },
    props: { vehicle: v, allVehicles: vehicles },
  }));
}

const { vehicle: v, allVehicles } = Astro.props as { vehicle: Vehicle; allVehicles: Vehicle[] };

const pageTitle = `${v.brand} ${v.name} — Leasing LOA/LLD | Eleven Lease`;
const pageDescription = (v.description && v.description.trim())
  ? v.description.trim().slice(0, 155)
  : `Découvrez le ${v.brand} ${v.name} en leasing (LOA/LLD) adapté à votre budget via le réseau de partenaires Eleven Lease. Kilométrage illimité, simulation en 2 minutes.`;
const canonicalPath = `/vehicule/${v.slug}`;

function firstSentence(desc: string, fallback: string): string {
  const trimmed = (desc || '').trim();
  if (!trimmed) return fallback;
  const match = trimmed.match(/^[^.!?]+[.!?]/);
  const sentence = (match ? match[0] : trimmed).trim();
  return sentence.length > 160 ? sentence.slice(0, 157).trimEnd() + '…' : sentence;
}
const subtitle = firstSentence(v.description, 'Leasing LOA/LLD adapté à votre budget, kilométrage illimité et réponse sous 24h.');

const photos = v.photos.length ? v.photos : [];
const baseDuree = parseDureeMonths(v.duration);

const canonicalUrl = `https://elevenlease.fr${canonicalPath}`;

const vehicleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Vehicle',
  name: `${v.brand} ${v.name}${v.finition ? ' ' + v.finition : ''}`,
  brand: { '@type': 'Brand', name: v.brand },
  model: v.name,
  description: pageDescription,
  url: canonicalUrl,
  ...(photos.length && { image: photos }),
  ...(v.finition && { vehicleConfiguration: v.finition }),
  ...(v.annee && { vehicleModelDate: v.annee }),
  ...(v.fuel && { fuelType: v.fuel }),
  ...(v.transmission && { vehicleTransmission: v.transmission }),
  ...(v.places && /^\d+$/.test(v.places) && { seatingCapacity: Number(v.places) }),
  ...(v.puissance && /^\d+$/.test(v.puissance) && {
    vehicleEngine: {
      '@type': 'EngineSpecification',
      enginePower: { '@type': 'QuantitativeValue', value: v.puissance, unitCode: 'HUR' },
    },
  }),
  itemCondition: v.condition === 'occasion' ? 'https://schema.org/UsedCondition' : 'https://schema.org/NewCondition',
  ...(v.price && {
    offers: {
      '@type': 'Offer',
      url: canonicalUrl,
      priceCurrency: 'EUR',
      price: v.price,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: v.price,
        priceCurrency: 'EUR',
        unitText: 'MONTH',
      },
      businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
      availability: 'https://schema.org/InStock',
      seller: { '@type': 'Organization', name: 'Eleven Lease' },
    },
  }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://elevenlease.fr/' },
    { '@type': 'ListItem', position: 2, name: 'Véhicules', item: 'https://elevenlease.fr/vehicules' },
    { '@type': 'ListItem', position: 3, name: `${v.brand} ${v.name}`, item: canonicalUrl },
  ],
};

const vehicleFaq = [
  {
    q: 'Peut-on financer ce véhicule sans apport ?',
    a: "Oui, il est tout à fait possible de financer ce véhicule sans apport. Nos offres de leasing sans apport sont accessibles sous réserve d'éligibilité et d'acceptation de votre dossier.",
  },
  {
    q: 'Travaillez-vous avec les professionnels ?',
    a: 'Oui, ce véhicule est disponible aussi bien pour les particuliers que pour les professionnels (auto-entrepreneurs, sociétés), avec des solutions de financement adaptées à chaque profil.',
  },
  {
    q: 'Puis-je faire reprendre mon ancien véhicule ?',
    a: 'Oui, la reprise de votre véhicule actuel peut être étudiée dans le cadre de votre dossier de financement, selon les conditions de notre partenaire.',
  },
  {
    q: 'En combien de temps ai-je un retour ?',
    a: "Notre équipe et notre réseau de partenaires vous répondent sous 24h après réception de votre demande de simulation.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: vehicleFaq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const DUREE_STEPS = [36, 48, 60];
const APPORT_STEPS = [0, 2000, 5000];

const includedItems = ['Entretien constructeur', 'Garantie constructeur', 'Assistance 24/7', 'Taxes de mise en circulation'];

const pointsForts = ['Design premium', 'Confort de conduite', 'Motorisation efficiente', 'Technologies embarquées', 'Idéal particulier et professionnel'];

// exemples de financement à durée native du véhicule (cohérent avec le prix catalogue)
const financingExamples = APPORT_STEPS.slice(0, 3).map(apport => ({
  apport,
  price: computeIndicativePrice(v.price, baseDuree, baseDuree, apport),
}));

function getSimilarVehicles(current: Vehicle, all: Vehicle[]): Vehicle[] {
  const others = all.filter(o => o.slug !== current.slug);
  const sameType = current.type ? others.filter(o => o.type === current.type) : [];
  const rest = others.filter(o => !sameType.includes(o));
  rest.sort((a, b) => Math.abs(a.price - current.price) - Math.abs(b.price - current.price));
  return [...sameType, ...rest].slice(0, 3);
}
const similarVehicles = getSimilarVehicles(v, allVehicles);

const carIcon = `<svg viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M20 68 L32 40 Q38 30 52 30 L140 30 Q154 30 160 40 L172 68 L172 80 Q172 84 168 84 L158 84 Q158 92 150 92 Q142 92 142 84 L58 84 Q58 92 50 92 Q42 92 42 84 L32 84 Q28 84 28 80 Z" stroke="#111113" stroke-width="2.5" fill="rgba(17,17,19,0.03)"/>
  <path d="M46 40 L54 40 L50 30" stroke="#111113" stroke-width="2.2" fill="none" stroke-linejoin="round"/>
  <line x1="52" y1="30" x2="52" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <line x1="86" y1="30" x2="86" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <line x1="120" y1="30" x2="120" y2="40" stroke="#111113" stroke-width="2" opacity="0.5"/>
  <circle cx="58" cy="84" r="10" stroke="#111113" stroke-width="2.5" fill="#f6f6f7"/>
  <circle cx="142" cy="84" r="10" stroke="#111113" stroke-width="2.5" fill="#f6f6f7"/>
  <circle cx="58" cy="84" r="3" fill="#111113"/>
  <circle cx="142" cy="84" r="3" fill="#111113"/>
</svg>`;
const backIcon = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const shareIcon = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M8.6 10.6l6.8-3.9M8.6 13.4l6.8 3.9" stroke="currentColor" stroke-width="1.8"/></svg>`;
const chevronIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const checkIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="var(--accent-1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const phoneIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.7 3.6 4.9 6.3 6.3l2.1-2.1c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`;
const particulierIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;
const proIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M3 12h18" stroke="currentColor" stroke-width="1.8"/></svg>`;
const euroIcon = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M14.5 8.3c-.7-.5-1.6-.8-2.5-.8-2.2 0-4 2-4 4.5s1.8 4.5 4 4.5c.9 0 1.8-.3 2.5-.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M7 11h5.5M7 13h4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;

const specIcons: Record<string, string> = {
  fuel: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  calendar: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  gauge: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="13" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 13l4-4M12 5v1.5M4.5 13H6M18 13h1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  gear: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v2.4M12 18.6V21M21 12h-2.4M5.4 12H3M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7M18.4 18.4l-1.7-1.7M7.3 7.3L5.6 5.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  engine: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 21V6a2 2 0 012-2h6a2 2 0 012 2v15M4 21h10M4 10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 8l2.5 2.5A2 2 0 0117 12v5a1.5 1.5 0 003 0V9l-3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  battery: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="2" y="8" width="18" height="8" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M22 10v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11.5 10l-2 3h3l-2 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  road: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M8 3L4 21M16 3l4 18M12 3v3M12 10v3M12 17v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  plug: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 3v5M15 3v5M7 8h10v3a5 5 0 01-5 5 5 5 0 01-5-5V8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 16v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  clock: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  leaf: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M4 20c0-9 6-15 16-15 0 10-6 15-16 15z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20c4-4 8-7 16-15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  trunk: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  seats: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M6 17V6a2 2 0 012-2h2a2 2 0 012 2v11M6 17h6M16 10v7M16 10h3a2 2 0 012 2v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};

const chipDefs: [string, string | undefined][] = [
  [specIcons.calendar, v.annee || undefined],
  [specIcons.fuel, v.fuel || undefined],
  [specIcons.gear, v.transmission || undefined],
  [specIcons.seats, v.places ? `${v.places} places` : undefined],
  [specIcons.gauge, v.puissance ? (/^\d+$/.test(v.puissance) ? `${v.puissance} ch` : v.puissance) : undefined],
];
const chips = chipDefs.filter((c): c is [string, string] => !!c[1]);

type SpecItem = { icon: string; label: string; value: string };

function buildMainSpecs(v: Vehicle): SpecItem[] {
  const items: SpecItem[] = [];
  if (v.fuel) items.push({ icon: specIcons.fuel, label: 'Carburant', value: v.fuel });
  if (v.transmission) items.push({ icon: specIcons.gear, label: 'Boîte', value: v.transmission });
  if (v.puissance) items.push({ icon: specIcons.gauge, label: 'Puissance', value: /^\d+$/.test(v.puissance) ? v.puissance + ' ch' : v.puissance });
  items.push({ icon: specIcons.road, label: 'Kilométrage annuel', value: 'Illimité' });
  items.push({ icon: specIcons.clock, label: 'Durée possible', value: `${DUREE_STEPS[0]} à ${DUREE_STEPS[DUREE_STEPS.length - 1]} mois` });
  items.push({ icon: euroIcon, label: 'Apport', value: `${APPORT_STEPS[0].toLocaleString('fr-FR')}€ possible` });
  if (v.places) items.push({ icon: specIcons.seats, label: 'Nombre de places', value: `${v.places} places` });
  if (v.annee) items.push({ icon: specIcons.calendar, label: 'Année', value: v.annee });
  return items;
}
const mainSpecs = buildMainSpecs(v);

function buildExtraSpecs(v: Vehicle): SpecItem[] {
  const items: SpecItem[] = [];
  if (v.moteur) items.push({ icon: specIcons.engine, label: 'Moteur', value: v.moteur });
  if (v.autonomieElec) items.push({ icon: specIcons.battery, label: 'Autonomie électrique', value: v.autonomieElec });
  if (v.autonomieCumulee) items.push({ icon: specIcons.road, label: 'Autonomie cumulée', value: v.autonomieCumulee });
  if (v.rechargeDC || v.rechargeAC) items.push({ icon: specIcons.plug, label: 'Recharge', value: [v.rechargeDC, v.rechargeAC].filter(Boolean).join(' / ') });
  if (v.tempsCharge) items.push({ icon: specIcons.clock, label: 'Temps de charge', value: v.tempsCharge });
  if (v.consommation || v.co2) items.push({ icon: specIcons.leaf, label: 'Consommation / CO2', value: [v.consommation, v.co2].filter(Boolean).join(', ') });
  if (v.coffre) items.push({ icon: specIcons.trunk, label: 'Coffre', value: /^\d+$/.test(v.coffre) ? v.coffre + ' litres' : v.coffre });
  return items;
}
const extraSpecs = buildExtraSpecs(v);

const optionEntries = Object.entries(v.options).filter(([, items]) => items.length > 0);
---
<BaseLayout title={pageTitle} description={pageDescription} path={canonicalPath} ogImage={photos[0]} active="vehicules">
<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify(vehicleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Fragment>
<div id="pageContent">
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Fil d'ariane">
      <a href="/">Accueil</a><span class="crumb-sep">/</span>
      <a href="/vehicules">Véhicules</a><span class="crumb-sep">/</span>
      <span class="crumb-current">{v.brand} {v.name}</span>
    </nav>

    <div class="detail-header-row">
      <div class="detail-header-left">
        <div class="veh-brand-label">{v.brand}</div>
        <h1>{v.name}{v.finition ? ` ${v.finition}` : ''}</h1>
        <p class="veh-subtitle">{subtitle}</p>
        {chips.length > 0 && (
          <div class="chip-row">
            {chips.map(([icon, label]) => <span class="chip"><Fragment set:html={icon} /> {label}</span>)}
          </div>
        )}
      </div>
      <button type="button" class="share-link" id="shareBtn"><Fragment set:html={shareIcon} /> Partager</button>
    </div>

    <div class="detail-grid">
      <div class="detail-media">
        <div class="carousel" id="carousel">
          {photos.length
            ? <img id="carouselImg" src={photos[0]} alt={`${v.brand} ${v.name}`} onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'carousel-icon',innerHTML:window.__vehCarIcon}))" />
            : <div class="carousel-icon"><Fragment set:html={carIcon} /></div>
          }
          <span class={`carousel-badge ${v.condition === 'occasion' ? 'occasion' : ''}`}>{v.condition === 'neuf' ? 'Neuf' : 'Occasion'}</span>
          {photos.length > 1 && (
            <>
              <button type="button" class="carousel-arrow prev" id="prevBtn" aria-label="Photo précédente"><Fragment set:html={chevronIcon} /></button>
              <button type="button" class="carousel-arrow next" id="nextBtn" aria-label="Photo suivante"><Fragment set:html={chevronIcon} /></button>
            </>
          )}
        </div>
        {photos.length > 1 && (
          <div class="photo-grid">
            {photos.slice(0, 5).map((p, i) => (
              <button type="button" class={`photo-grid-item ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Voir la photo ${i + 1}`}>
                <img src={p} alt={`${v.brand} ${v.name} — photo ${i + 1}`} loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="detail-config">
        <div class="price-card">
          <div class="price-eyebrow">À partir de</div>
          <div class="price-amount"><span class="amount">{v.price}€</span><span class="period"> /mois</span></div>
          <div class="price-note">sans apport possible</div>

          <div class="price-facts">
            <div class="price-fact"><Fragment set:html={specIcons.clock} /> {baseDuree} mois</div>
            <div class="price-fact"><Fragment set:html={specIcons.road} /> Kilométrage illimité</div>
            <div class="price-fact"><Fragment set:html={phoneIcon} /> Réponse sous 24h</div>
          </div>

          <div class="price-ctas">
            <a href={`/simulation?vehicule=${encodeURIComponent(v.brand + ' ' + v.name)}`} class="btn-primary cta-with-calculator"><span class="cta-calculator-icon" aria-hidden="true"></span>Faire une simulation</a>
            <a href="tel:+33638014986" class="btn-outline"><Fragment set:html={phoneIcon} /> Nous appeler</a>
          </div>

          <div class="config-included">
            <div class="config-included-title">Compris dans le leasing</div>
            <div class="included-list">
              {includedItems.map(i => <div class="included-item"><Fragment set:html={checkIcon} /> {i}</div>)}
            </div>
          </div>

          <p class="config-note">Étude gratuite et sans engagement. Estimation indicative hors frais de dossier ; le loyer définitif dépend de votre profil et sera confirmé par notre partenaire financier.</p>
        </div>
      </div>
    </div>

    <div class="detail-below">
      <div class="about-grid">
        {v.description && (
          <div>
            <h2 class="section-title">À propos de ce véhicule</h2>
            <p class="veh-description">{v.description}</p>
          </div>
        )}
        <div class="points-forts-card">
          <div class="config-included-title">Points forts</div>
          <div class="included-list">
            {pointsForts.map(p => <div class="included-item"><Fragment set:html={checkIcon} /> {p}</div>)}
          </div>
        </div>
      </div>

      <h2 class="section-title">Caractéristiques principales</h2>
      <div class="main-spec-grid">
        {mainSpecs.map(s => (
          <div class="main-spec-card">
            <span class="spec-icon"><Fragment set:html={s.icon} /></span>
            <div>
              <div class="main-spec-label">{s.label}</div>
              <div class="main-spec-value">{s.value}</div>
            </div>
          </div>
        ))}
      </div>

      {extraSpecs.length > 0 && (
        <>
          <h2 class="section-title">Caractéristiques techniques</h2>
          <div class="spec-card">
            {extraSpecs.map(s => (
              <div class="spec-row"><span class="spec-icon"><Fragment set:html={s.icon} /></span><span class="spec-label">{s.value}</span></div>
            ))}
          </div>
        </>
      )}

      {optionEntries.length > 0 && (
        <>
          <h2 class="section-title">Options</h2>
          <div>
            {optionEntries.map(([cat, items]) => (
              <details class="options-group">
                <summary>{cat}</summary>
                <div class="options-list">{items.map(o => <span>{o}</span>)}</div>
              </details>
            ))}
          </div>
        </>
      )}
    </div>
  </div>

  <section class="financing-section">
    <div class="wrap">
      <h2 class="section-title center">Exemple de financement</h2>
      <div class="financing-grid">
        {financingExamples.map(f => (
          <div class="financing-card">
