---
import { LEGAL } from '../config/legal';
---
<footer class="site-footer">
  <div class="footer-panel">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          <a class="footer-logo" href="/" aria-label="Eleven Lease — Accueil">
            <span class="footer-logo-icon" role="img" aria-label="Eleven Lease"></span>
          </a>
          <p>Votre projet de leasing, recherché sur mesure grâce à notre réseau de partenaires partout en France.</p>
          <a class="footer-cta cta-with-calculator" href="/simulation">
            <span class="cta-calculator-icon" aria-hidden="true"></span>
            Simuler mon leasing
            <span class="footer-cta-arrow" aria-hidden="true">→</span>
          </a>
          <div class="footer-socials" aria-label="Réseaux sociaux">
            <a href="https://taap.it/elevenleasewhatsapp" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.6 6.32A8.86 8.86 0 0012.05 4c-4.9 0-8.9 4-8.9 8.9 0 1.57.42 3.1 1.2 4.44L3 22l4.8-1.26a8.9 8.9 0 004.25 1.08h0c4.9 0 8.9-4 8.9-8.9 0-2.38-.93-4.62-2.35-6.6zm-5.55 13.7h0a7.4 7.4 0 01-3.77-1.03l-.27-.16-2.8.74.75-2.73-.18-.28a7.38 7.38 0 01-1.13-3.94c0-4.08 3.32-7.4 7.4-7.4 1.98 0 3.84.77 5.24 2.17a7.35 7.35 0 012.16 5.23c0 4.08-3.32 7.4-7.4 7.4z"/></svg>
            </a>
            <a href="https://www.instagram.com/elevenlease" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.3" cy="6.7" r="1.1" class="fill"></circle></svg>
            </a>
            <a href="https://www.tiktok.com/@elevenlease" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 5.82a4.28 4.28 0 01-2.66-1.28A4.53 4.53 0 0112.9 2H10.1v13.6a2.6 2.6 0 11-2.1-2.55V10.3a5.4 5.4 0 105.1 5.38V9.4a7 7 0 003.5 1.02V7.6a4.3 4.3 0 01-.9-.18z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/elevenlease/" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none"><path d="M6.94 5a2 2 0 11-4-.002 2 2 0 014 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-3.96 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.68-2.91V8.48z"/></svg>
            </a>
          </div>
        </div>

        <div class="footer-col">
          <h4>Explorer</h4>
          <a href="/vehicules">Nos véhicules</a>
          <a href="/simulation">Simuler mon leasing</a>
          <a href="/loa">Guide LOA</a>
          <a href="/articles">Articles</a>
          <a href="/leasing-sans-apport">Leasing sans apport</a>
          <a href="/leasing-gros-rouleur">Leasing gros rouleur</a>
          <a href="/leasing-professionnel">Leasing professionnel</a>
          <a href="/leasing-auto-entrepreneur">Auto-entrepreneur</a>
        </div>

        <div class="footer-col">
          <h4>Eleven Lease</h4>
          <a href="/a-propos">À propos</a>
          <a href="/#avis">Avis clients</a>
          <a href="/contact">Contact</a>
        </div>

        <div class="footer-col">
          <h4>Informations</h4>
          <a href="/mentions-legales">Mentions légales</a>
          <a href="/confidentialite">Confidentialité</a>
          <a href="/cgu">Conditions générales</a>
          <a href={`mailto:${LEGAL.email}`}>{LEGAL.email}</a>
          <a href={`tel:${LEGAL.phoneInternational}`}>{LEGAL.phoneDisplay}</a>
        </div>
      </div>

      <div class="footer-wordmark" aria-hidden="true">Eleven Lease</div>

      <div class="footer-bottom">
        <span>© 2026 {LEGAL.tradeName}. Tous droits réservés.</span>
        <span>{LEGAL.operatorName} – Entrepreneur individuel · SIREN {LEGAL.siren}</span>
        <span>Pré-check commercial uniquement : financement et décision relèvent du partenaire.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer{
    position:relative;
    border:0;
    background:#fff;
    padding:12px;
  }
  .footer-panel{
    position:relative;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.12);
    border-radius:var(--radius-xl) var(--radius-xl) var(--radius-lg) var(--radius-lg);
    color:#fff;
    background:
      radial-gradient(circle at 75% 4%,rgba(255,0,127,.34),transparent 27%),
      radial-gradient(circle at 22% 0%,rgba(141,10,50,.3),transparent 31%),
      linear-gradient(145deg,#050507 0%,#0b0308 46%,#230014 100%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.08),
      0 22px 60px rgba(17,17,19,.16);
  }
  .footer-panel::before{
    content:'';
    position:absolute;
    width:520px;
    aspect-ratio:1;
    right:-180px;
    top:-260px;
    border-radius:var(--radius-round);
    background:rgba(255,0,127,.22);
    filter:blur(90px);
    pointer-events:none;
  }
  .footer-panel::after{
    content:'';
    position:absolute;
    inset:0;
    pointer-events:none;
    opacity:.06;
    background-image:
      linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.12) 1px,transparent 1px);
    background-size:72px 72px;
    mask-image:linear-gradient(180deg,#000,transparent 54%);
  }
  .footer-inner{
    position:relative;
    z-index:1;
    max-width:1320px;
    margin:0 auto;
    padding:72px 60px 30px;
  }
  .footer-top{
    display:grid;
    grid-template-columns:minmax(290px,1.45fr) repeat(3,minmax(145px,.72fr));
    gap:clamp(34px,5vw,82px);
    padding-bottom:82px;
  }
  .footer-brand{max-width:360px;}
  .footer-logo{
    display:inline-flex;
    margin-bottom:24px;
    transition:opacity .2s ease;
  }
  .footer-logo:hover{opacity:.8;}
  .footer-logo-icon{
    width:128px;
    height:56px;
    display:block;
    background:url('/eleven-lease-logo-light.png') center/contain no-repeat;
    filter:brightness(0) invert(1);
  }
  .footer-brand p{
    max-width:340px;
    color:rgba(255,255,255,.62);
    font-size:15px;
    line-height:1.75;
  }
  .footer-cta{
    display:inline-flex;
    align-items:center;
    gap:14px;
    margin-top:25px;
    padding:13px 18px;
    border:1px solid rgba(255,255,255,.18);
    border-radius:var(--radius-pill);
    background:rgba(255,255,255,.07);
    color:#fff;
    font-size:13.5px;
    font-weight:600;
    transition:background .25s ease,border-color .25s ease,transform .25s ease;
  }
  .footer-cta-arrow{color:#ff55aa;transition:transform .25s ease;}
  .footer-cta:hover{
    border-color:rgba(255,0,127,.7);
    background:rgba(255,0,127,.16);
    transform:translateY(-2px);
  }
  .footer-cta:hover .footer-cta-arrow{transform:translateX(3px);}
  .footer-socials{display:flex;gap:10px;margin-top:24px;}
  .footer-socials a{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(255,255,255,.15);
    border-radius:var(--radius-round);
    color:rgba(255,255,255,.72);
    background:rgba(255,255,255,.04);
    transition:color .2s ease,border-color .2s ease,background .2s ease,transform .2s ease;
  }
  .footer-socials a:hover{
    color:#fff;
    border-color:#ff278f;
    background:rgba(255,0,127,.18);
    transform:translateY(-3px);
  }
  .footer-socials svg{width:19px;height:19px;fill:currentColor;stroke:currentColor;stroke-width:1.7;}
  .footer-socials rect,.footer-socials circle{fill:none;}
  .footer-socials .fill{fill:currentColor;stroke:none;}
  .footer-col h4{
    margin:9px 0 20px;
    color:#ff55aa;
    font-family:'Space Grotesk',sans-serif;
    font-size:15px;
    font-weight:600;
    letter-spacing:.01em;
    text-transform:none;
  }
  .footer-col a{
    position:relative;
    display:table;
    padding:7px 0;
    color:rgba(255,255,255,.58);
    font-size:14px;
    transition:color .2s ease,transform .2s ease;
  }
  .footer-col a::after{
    content:'';
    position:absolute;
    left:0;
    bottom:5px;
    width:0;
    height:1px;
    background:#ff278f;
    transition:width .25s ease;
  }
  .footer-col a:hover{color:#fff;transform:translateX(3px);}
  .footer-col a:hover::after{width:100%;}
  .footer-wordmark{
    margin:0 -6px -2px;
    white-space:nowrap;
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(82px,14.2vw,210px);
    font-weight:700;
    line-height:.78;
    letter-spacing:-.075em;
    color:transparent;
    background:linear-gradient(180deg,rgba(255,255,255,.48),rgba(255,0,127,.3) 52%,rgba(255,0,127,.035) 96%);
    -webkit-background-clip:text;
    background-clip:text;
    user-select:none;
  }
  .footer-bottom{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:18px;
    border-top:1px solid rgba(255,255,255,.1);
    padding-top:24px;
    color:rgba(255,255,255,.38);
    font-size:11.5px;
    line-height:1.55;
  }
  .footer-bottom span:last-child{max-width:520px;text-align:right;}
  @media(max-width:920px){
    .footer-inner{padding:60px 42px 28px;}
    .footer-top{grid-template-columns:1.25fr 1fr 1fr;gap:44px;}
    .footer-brand{grid-column:1/-1;max-width:540px;}
  }
  @media(max-width:640px){
    .site-footer{padding:8px;}
    .footer-panel{border-radius:var(--radius-xl) var(--radius-xl) var(--radius-lg) var(--radius-lg);}
    .footer-inner{padding:44px 22px 24px;}
    .footer-top{grid-template-columns:1fr 1fr;gap:38px 26px;padding-bottom:60px;}
    .footer-brand{grid-column:1/-1;}
    .footer-col:last-child{grid-column:1/-1;}
    .footer-col h4{margin-bottom:14px;}
    .footer-wordmark{
      margin-left:-2px;
      font-size:clamp(48px,14.5vw,72px);
      line-height:.84;
    }
    .footer-bottom{flex-direction:column;padding-top:20px;}
    .footer-bottom span:last-child{text-align:left;}
  }
  @media(max-width:380px){
    .footer-top{grid-template-columns:1fr;}
    .footer-brand,.footer-col:last-child{grid-column:auto;}
  }
</style>
