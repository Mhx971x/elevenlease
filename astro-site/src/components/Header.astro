---
export interface Props {
  ctaHref?: string;
  /** Libellé du délai affiché dans la barre promotionnelle */
  responseLabel?: string;
  /** Variante courte utilisée sur les petits écrans */
  responseLabelCompact?: string;
  /** Marque le lien nav correspondant comme actif */
  active?: 'contact' | 'loa' | 'vehicules' | 'articles';
  /** Affiche la barre de progression de scroll dans le header (pages de contenu long) */
  showProgressBar?: boolean;
}
const {
  ctaHref = '/simulation',
  responseLabel = 'Première réponse sous 24 à 48 h ouvrées',
  responseLabelCompact = 'Réponse 24–48 h',
  active,
  showProgressBar = false,
} = Astro.props;
const cls = (key: string) => (active === key ? 'active' : undefined);
---
<div class="promo-bar" id="promoBar">
  <div class="promo-bar-inner">
    <span>0€ d'apport possible</span>
    <span class="promo-dot" aria-hidden="true">·</span>
    <span>Auto &amp; Moto</span>
    <span class="promo-dot" aria-hidden="true">·</span>
    <span><span class="promo-response-full">{responseLabel}</span><span class="promo-response-compact">{responseLabelCompact}</span></span>
  </div>
</div>
<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="logo">
      <span class="logo-icon" role="img" aria-label="Eleven Lease"></span>
    </a>
    <div class="nav-links">
      <a href="/vehicules" class={cls('vehicules')}>Nos offres</a>
      <a href="/loa" class={cls('loa')}>Guide leasing</a>
      <a href="/#avis">Avis</a>
    </div>
    <div class="nav-right">
      <button class="menu-toggle" id="menuToggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
      <a href={ctaHref} class="nav-cta cta-with-calculator"><span class="cta-calculator-icon" aria-hidden="true"></span> Simuler mon leasing <span class="nav-cta-arrow" aria-hidden="true">↗</span></a>
    </div>
  </nav>
  {showProgressBar && <div class="progress-bar" id="progressBar"></div>}
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true" inert>
  <div class="mobile-menu-head">
    <div class="logo">
      <span class="logo-icon" role="img" aria-label="Eleven Lease"></span>
    </div>
    <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Fermer le menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <nav class="mobile-menu-list">
    <a href="/loa" class={cls('loa')}>Guide LOA</a>
    <a href="/vehicules" class={cls('vehicules')}>Nos offres</a>
    <a href="/articles" class={cls('articles')}>Articles</a>
    <a href="/contact" class={cls('contact')}>Contact</a>
  </nav>
  <div class="mobile-menu-cta">
    <a href={ctaHref} class="nav-cta cta-with-calculator"><span class="cta-calculator-icon" aria-hidden="true"></span> Simuler mon leasing <span class="nav-cta-arrow" aria-hidden="true">↗</span></a>
  </div>
</div>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileMenuClose = document.getElementById('mobileMenuClose');
  const mobileMenuFocusables = () => Array.from(mobileMenu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
  function openMobileMenu(){
    mobileMenu.removeAttribute('inert');
    mobileMenu.setAttribute('aria-hidden', 'false');
    mobileMenu.classList.add('open');
    menuToggle.classList.add('active');
    menuToggle.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
    window.requestAnimationFrame(() => mobileMenuClose?.focus());
  }
  function closeMobileMenu({ restoreFocus = true } = {}){
    mobileMenu.classList.remove('open');
    menuToggle.classList.remove('active');
    menuToggle.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
    mobileMenu.setAttribute('aria-hidden', 'true');
    mobileMenu.setAttribute('inert', '');
    if(restoreFocus) menuToggle.focus();
  }
  if(menuToggle && mobileMenu){
    menuToggle.addEventListener('click', ()=>{
      mobileMenu.classList.contains('open') ? closeMobileMenu() : openMobileMenu();
    });
    if(mobileMenuClose) mobileMenuClose.addEventListener('click', closeMobileMenu);
    mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => closeMobileMenu({ restoreFocus:false })));
    document.addEventListener('keydown', (e)=>{
      if(!mobileMenu.classList.contains('open')) return;
      if(e.key === 'Escape'){
        e.preventDefault();
        closeMobileMenu();
        return;
      }
      if(e.key !== 'Tab') return;
      const focusables = mobileMenuFocusables();
      if(focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if(e.shiftKey && document.activeElement === first){
        e.preventDefault();
        last.focus();
      }else if(!e.shiftKey && document.activeElement === last){
        e.preventDefault();
        first.focus();
      }
    });
  }

  // header scroll state + barre de progression (pages avec showProgressBar)
  const headerEl = document.querySelector('.site-header');
  const progressBar = document.getElementById('progressBar');
  if(headerEl){
    const updateHeader = ()=>{
      const isScrolled = window.scrollY > 40;
      headerEl.classList.toggle('scrolled', isScrolled);
      document.body.classList.toggle('scrolled', isScrolled);
      if(!progressBar) return;
      const h = document.documentElement;
      const scrolled = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
      progressBar.style.width = scrolled + '%';
    };
    updateHeader();
    window.addEventListener('scroll', updateHeader, {passive:true});
  }
</script>
