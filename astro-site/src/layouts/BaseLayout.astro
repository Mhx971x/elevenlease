---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description: string;
  /** Chemin absolu utilisé pour construire le canonical + og:url, ex. "/loa" ou "/" */
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  ctaHref?: string;
  active?: 'contact' | 'loa' | 'vehicules' | 'articles';
  showProgressBar?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = 'https://elevenlease.fr/eleven-lease-logo.png',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  ctaHref,
  active,
  showProgressBar = false,
} = Astro.props;

const canonicalUrl = new URL(path, 'https://elevenlease.fr').toString();
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Eleven Lease">
<meta property="og:locale" content="fr_FR">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:url" content={canonicalUrl}>
<meta name="twitter:card" content={twitterCard}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<slot name="head" />
<style is:global>
  :root{
    --bg:#ffffff;
    --surface:#f6f6f7;
    --surface-2:#eeeef1;
    --border:#e4e4e8;
    --text:#111113;
    --text-dim:#5a5a62;
    --text-faint:#96969e;
    --accent-1:#ff007f;
    --accent-2:#8d0a32;
    --accent:linear-gradient(135deg,var(--accent-1),var(--accent-2));
    --shadow-sm:0 1px 2px rgba(17,17,19,0.04), 0 1px 1px rgba(17,17,19,0.03);
    --shadow-md:0 12px 32px rgba(17,17,19,0.08), 0 2px 8px rgba(17,17,19,0.04);
    --shadow-lg:0 24px 56px rgba(17,17,19,0.12), 0 4px 12px rgba(17,17,19,0.05);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;line-height:1.5;overflow-x:hidden;}
  h1,h2,h3,.display{font-family:'Space Grotesk',sans-serif;font-weight:700;letter-spacing:-0.02em;line-height:1.05;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 32px;}
  @media(max-width:768px){ .wrap{padding:0 20px;} }

  /* logo */
  .logo{display:flex;align-items:center;gap:10px;transition:opacity .25s ease;}
  .logo:hover{opacity:.8;}
  .logo-icon{width:94px;height:40px;background-image:url('/eleven-lease-logo-light.png');background-repeat:no-repeat;background-size:contain;background-position:center;flex:none;transition:width .35s cubic-bezier(.16,1,.3,1),height .35s cubic-bezier(.16,1,.3,1);}

  .cta-calculator-icon{
    display:inline-block;
    flex:0 0 16px;
    width:16px;
    height:16px;
    color:inherit;
    background:currentColor;
    -webkit-mask:url('/icons/calculator.svg') center/contain no-repeat;
    mask:url('/icons/calculator.svg') center/contain no-repeat;
  }
  .cta-with-calculator{display:inline-flex !important;align-items:center;justify-content:center;gap:8px;}

  /* nav */
  .site-header{
    position:fixed;
    z-index:100;
    top:20px;
    left:50%;
    width:calc(100% - 40px);
    max-width:1180px;
    transform:translateX(-50%);
    transition:top .35s cubic-bezier(.16,1,.3,1),width .35s cubic-bezier(.16,1,.3,1);
  }
  .site-nav{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    height:72px;
    margin:0;
    padding:0 14px 0 22px;
    border:1px solid rgba(17,17,19,.05);
    border-radius:24px;
    background:rgba(255,255,255,.78);
    box-shadow:0 12px 34px rgba(17,17,19,.055),inset 0 1px 0 rgba(255,255,255,.94);
    backdrop-filter:blur(18px) saturate(1.25);
    -webkit-backdrop-filter:blur(18px) saturate(1.25);
    transition:height .35s cubic-bezier(.16,1,.3,1),background .3s ease,border-radius .35s cubic-bezier(.16,1,.3,1),box-shadow .3s ease,backdrop-filter .3s ease;
  }
  .site-nav > .logo{justify-self:start;}
  .site-nav > .nav-links{grid-column:2;}
  .site-nav > .nav-right{grid-column:3;justify-self:end;}
  .site-header.scrolled{top:12px;width:calc(100% - 48px);}
  .site-header.scrolled .site-nav{
    height:60px;
    border-radius:20px;
    background:rgba(255,255,255,.86);
    box-shadow:0 10px 30px rgba(17,17,19,.07),inset 0 1px 0 rgba(255,255,255,.96);
    backdrop-filter:blur(24px) saturate(1.35);
    -webkit-backdrop-filter:blur(24px) saturate(1.35);
  }
  .site-header.scrolled .logo-icon{width:82px;height:34px;}
  .progress-bar{position:absolute;bottom:1px;left:22px;height:1px;width:0%;max-width:calc(100% - 44px);border-radius:999px;background:var(--accent);transition:width .1s linear;}
  .nav-links{display:flex;align-items:center;justify-content:center;gap:34px;color:#3f4047;font-size:15px;font-weight:500;white-space:nowrap;}
  .nav-links a{position:relative;padding:9px 3px;transition:color .2s ease;}
  .nav-links a::after{
    content:'';
    position:absolute;
    left:50%;
    bottom:1px;
    width:4px;
    height:4px;
    border-radius:50%;
    background:var(--accent-1);
    opacity:0;
    transform:translate(-50%,4px) scale(.4);
    box-shadow:0 0 8px rgba(255,0,127,.28);
    transition:opacity .22s ease,transform .3s cubic-bezier(.16,1,.3,1);
  }
  .nav-links a:hover,.nav-links a.active{color:var(--text);}
  .nav-links a:hover::after,.nav-links a.active::after{opacity:1;transform:translate(-50%,0) scale(1);}
  .nav-cta{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    height:46px;
    padding:0 24px;
    color:#fff;
    border:1px solid rgba(255,255,255,.18);
    border-radius:16px;
    background:linear-gradient(135deg,#ed0574,#b50850);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.25),0 8px 19px rgba(190,24,93,.14);
    font-size:13px;
    font-weight:600;
    white-space:nowrap;
    transition:filter .2s ease,transform .2s ease,box-shadow .25s ease;
  }
  .nav-cta-arrow{font-size:14px;transition:transform .25s cubic-bezier(.16,1,.3,1);}
  .nav-cta:hover{filter:brightness(1.07);transform:translateY(-1px);box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 10px 22px rgba(237,5,116,.2),0 0 12px rgba(237,5,116,.05);}
  .nav-cta:hover .nav-cta-arrow{transform:translate(2px,-2px);}
  .nav-cta:active{transform:scale(.95);}
  .site-header.scrolled .nav-cta{height:40px;padding:0 20px;}
  @media(max-width:980px){
    .nav-links{display:none;}
    .site-header{top:12px;width:calc(100% - 24px);}
    .site-header.scrolled{top:8px;width:calc(100% - 20px);}
    .site-nav{height:64px;padding:0 12px 0 17px;border-radius:20px;}
    .site-header.scrolled .site-nav{height:58px;border-radius:18px;}
  }
  @media(max-width:480px){
    .logo{gap:7px;}
    .site-header{top:10px;width:calc(100% - 24px);}
    .site-header.scrolled{top:7px;width:calc(100% - 18px);}
    .site-nav{height:64px;padding:0 18px;border-radius:21px;grid-template-columns:1fr auto;}
    .site-header.scrolled .site-nav{height:58px;border-radius:19px;}
    .logo-icon{width:88px;height:39px;}
    .site-header.scrolled .logo-icon{width:82px;height:35px;}
    .site-nav > .nav-right{grid-column:2;}
    .site-nav > .nav-right > .nav-cta{display:none!important;}
    .nav-right{gap:0;}
    .menu-toggle{width:26px;height:20px;}
    .menu-toggle span{height:2.5px;}
    .menu-toggle span:nth-child(2){top:8.75px;}
    .menu-toggle span:nth-child(3){top:17.5px;}
    .menu-toggle.active span:nth-child(1),.menu-toggle.active span:nth-child(3){top:8.75px;}
  }

  /* nav right group + mobile menu toggle */
  .nav-right{display:flex;align-items:center;gap:14px;}
  .menu-toggle{display:none;position:relative;width:24px;height:18px;flex:none;background:none;border:none;cursor:pointer;padding:0;}
  .menu-toggle span{position:absolute;left:0;width:100%;height:2px;background:var(--text);border-radius:2px;transition:transform .35s cubic-bezier(.16,1,.3,1), opacity .25s ease, top .35s cubic-bezier(.16,1,.3,1);}
  .menu-toggle span:nth-child(1){top:0;}
  .menu-toggle span:nth-child(2){top:8px;}
  .menu-toggle span:nth-child(3){top:16px;}
  .menu-toggle.active span:nth-child(1){top:8px;transform:rotate(45deg);}
  .menu-toggle.active span:nth-child(2){opacity:0;}
  .menu-toggle.active span:nth-child(3){top:8px;transform:rotate(-45deg);}
  @media(max-width:980px){ .menu-toggle{display:block;} }

  /* full-screen mobile menu */
  .mobile-menu{position:fixed;inset:0;background:var(--bg);z-index:200;display:flex;flex-direction:column;opacity:0;visibility:hidden;transform:translateY(-14px);transition:opacity .4s cubic-bezier(.16,1,.3,1), transform .4s cubic-bezier(.16,1,.3,1), visibility 0s linear .4s;}
  .mobile-menu.open{opacity:1;visibility:visible;transform:translateY(0);transition:opacity .4s cubic-bezier(.16,1,.3,1), transform .4s cubic-bezier(.16,1,.3,1);}
  .mobile-menu-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--border);}
  .mobile-menu-close{background:none;border:none;color:var(--text);cursor:pointer;padding:6px;display:flex;transition:transform .35s cubic-bezier(.16,1,.3,1);}
  .mobile-menu-close:hover{transform:rotate(90deg);}
  .mobile-menu-list{flex:1;display:flex;flex-direction:column;overflow-y:auto;width:100%;max-width:none;margin:0;padding:0;justify-content:flex-start;align-items:stretch;}
  .mobile-menu-list a{display:block;width:100%;padding:15px 20px;font-size:19px;font-family:'Space Grotesk',sans-serif;font-weight:600;border-bottom:1px solid var(--border);color:var(--text-dim);text-align:center;opacity:0;transform:translateY(10px);transition:opacity .45s cubic-bezier(.16,1,.3,1), transform .45s cubic-bezier(.16,1,.3,1), color .2s ease, background .2s ease;}
  .mobile-menu.open .mobile-menu-list a{opacity:1;transform:translateY(0);}
  .mobile-menu.open .mobile-menu-list a:nth-child(1){transition-delay:.08s;}
  .mobile-menu.open .mobile-menu-list a:nth-child(2){transition-delay:.13s;}
  .mobile-menu.open .mobile-menu-list a:nth-child(3){transition-delay:.18s;}
  .mobile-menu.open .mobile-menu-list a:nth-child(4){transition-delay:.23s;}
  .mobile-menu.open .mobile-menu-list a:nth-child(5){transition-delay:.28s;}
  .mobile-menu-list a:hover, .mobile-menu-list a.active{color:var(--accent-1);background:var(--surface);}
  .mobile-menu-cta{padding:24px 20px 32px;}
  .mobile-menu-cta .nav-cta{display:flex;width:100%;height:auto;padding:16px 22px;font-size:15px;}
  @media(min-width:981px){ .mobile-menu{display:none;} }
  body.menu-open{overflow:hidden;}

  @media (prefers-reduced-motion: reduce){ *{animation:none !important;transition:none !important;} }
</style>
</head>
<body>
  <Header ctaHref={ctaHref} active={active} showProgressBar={showProgressBar} />
  <slot />
  <Footer />
  <Analytics />
  <SpeedInsights />
</body>
</html>
